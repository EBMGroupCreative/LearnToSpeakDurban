    if (!avail) return;
    const ls = (parseFloat(cs.letterSpacing) || 0) / (parseFloat(cs.fontSize) || base), up = cs.textTransform === 'uppercase';
    const c = MetaFit.c || (MetaFit.c = document.createElement('canvas').getContext('2d'));
    const W = (s, fs) => { c.font = cs.fontWeight + ' ' + fs + 'px ' + cs.fontFamily; c.letterSpacing = (ls * fs) + 'px'; return c.measureText(up ? s.toUpperCase() : s).width; };
    let out = null;
    for (let k = parts.length; k >= 1 && !out; k--) { const s = parts.slice(0, k).join(' · '); for (let fs = base; fs >= min - 0.01; fs -= 0.5) if (W(s, fs) <= avail) { out = { k, fs: fs === base ? null : fs }; break; } }
    if (!out) { let fs = min; while (fs > 6 && W(parts[0], fs) > avail) fs -= 0.5; out = { k: 1, fs }; }
    setFit(f => f.k === out.k && f.fs === out.fs ? f : out);
  }, [text, min]);
  React.useLayoutEffect(run, [run]);
  React.useEffect(() => {
    const el = ref.current; if (!el) return;
    let w = 0, ro; if (window.ResizeObserver) { ro = new ResizeObserver(() => { const nw = el.clientWidth; if (nw !== w) { w = nw; run(); } }); ro.observe(el.parentElement || el); }
    const F = document.fonts; if (F && F.addEventListener) F.addEventListener('loadingdone', run);
    return () => { ro && ro.disconnect(); F && F.removeEventListener && F.removeEventListener('loadingdone', run); };
  }, [run]);
