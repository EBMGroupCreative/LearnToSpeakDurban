// Meta labels ("Flying · daily best counts"): one line, never clipped. Shrinks first (to min), then drops trailing " · " segments,
// then (last resort) shrinks the first segment further. Measured on canvas with the label's own font + tracking.
function MetaFit({ text, className = '', min = 9.5 }) {
  const ref = React.useRef(null), parts = String(text).split(' · ');
