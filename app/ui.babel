  return <span ref={ref} className={'mfit' + (className ? ' ' + className : '')} title={k < parts.length ? text : undefined} style={fit.fs ? { fontSize: fit.fs + 'px' } : undefined}>{parts.slice(0, k).join(' · ')}</span>;
}
// Inputs that hold a name: the type shrinks so the whole name stays visible (from max down to min px), never scrolls out of view.
function useFitInput(ref, value, max = 20, min = 12) {
  React.useLayoutEffect(() => {
    const el = ref.current; if (!el) return;
    const cs = getComputedStyle(el), avail = el.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight) - 4;
    const c = useFitInput.c || (useFitInput.c = document.createElement('canvas').getContext('2d'));
    c.font = cs.fontWeight + ' ' + max + 'px ' + cs.fontFamily; c.letterSpacing = '0px';
