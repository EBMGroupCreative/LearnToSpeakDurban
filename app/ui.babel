// The name rule, for canvas. Design size first, shrink to fit one line (down to min); where lines is 2, a balanced two-line break
// (at spaces, or after a hyphen) from the design size (or o.size2 where two lines need a smaller start); last resort shrinks further. Never truncates. font(sz) sets ctx.font + letterSpacing.
function ltsdFitText(ctx, text, maxW, size, o = {}) {
  const t = String(text == null ? '' : text).trim().replace(/\s+/g, ' '), min = o.min || Math.round(size * 0.5), lines = o.lines || 1, font = o.font || (s => { ctx.font = '800 ' + s + 'px sans-serif'; });
  const step = Math.max(1, size / 50), W = s => (font(s), ctx.measureText(t).width);
  const pcs = []; t.split(' ').forEach((w, wi) => w.replace(/-/g, '-\u0001').split('\u0001').forEach((p, pi) => p && pcs.push({ t: p, sep: wi && !pi ? ' ' : '' })));
  const join = (a, b) => pcs.slice(a, b).map((p, i) => (i ? p.sep : '') + p.t).join('');
