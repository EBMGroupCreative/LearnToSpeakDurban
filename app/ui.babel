  for (let s = min; s > 4; s -= Math.max(0.5, step / 2)) { if (W(s) <= maxW) return { size: s, lines: [t] }; if (lines > 1 && pcs.length > 1) { const l = two(s); if (l) return { size: s, lines: l }; } }
