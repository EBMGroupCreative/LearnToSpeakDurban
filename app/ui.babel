  const fail = () => { LTSD_SAY.bad[s] = true; delete LTSD_SAY.cache[s]; if (LTSD_SAY.a === a) LTSD_SAY.a = null; saySet(LTSD_SAY.a ? LTSD_SAY.slug : null, LTSD_SAY.a ? LTSD_SAY.st : 'idle'); };
  a.onplaying = () => { if (LTSD_SAY.a === a) saySet(s, 'playing'); };
  a.onended = () => { if (LTSD_SAY.a === a) { LTSD_SAY.a = null; saySet(null, 'idle'); } };
  a.onerror = fail;
