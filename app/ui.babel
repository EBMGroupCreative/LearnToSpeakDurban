// Shared primitives for microsite v2. No icons: type, highlight and handles only. One exception: the pronunciation speaker (SayBtn), by request.
const pad2 = n => String(n).padStart(2, '0');

// Optical spacing for the highlight: glyphs carry uneven side-bearings (a round G sits in, a y hangs out) and tight letter-spacing eats
// the right edge. Measure the ink and pad each side so the gap from ink to handle is the same on both. Skipped if the word has wrapped.
const SEL_CV = document.createElement('canvas').getContext('2d');
function ltsdInk(c, t) { const m = c.measureText(t); return { l: -m.actualBoundingBoxLeft, r: m.actualBoundingBoxRight, w: m.width }; }
function selTrim(el) {
  let t = ''; el.childNodes.forEach(n => { if (n.nodeType === 3) t += n.nodeValue; else if (n.nodeType === 1 && !n.classList.contains('h') && !n.classList.contains('pop')) t += n.textContent; });
  t = t.trim(); if (!t) return;
  if (el._selP == null) { el.style.paddingLeft = el.style.paddingRight = ''; }
  const cs = getComputedStyle(el), fs = parseFloat(cs.fontSize); if (!fs) return;
  if (cs.textTransform === 'uppercase') t = t.toUpperCase();
  const ls = cs.letterSpacing === 'normal' ? 0 : parseFloat(cs.letterSpacing) / fs * 100 || 0;
  const key = t + '|' + cs.fontStyle + cs.fontWeight + cs.fontFamily + '|' + ls.toFixed(2) + '|' + el.className;
  if (el._selKey === key) return;
  if (el._selP == null || el._selCls !== el.className) { el.style.paddingLeft = el.style.paddingRight = ''; el._selP = parseFloat(getComputedStyle(el).paddingLeft) / fs; el._selCls = el.className; }
  const c = SEL_CV; c.font = cs.fontStyle + ' ' + cs.fontWeight + ' 100px ' + cs.fontFamily;
  const native = 'letterSpacing' in c; if (native) c.letterSpacing = ls + 'px';
  let { l, r, w } = ltsdInk(c, t); if (native) c.letterSpacing = '0px'; else { w += ls * t.length; r += ls * (t.length - 1); }
  const P = el._selP, lsb = l / 100, rsb = (w - r) / 100;
  if (w / 100 * fs > el.clientWidth - P * fs * 2 + 4) { el._selKey = key; return; }
  const gap = Math.max(P, P + (lsb + rsb) / 2);
  el.style.paddingLeft = Math.max(0, gap - lsb).toFixed(4) + 'em'; el.style.paddingRight = Math.max(0, gap - rsb).toFixed(4) + 'em';
  el._selKey = key;
}
function Sel({ children, on = true, handles = true, className = '', ...rest }) {
  const ref = React.useRef(null);
  React.useLayoutEffect(() => { const el = ref.current; if (!el) return; selTrim(el); if (document.fonts && document.fonts.status !== 'loaded') document.fonts.ready.then(() => { if (ref.current) { ref.current._selKey = null; selTrim(ref.current); } }); });
  return <span ref={ref} className={'sel' + (on ? ' on' : '') + (className ? ' ' + className : '')} {...rest}>{children}{on && handles && <><i className="h l"></i><i className="h r"></i></>}</span>;
}

// Auto-fit: long words shrink to fit their box instead of clipping or breaking mid-word. Whole words only, never hyphenated.
// Measures with handles and popovers hidden so the highlight furniture never counts as overflow.
// lines = 1 or 2: the name rule (user-typed text in a fixed layout). One line first, shrinking to min; then (lines 2) wrap from the design size;
// last resort keeps shrinking past min. Never clipped, never cut off. Use as a block (as="div").
function Fit({ as = 'span', className = '', min = 10, lines = 0, children, ...rest }) {
  const ref = React.useRef(null), base = (rest.style && rest.style.fontSize) || '';
  const run = React.useCallback(() => {
    const el = ref.current; if (!el) return;
    el.classList.add('fit-m'); el.style.fontSize = base; el.style.whiteSpace = lines ? 'nowrap' : '';
    const fs0 = parseFloat(getComputedStyle(el).fontSize) || 16; let fs = fs0, n = 0;
    const set = v => { fs = v; el.style.fontSize = v.toFixed(1) + 'px'; };
    const over = () => el.scrollWidth > el.clientWidth + 1;
    const tall = () => { if (lines < 2 || el.style.whiteSpace !== 'normal') return false; const cs = getComputedStyle(el), lh = parseFloat(cs.lineHeight) || fs * 1.2; return el.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom) > lh * lines + 2; };
    while (over() && fs > min && n++ < 40) set(Math.max(min, fs * 0.94));
    if (over() && lines > 1) { el.style.whiteSpace = 'normal'; set(fs0); n = 0; while ((over() || tall()) && fs > min && n++ < 40) set(Math.max(min, fs * 0.94)); }
    n = 0; while ((over() || tall()) && fs > 6 && n++ < 60) set(fs * 0.94);
    el.classList.remove('fit-m');
  }, [min, base, lines]);
