    const el = ref.current; if (!el) return;
    let w = 0, ro; if (window.ResizeObserver) { ro = new ResizeObserver(es => { const nw = Math.round(es[0].contentRect.width); if (nw !== w) { w = nw; run(); } }); ro.observe(el.parentElement || el); }
    // Re-fit when any web font (or a new weight) lands: text measured in the fallback face is narrower and would overflow later.
    const F = document.fonts, raf = requestAnimationFrame(run);
    if (F && F.status !== 'loaded') F.ready.then(run);
    if (F && F.addEventListener) F.addEventListener('loadingdone', run);
    return () => { ro && ro.disconnect(); cancelAnimationFrame(raf); F && F.removeEventListener && F.removeEventListener('loadingdone', run); };
  }, [run]);
