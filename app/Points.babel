// Points + leaderboard.
// Score = your BEST result in each of the 11 games, added up. Each game is capped at 1,000, except The Great Migration and Keep it cold (arcade, no cap).
// Live board: set window.LSD_CONFIG.leaderboardUrl (see docs/leaderboard-api.md). Without it the board
// shows demo rivals (LSD_CONFIG.demoRivals = true) or only the students on this device (false).
const PT_GAMES = ['game-02', 'game-03', 'game-04', 'game-05', 'game-07', 'game-08', 'game-09', 'game-14', 'game-11', 'game-12', 'game-13'];
const PT_TOTAL = PT_GAMES.length * 1000;
const PT_RULES = {
  'game-02': ['Spot the Vaalie', 'Find all five, few false reports, fast. Speed counts.'],
  'game-03': ['Ja / No Laka', '45 per right answer, minus 15 per wrong one. Capped at 1,000. Guessing gets about 350 marks.'],
  'game-04': ['Durdle', 'Fewer tries and a faster solve, more marks. One word a day, one go a day.'],
  'game-05': ['Pack for Durban', 'A clean pack, packed fast. Speed counts.'],
  'game-07': ['The braai clock', 'Find the time the braai decides in six guesses. 1,000 on the first guess, minus 120 per extra guess. Missed it: up to 300 for getting close.'],
  'game-08': ['Fork patrol', '20 per fork confiscated. 50 forks gets you the full 1,000.'],
  'game-09': ['The Great Migration', 'Arcade rules, no cap. 10 per metre flown. 100 per mango, litchi, slops, pineapple, soft serve, watermelon, beach ball or coconut; 500 per flamingo; 250 per music note. Pickups are multiplied by your speed level (1 to 5) and your combo: five in a row ups it, up to ×8. Hit the work and you lose a heart, your combo and 300 × speed level. Granadilla lolly: four seconds untouchable, 250 × speed level per piece of work smashed. +5,000 through the Moses Mabhida arch, +2,500 per heart left, +10,000 for landing without a wobble. Three wobbles and you’re grounded: you keep the score.'],
  'game-14': ['Keep it cold', 'Arcade rules, no cap. Marks every second you last, and the rate climbs with the heat. Ice the hottest thing first for a combo, up to ×4. Bonuses for close ones, shooing seagulls and slapping small hands. Three hearts.'],
  'game-12': ['Lost & Found', '100 per word found. All eight: plus up to 200 for speed. One go a day.'],
  'game-13': ['The Deck Chair', '700 for handing it in, plus up to 300 for speed, minus 25 per wrong letter. One go a day.'],
  'game-11': ['Snap, ekse', '50 per pair (400). Plus up to 600 for time: 600 at 45 seconds, down to 0 at 150. Minus 10 per wrong pair. Never below 400.'],
};
const PT_MAX = 1000;
const ptsFmt = n => Math.round(+n || 0).toLocaleString('en-US');
const PT_CAP = { 'game-09': Infinity, 'game-14': Infinity }; // arcade games: no cap
const ptsClamp = (n, id) => Math.max(0, Math.min(PT_CAP[id] || PT_MAX, Math.round(+n || 0)));
const lbCfg = () => window.LSD_CONFIG || {};

function readPoints() { try { const p = JSON.parse(localStorage.getItem(lsdKey('lsd2-points'))) || {}; const o = {}; PT_GAMES.forEach(g => { if (p[g]) o[g] = ptsClamp(p[g], g); }); return o; } catch (e) { return {}; } }
const pointsTotal = p => PT_GAMES.reduce((s, g) => s + ptsClamp((p || {})[g], g), 0);
function lbPlayer() {
  try { const s = JSON.parse(localStorage.getItem('lsd2-session')); const p = s && (JSON.parse(localStorage.getItem('lsd2-profiles')) || {})[s]; return p ? { id: 'p_' + codeHash(p.email), username: p.username || ('student' + codeHash(p.email).slice(0, 4)), location: p.location || '' } : null; } catch (e) { return null; }
}
function awardGame(id, pts) {
  if (!PT_GAMES.includes(id)) return { prev: 0, isBest: false };
  const v = ptsClamp(pts, id), p = readPoints(), prev = p[id] || 0, isBest = v > prev;
  if (isBest) { p[id] = v; try { localStorage.setItem(lsdKey('lsd2-points'), JSON.stringify(p)); } catch (e) {} window.dispatchEvent(new CustomEvent('lsd2-store', { detail: { key: 'lsd2-points', n: p } })); }
  const url = lbCfg().leaderboardUrl, me = lbPlayer();
  if (url && me) fetch(url.replace(/\/$/, '') + '/scores', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ player: me, game: id, points: v, ts: Date.now() }) })
    .then(() => window.dispatchEvent(new Event('lsd2-scored'))).catch(() => {});
  return { prev, isBest };
}

// Demo rivals: seeded, then a loop that keeps bumping them. Preview only.
function lbRand(seed) { return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
const LB_FIRST = ['Thabo', 'Karen', 'Sipho', 'Priya', 'Dave', 'Lerato', 'Johan', 'Ayesha', 'Bongani', 'Megan', 'Kabelo', 'Riaan', 'Naledi', 'Craig', 'Zanele', 'Kevin', 'Thandeka', 'Pieter', 'Nomvula', 'Brandon', 'Fatima', 'Lwazi', 'Chantelle', 'Musa', 'Tegan', 'Vusi', 'Anika', 'Sizwe', 'Liezl', 'Kyle'];
const LB_FROM = ['Sandton', 'Centurion', 'Randburg', 'Fourways', 'Bryanston', 'Midrand', 'Soweto', 'Benoni', 'Boksburg', 'Rosebank', 'Melville', 'Pretoria', 'Roodepoort', 'Kempton Park', 'Umhlanga', 'Chatsworth', 'Morningside', 'Umlazi', 'Westville', 'Ballito', 'Glenwood', 'Durban North'];
const LB_GAMES = PT_GAMES.map(g => PT_RULES[g][0]);
function lbDemo() {
  if (window.__lsdLB) return window.__lsdLB;
  const r = lbRand(2026), rivals = [];
  for (let i = 0; i < 300; i++) rivals.push({ id: 'd' + i, name: LB_FIRST[Math.floor(r() * LB_FIRST.length)].toLowerCase() + ['_', '.', '', '_the_'][Math.floor(r() * 4)] + ['kook', 'bru', 'jhb', 'dbn', 'shap', 'vaalie', String(Math.floor(r() * 90) + 10), 'abcdgklmnprstvz'[Math.floor(r() * 15)]][Math.floor(r() * 8)], from: LB_FROM[Math.floor(r() * LB_FROM.length)], pts: Math.round(8300 * Math.pow(r(), 2.3) / 10) * 10 + 50 });
  const S = window.__lsdLB = { rivals, feed: [], subs: new Set() };
  const tick = () => {
    const top = [...S.rivals].sort((a, b) => b.pts - a.pts), who = top[Math.floor(Math.pow(Math.random(), 1.6) * 120)];
    const add = Math.round((60 + Math.random() * 380) / 10) * 10; who.pts = Math.min(PT_TOTAL, who.pts + add);
    S.feed = [{ t: Date.now(), name: who.name, from: who.from, add, g: LB_GAMES[Math.floor(Math.random() * LB_GAMES.length)] }, ...S.feed].slice(0, 6);
    S.subs.forEach(f => f()); setTimeout(tick, 2200 + Math.random() * 2800);
  };
  setTimeout(tick, 1200);
  return S;
}
// Other students who enrolled on this device (real, local).
function lbLocal(skip) {
  const out = []; try { const ps = JSON.parse(localStorage.getItem('lsd2-profiles')) || {};
    Object.values(ps).forEach(p => { if (p.email === skip) return; let pts = {}; try { pts = JSON.parse(localStorage.getItem('lsd2-points@' + p.email)) || {}; } catch (e) {} out.push({ id: 'l_' + p.email, name: p.username || ('student' + codeHash(p.email).slice(0, 4)), from: p.location || 'This device', pts: pointsTotal(pts) }); });
  } catch (e) {} return out;
}

function useBoard() {
  const cfg = lbCfg(), url = (cfg.leaderboardUrl || '').replace(/\/$/, '');
  const mode = url ? 'live' : cfg.demoRivals === false ? 'local' : 'demo';
  const [, force] = React.useState(0);
  const [remote, setRemote] = React.useState(window.__lsdRemote || null);
  const [points] = useStored('lsd2-points', {});
  const [session] = useStored('lsd2-session', null);
  const me = useProfile();
  React.useEffect(() => { if (mode !== 'demo') return; const S = lbDemo(), f = () => force(x => x + 1); S.subs.add(f); return () => S.subs.delete(f); }, [mode]);
  React.useEffect(() => {
    if (mode !== 'live') return; const pl = lbPlayer(); let stop = false;
    const load = () => fetch(url + '/board?player=' + encodeURIComponent(pl ? pl.id : '')).then(r => r.json()).then(d => { if (!stop) { window.__lsdRemote = d; setRemote(d); } }).catch(() => {});
    load(); const t = setInterval(load, 15000); addEventListener('lsd2-scored', load);
    return () => { stop = true; clearInterval(t); removeEventListener('lsd2-scored', load); };
  }, [mode, url, session]);
  const mine = pointsTotal(points);
  const youBase = { id: 'you', you: true, name: me ? (me.username || ('student' + codeHash(me.email).slice(0, 4))) : 'You', from: (me && me.location) || 'This device', pts: mine };
  if (mode === 'live') {
    const d = remote || {}, map = r => ({ id: r.id, name: r.username || r.name, from: r.location || '', pts: +r.points || 0, pos: r.pos, you: d.you && r.id === d.you.id });
    const top = (d.top || []).map(map), near = (d.near || []).map(map);
    const you = { ...youBase, pts: Math.max(mine, d.you ? +d.you.points || 0 : 0), pos: d.you ? d.you.pos : top.length + 1 };
    const all = [...top, ...near], ahead = all.find(r => r.pos === you.pos - 1);
    const feed = (d.feed || []).map(f => ({ t: f.ts, name: f.username || f.name, from: f.location, add: f.points, g: (PT_RULES[f.game] || [f.game])[0] }));
    return { mode, top, near: you.pos > top.length ? near : [], you, ahead, total: d.total || all.length || 1, feed, points, ready: !!remote };
  }
  const rows = [...(mode === 'demo' ? lbDemo().rivals : []), ...lbLocal(me && me.email), youBase].sort((a, b) => b.pts - a.pts || (a.you ? -1 : b.you ? 1 : 0)).map((r, i) => ({ ...r, pos: i + 1 }));
  const you = rows.find(r => r.you), top = rows.slice(0, 10);
  const near = you.pos > 10 ? rows.slice(Math.max(10, you.pos - 3), you.pos + 2) : [];
  return { mode, top, near, you, ahead: rows[you.pos - 2], total: rows.length, feed: mode === 'demo' ? lbDemo().feed : [], points, ready: true };
}

// Speed counts in every game. The clock starts on your first move and stops the moment you finish.
// Untimed-by-nature games (Spot the Vaalie, Pack for Durban, the braai clock): marks = accuracy × (0.7 + 0.3 × speed), speed 1 = fast, 0 = slow.
function useGameClock() {
  const [t0, setT0] = React.useState(null), [t1, setT1] = React.useState(null), [, tick] = React.useState(0);
  React.useEffect(() => { if (!t0 || t1) return; const i = setInterval(() => tick(x => x + 1), 250); return () => clearInterval(i); }, [t0, t1]);
  return { secs: t0 ? ((t1 || Date.now()) - t0) / 1000 : 0, started: !!t0, running: !!t0 && !t1, start: () => setT0(t => t || Date.now()), stop: () => setT1(t => t || Date.now()), reset: () => { setT0(null); setT1(null); } };
}
// Start screen for timed games: nothing to read until the clock is running. No cheesing it.
// How to play: shown on every game’s start screen, before the clock starts. The Great Migration and Keep it cold carry their own.
const HOW = {
  'game-02': [['Read', 'A Durban beach, in writing. Five vaalies are hiding among the locals.'], ['Tap', 'Tap the giveaway word, not the person. Socks with sandals, that sort of thing.'], ['Careful', 'Every false report costs 100. So does dawdling.'], ['Score', 'Up to 1,000. Find all five fast with no false reports.']],
  'game-03': [['Read', 'A statement about Durban appears. True or false?'], ['Agree', 'Hit No laka, or press J. Yes, no laka means yes.'], ['Disagree', 'Hit Eish, no, or press N.'], ['Score', '45 seconds. +45 a right answer, −15 a wrong one. Finish early for a bonus.']],
  'game-04': [['Guess', 'A five-letter word, six tries. Type it or use the keys.'], ['Blue', 'Right letter, right spot.'], ['Highlight', 'Right letter, wrong spot. Grey: not in the word.'], ['Daily', 'One word a day, one go. Fewer tries and a faster solve pay more.']],
  'game-05': [['Look', 'The bed is covered. Only some of it is going to Durban.'], ['Pack', 'Tap what you actually need, or drag it into the suitcase.'], ['Careful', 'Pack the wrong thing and it gets rejected at the border. −150 each.'], ['Score', 'Clean pack plus speed. The clock starts when you do.']],
  'game-07': [['Guess', 'The braai is ready some time between 19:00 and 23:00.'], ['Nudge', 'Use the buttons to set a time, then lock it in.'], ['Listen', 'The uncles tell you earlier or later. It’s usually later.'], ['Score', 'Six guesses. 400 for asking, plus a bonus for asking quickly.']],
  'game-08': [['Watch', 'Forks close in on the bunny from every side.'], ['Tap', 'Tap a fork to confiscate it before it reaches the bunny.'], ['Speed', 'More forks, faster, the longer you last.'], ['Score', '20 a fork, up to 1,000. One fork gets through and it’s over.']],
  'game-11': [['Flip', 'Sixteen cards face down: eight words, eight meanings.'], ['Match', 'Flip two. Word plus its meaning is a pair. Anything else flips back.'], ['Careful', 'Each wrong pair costs 10.'], ['Score', '400 for clearing the board, plus a bonus for speed.']],
  'game-12': [['Read', 'Eight clues. They give the meaning, not the word.'], ['Find', 'Drag across the letters to circle a word. Any direction.'], ['Daily', 'New letters at midnight. One go a day.'], ['Score', '100 a word, plus a speed bonus if you find all eight.']],
  'game-13': [['Fill', 'A mini crossword. Tap a square, type your answers.'], ['Hand in', 'Wrong letters only show when you hand it in. Each one costs 25.'], ['Daily', 'New crossword at midnight. One go a day.'], ['Score', '700, plus a bonus for speed, minus wrong letters.']],
};
function HowCards({ id }) {
  const h = HOW[id]; if (!h) return null;
  return <ul className="ng-rules how-rules">{h.map(([k, v]) => <li key={k}><span className="lbl blue">{k}</span><span>{v}</span></li>)}</ul>;
}
function GameGate({ kicker, title, line, cta, onStart, id }) {
  return (
    <div className="gm-center">
      <span className="lbl blue">{kicker}</span>
      <div className="hl" style={{ fontSize: 'clamp(44px, 6vw, 88px)' }}>{title}</div>
      <p className="lead" style={{ textAlign: 'center', margin: 0, maxWidth: 560 }}>{line}</p>
      <HowCards id={id} />
      <button type="button" className="btn primary" onClick={onStart}>{cta}</button>
      <span className="lbl muted">The clock starts when you press it. No peeking first.</span>
      <ChallengeBtn id={id} />
    </div>
  );
}
// The way out. Quiet on purpose: a last resort, not an option. Confirms inline, once.
function RevealBtn({ id, onReveal, daily }) {
  const [ask, setAsk] = React.useState(false);
  if (!ask) return <button type="button" className="btn rv" onClick={() => setAsk(true)}>[ Reveal it · 0 marks ]</button>;
  return (
    <div className="rv-ask lt-in" role="group" aria-label="Reveal the answer">
      <span>{'Sure? Revealing scores zero and the ' + (daily ? 'day' : 'round') + ' still counts.'}</span>
      <div className="row" style={{ gap: 8 }}>
        <button type="button" className="btn line sm" onClick={() => { ltsdEvent('reveal', { game: id }); setAsk(false); onReveal(); }}>[ Show me ]</button>
        <button type="button" className="btn primary sm" onClick={() => setAsk(false)} autoFocus>[ I’ll suffer on ]</button>
      </div>
    </div>
  );
}
const speedF = (secs, full, zero) => Math.max(0, Math.min(1, (zero - secs) / (zero - full)));
const speedMult = (secs, full, zero) => 0.7 + 0.3 * speedF(secs, full, zero);
const clockFmt = s => Math.floor(s / 60) + ':' + pad2(Math.floor(s % 60));
const speedLine = (secs, full, zero) => ' Time ' + clockFmt(secs) + ', speed ×' + speedMult(secs, full, zero).toFixed(2) + '.';

// share: extra result fields for the share text + card (false = the game places its own ShareRow, e.g. under Durdle's card).
// revealed = { answer, plural }: the player used Reveal. Zero marks, nothing filed to the Class Rankings, card says REVEALED.
function ScoreBanner({ id, pts, line, share, revealed }) {
  const v = ptsClamp(pts, id);
  const [prev] = React.useState(() => readPoints()[id] || 0);
  React.useEffect(() => { if (!revealed) awardGame(id, v); }, []);
  const isBest = v > prev;
  const { you, total } = useBoard();
  if (revealed) return (
    <div className="sb-wrap">
    <div className="sb">
      <div className="sb-l">
        <span className="lbl blue">Revealed · 0 marks</span>
        <div className="hl sb-n">0 <Sel>marks.</Sel></div>
        <span className="sb-rv">{(revealed.plural ? 'The answers were ' : 'The answer was ') + revealed.answer + '. Knowing isn’t the same as learning, ekse.'}</span>
      </div>
      <a className="sb-r" href="#leaderboard"><span className="lbl muted">Class Rankings</span><span className="hl sb-rank">#{you.pos}</span><span className="lbl">Not filed · see it</span></a>
    </div>
    {share !== false && <ShareRow id={id} r={{ ...(share || {}), revealed: true, pts: 0, kicker: 'Revealed' }} />}
    </div>
  );
  return (
    <div className="sb-wrap">
    <div className="sb">
      <div className="sb-l">
        <span className="lbl blue">{isBest ? (prev ? 'New personal best · +' + ptsFmt(v - prev) + ' on the board' : 'First marks, filed') : 'Personal best stays: ' + ptsFmt(prev)}</span>
        <div className="hl sb-n">{ptsFmt(v) + ' '}<Sel>marks.</Sel></div>
        <span className="lbl muted">{line || (isBest ? 'Gateway has updated your file.' : 'Only your best counts. This one is between you and the ocean.')}</span>
      </div>
      <a className="sb-r" href="#leaderboard"><span className="lbl muted">Class Rankings</span><span className="hl sb-rank">#{you.pos}</span><span className="lbl">{'of ' + ptsFmt(total) + ' · see it'}</span></a>
    </div>
    {share !== false && <ShareRow id={id} r={{ pts: v, kicker: isBest ? 'Personal best' : 'Result slip', ...(share || {}) }} />}
    </div>
  );
}

function LbRow({ r }) {
  return <div className={'lb-row' + (r.you ? ' you' : '') + (r.pos <= 3 ? ' podium' : '')}>
    <span className="lb-pos">{pad2(r.pos)}</span>
    <span className="lb-name">{r.you ? <Sel>{r.name}</Sel> : r.name}<span className="lbl muted lb-from">{r.from}</span></span>
    <span className="lb-pts">{ptsFmt(r.pts)}</span>
  </div>;
}
const lbKicker = m => m === 'live' ? 'Live · refreshes every 15 seconds' : m === 'demo' ? 'Live · updates while you watch' : 'Students on this device';
const lbAheadLine = (you, ahead) => !you.pts ? 'Zero marks. Same as a vaalie. Play any game to get on the board properly.' : ahead ? ptsFmt(ahead.pts - you.pts + 1) + ' marks to pass ' + ahead.name + (ahead.from ? ' from ' + ahead.from : '') + '.' : 'First place. Gateway is informing your manager.';

function MiniBoard() {
  const { top, you, total, feed, ahead } = useBoard();
  const t5 = top.slice(0, 3);
  return (
    <div className="mb">
      <div className="card lb-board">
        <div className="between lbl" style={{ padding: '10px 14px 12px', borderBottom: '1px solid var(--border-faint)', marginBottom: 6 }}><span className="blue">Class Rankings · top 3</span><a href="#leaderboard" className="lbl">{'See all ' + ptsFmt(total)}</a></div>
        {t5.map(r => <LbRow key={r.id} r={r} />)}
        {you.pos > 3 && <><div className="lb-gap lbl muted">· · ·</div><LbRow r={you} /></>}
      </div>
      <div className="card lb-me">
        <div className="between lbl"><span className="blue">Your position</span><span className="muted">{'of ' + ptsFmt(total)}</span></div>
        <div className="hl lb-big"><Sel>{'#' + you.pos}</Sel></div>
        <div className="between lbl"><span className="muted">Your marks</span><span>{ptsFmt(you.pts)}</span></div>
        <div className="lk-d">{lbAheadLine(you, ahead)}</div>
        {feed[0] && <div className="lbl muted">{'Live: ' + feed[0].name + ' +' + ptsFmt(feed[0].add) + ' in ' + feed[0].g}</div>}
      </div>
    </div>
  );
}

function LeaderboardScreen() {
  const { mode, top, near, you, ahead, points, feed, total } = useBoard();
  return (
    <div>
      <PageHead index="12" kicker={lbKicker(mode)} title="Class Rankings">
        <p className="lead" style={{ margin: 0 }}>Every student, ranked by marks from the eleven games. Your best marks in each game count, so replaying only helps if you beat yourself. Joburg is currently leading. That’s about to change.</p>
      </PageHead>
      <div className="lb">
        <div className="card lb-board">
          <div className="lb-head lbl"><span>Pos</span><span>Student</span><span style={{ textAlign: 'right' }}>Marks</span></div>
          {top.map(r => <LbRow key={r.id} r={r} />)}
          {near.length > 0 && <><div className="lb-gap lbl muted">{'· · · ' + ptsFmt(near[0].pos - 11) + ' students later · · ·'}</div>{near.map(r => <LbRow key={r.id} r={r} />)}</>}
        </div>
        <div className="lb-side">
          <div className="card lb-me">
            <div className="between lbl"><span className="blue">Your position</span><span className="muted">{'of ' + ptsFmt(total)}</span></div>
            <div className="hl lb-big"><Sel>{'#' + you.pos}</Sel></div>
            <div className="lk-d">{lbAheadLine(you, ahead)}</div>
            <div className="lb-games">{PT_GAMES.map(id => <a key={id} href={'#activities/' + id} className="lb-g"><span>{PT_RULES[id][0]}</span><b>{points[id] ? ptsFmt(points[id]) : '—'}</b></a>)}</div>
            <a className="btn primary" href="#activities">[ Earn marks ]</a>
          </div>
          {mode !== 'local' && <div className="card lb-feed">
            <div className="between lbl"><span className="blue">Live</span><span className="muted">Latest marks</span></div>
            {feed.length ? feed.map(f => <div key={f.t + f.name} className="lb-f"><b>{f.name}</b>{(f.from ? ' from ' + f.from : '') + ' got ' + ptsFmt(f.add) + ' in ' + f.g + '.'}</div>) : <div className="muted">Waiting for someone to finish their braai.</div>}
          </div>}
        </div>
      </div>
    </div>
  );
}

Object.assign(window, { GameGate, HowCards, useGameClock, speedF, speedMult, clockFmt, speedLine, pointsTotal, PT_TOTAL, PT_GAMES, PT_RULES, ptsFmt, ptsClamp, readPoints, awardGame, useBoard, ScoreBanner, MiniBoard, LeaderboardScreen });
