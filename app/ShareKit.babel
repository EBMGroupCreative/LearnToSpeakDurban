// SHARING SYSTEM. One pipeline for every game: [ Share this ] (native share sheet, clipboard fallback), [ Save the card ] (1080 × 1350 PNG),
// "Challenge someone" on intro screens, campaign hashtags on everything, Plausible "share" events. Sharing earns nothing, ever.
// The real domain, always. Whatever address the site is deployed on (GitHub Pages, staging), visitors only ever see or share learntospeakdurban.com.
// LTSD_DOMAIN is how it's DISPLAYED (captions, cards, footer: no https://, no slash). ltsdLink() is the tappable link that goes underneath.
const LTSD_DOMAIN = 'learntospeakdurban.com';
const LTSD_URL = 'https://' + LTSD_DOMAIN;
// The campaign's tracking handles. Always both, always this order, always this spelling.
const LTSD_TAGS = '#LearnToSpeakDurban #GatewayTheatreOfShopping';
const LTSD_QUIZ = { id: 'quiz', t: 'How Durban are you?', route: 'kit/quiz' };
const LTSD_EXAMG = { id: 'exam', t: 'The final exam', route: 'exam' };
const ltsdGame = id => id === 'quiz' ? LTSD_QUIZ : id === 'exam' ? LTSD_EXAMG : (() => { const g = (typeof GAMES2 !== 'undefined' ? GAMES2 : []).find(x => x.id === id) || { id, t: 'Learn to Speak Durban' }; return { ...g, route: 'activities/' + id }; })();
const ltsdLink = route => route ? LTSD_URL + '/#' + route : LTSD_URL;
// Share text: the line, the domain as text, the hashtags; the functional link on its own line underneath.
// e.g. “I got 177,488 marks on Fork patrol. The Class Rankings are watching. learntospeakdurban.com #LearnToSpeakDurban #GatewayTheatreOfShopping”
const ltsdCaption = line => line.replace(/[:\s]+$/, '.').replace(/\.\.$/, '.') + ' ' + LTSD_DOMAIN + ' ' + LTSD_TAGS;
const ltsdCompose = (line, route) => ltsdCaption(line) + '\n' + ltsdLink(route);
// Daily number: No. 1 = LSD_CONFIG.dailyStart (YYYY-MM-DD, local date). Everyone on the same day gets the same number.
const ltsdDailyNo = () => { const [y, m, d] = String((window.LSD_CONFIG || {}).dailyStart || '2026-11-01').split('-').map(Number), n = new Date(); return Math.max(1, Math.round((Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()) - Date.UTC(y, m - 1, d)) / 864e5) + 1); };

function ltsdShareLine(id, r) {
  const n = ltsdGame(id).t;
  if (!r) return 'I’m studying. This is studying. ' + n + ':';
  if (r.revealed) return n + (r.no ? ' No. ' + r.no : '') + ': REVEALED. 0 marks. Knowing isn’t the same as learning, ekse.';
  if (id === 'game-04') return 'Durdle No. ' + r.no + ': ' + r.score + '. Today’s word is very Durban.';
  if (id === 'game-12') return 'Lost & Found No. ' + r.no + ': ' + r.found + '/8 found. The rest are still out at low tide.';
  if (id === 'game-13') return 'The Deck Chair No. ' + r.no + ': ' + (r.wrong ? (r.right != null ? r.right + ' letters right, ' + r.wrong + ' freelancing' : r.wrong + ' letters freelancing') : 'clean sheet') + '. Lekker chair.';
  if (id === 'game-15') return r.mine === false ? 'The auntie did not choose my card. There is no appeals process. Deal yourself in:' : 'The auntie chose my card. There is no appeals process. Deal yourself in:';
  if (id === 'quiz') return r.title + '. That’s my official diagnosis. Get yours:';
  if (id === 'exam' && r.cert) return 'Certified fluent. ' + r.total + '/100 in the Learn to Speak Durban final exam. ' + r.grade + '.' + (r.sit > 1 ? ' ' + (['', '', 'Second', 'Third'][r.sit] || 'Eventual') + ' sitting. Don’t ask.' : '') + ' Sit it yourself:';
  if (r.pts != null) return 'I got ' + ptsFmt(r.pts) + ' marks on ' + n + '. The Class Rankings are watching.';
  return 'I’m studying. This is studying. ' + n + ':';
}
const ltsdShareText = (id, r) => ltsdCompose(ltsdShareLine(id, r), ltsdGame(id).route);

// Plausible custom event. Queues until the script loads; harmless if it never does.
function ltsdEvent(name, props) { try { window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); }; window.plausible(name, { props }); } catch (e) {} }
const ltsdTrack = (game, via) => ltsdEvent('share', { game, via });
// Resolves true only if the text really reached the clipboard. Call it straight from the click, before any await.
async function ltsdCopy(text) {
  try { if (navigator.clipboard && window.isSecureContext) { await navigator.clipboard.writeText(text); return true; } } catch (e) {}
  try { const t = document.createElement('textarea'); t.value = text; t.setAttribute('readonly', ''); t.style.cssText = 'position:fixed;opacity:0;top:0;left:0'; document.body.appendChild(t); t.select(); const ok = document.execCommand('copy'); t.remove(); return !!ok; } catch (e) { return false; }
}
// Desktop = anything that isn't a touch phone/tablet. Desktop Chrome/Safari have navigator.share too, but their sheet is easy to miss
// (and often closes silently), so computers always get the visible route: card downloads + caption copies + a toast.
const ltsdDesk = () => !ltsdPhone();
// Phones/tablets (touch-first). Computers with a share sheet (Safari on Mac, Chrome on Windows) are NOT phones: Save the card just downloads there.
const ltsdPhone = () => !!navigator.share && !!(window.matchMedia && matchMedia('(pointer: coarse)').matches);
function ltsdToast(msg) {
  let el = document.getElementById('ltsd-toast');
  if (!el) { el = document.createElement('div'); el.id = 'ltsd-toast'; el.className = 'ltsd-toast'; el.setAttribute('role', 'status'); document.body.appendChild(el); }
  el.textContent = msg; el.classList.remove('on'); void el.offsetWidth; el.classList.add('on');
  clearTimeout(el._t); el._t = setTimeout(() => el.classList.remove('on'), 2800);
}
// The link lives inside `text` (not `url`): share targets order text + url differently and some drop the text,
// so this is the only way the hashtags reliably land after the link.
async function ltsdShareLink(id, r, via) {
  const text = ltsdShareText(id, r);
  ltsdTrack(id, via || 'link');
  if (ltsdPhone()) { try { await navigator.share({ title: ltsdGame(id).t + ' · Learn to Speak Durban.', text }); ltsdToast('Sent. The group chat has been informed.'); } catch (e) {} return true; }
  const ok = await ltsdCopy(text);
  ltsdToast(ok ? 'Copied. Send it, ekse.' : 'The clipboard said no. Copy it below, ekse.');
  return ok;
}

// Who signed it: only students with a card get named, like a signed exam paper.
function ltsdSigner() {
  try {
    const J = k => JSON.parse(localStorage.getItem(k) || 'null');
    const sess = J('lsd2-session'), p = sess ? (J('lsd2-profiles') || {})[sess] : null;
    const no = p && p.no ? String(p.no).replace(/^LSD-/, 'LTSD-') : J(lsdKey('lsd2-cardno'));
    const name = String(J(lsdKey('lsd2-name')) || (p && p.name) || '').trim();
    if (!no || !name || (window.lsdBlocked && window.lsdBlocked(name))) return null;
    return { name, no };
  } catch (e) { return null; }
}

// ── RESULT CARD ── 1080 × 1350. Campaign paper, ink type, orange does one job: the selection (handles, Durdle hits, the wave).
const LTSD_CW = 1080, LTSD_CH = 1350;
let ltsdAssetsP = null;
const ltsdAssets = () => ltsdAssetsP || (ltsdAssetsP = Promise.all([
  Promise.all(['800 120px Switzer', '600 40px Switzer', '500 40px Switzer', "500 22px 'IBM Plex Mono'"].map(f => document.fonts.load(f))).catch(() => {}),
  new Promise(r => { const im = new Image(); im.onload = () => r(im); im.onerror = () => r(null); im.src = LSD_RES(window.LSD_ASSETS + 'logos/gateway-logo.png'); }),
]).then(([, logo]) => ({ logo })));

function ltsdDraw(cv, id, r, A) {
  const P = window.LSD_PAL || {}, OR = P.blue || '#E8571E', HL = P.hl || '#FCD5BE', PAPER = P.paper || '#f4f0ea', INK = '#111111', MUTED = '#6e6e73', POP = '#1d1d1f';
  const G = "'Switzer', 'Helvetica Neue', Arial, sans-serif", M = "'IBM Plex Mono', monospace";
  const W = LTSD_CW, H = LTSD_CH, L = 88, R = W - 88, CW = R - L;
  cv.width = W; cv.height = H; const x = cv.getContext('2d'); x.textBaseline = 'alphabetic'; x.textAlign = 'left';
  const mono = (t, X, Y, sz, col, al, ls, raw) => { x.font = '500 ' + sz + 'px ' + M; x.fillStyle = col || INK; x.textAlign = al || 'left'; x.letterSpacing = (ls == null ? sz * 0.08 : ls) + 'px'; x.fillText(raw ? t : String(t).toUpperCase(), X, Y); x.letterSpacing = '0px'; x.textAlign = 'left'; };
  const rr = (X, Y, w, h, rad) => { x.beginPath(); x.moveTo(X + rad, Y); x.arcTo(X + w, Y, X + w, Y + h, rad); x.arcTo(X + w, Y + h, X, Y + h, rad); x.arcTo(X, Y + h, X, Y, rad); x.arcTo(X, Y, X + w, Y, rad); x.closePath(); };
  const gro = (sz, wt) => { x.font = (wt || 800) + ' ' + sz + 'px ' + G; x.letterSpacing = (wt && wt < 700 ? -sz * 0.01 : -sz * 0.045) + 'px'; };
  const handles = (X, Y, w, h, bar, dot) => { x.fillStyle = OR; x.fillRect(X - bar / 2, Y, bar, h); x.fillRect(X + w - bar / 2, Y, bar, h); x.beginPath(); x.arc(X, Y - dot * 0.7, dot, 0, 7); x.fill(); x.beginPath(); x.arc(X + w, Y + h + dot * 0.7, dot, 0, 7); x.fill(); };
  // selected word: highlight + handles, the site's signature
  const sel = (t, X, base, sz) => { gro(sz); const m = x.measureText(t), w = m.width, top = base - sz * 0.8, h = sz * 0.98, g = sz * 0.05, bx = X - m.actualBoundingBoxLeft - g, bw = m.actualBoundingBoxLeft + m.actualBoundingBoxRight + g * 2; x.fillStyle = HL; x.fillRect(bx, top, bw, h); handles(bx, top, bw, h, Math.max(3, sz * 0.022), Math.max(6, sz * 0.055)); x.fillStyle = INK; x.fillText(t, X, base); x.letterSpacing = '0px'; return w; };
  const fitG = (t, max, sz, min) => { gro(sz); while (sz > min && x.measureText(t).width > max) { sz -= 4; gro(sz); } return sz; };
  const wrap = (t, max) => { const out = []; let cur = ''; String(t).split(/\s+/).forEach(w => { const n = cur ? cur + ' ' + w : w; if (cur && x.measureText(n).width > max) { out.push(cur); cur = w; } else cur = n; }); if (cur) out.push(cur); return out; };

  x.fillStyle = PAPER; x.fillRect(0, 0, W, H);
  const g = ltsdGame(id);
  // top: game name in the mono caption style
  mono(g.t, L, 112, 26, INK); mono(r.kicker || 'Result slip', R, 112, 26, MUTED, 'right');
  x.fillStyle = 'rgba(17,17,17,.12)'; x.fillRect(L, 144, CW, 2);

  // middle: the result, huge. Laid out in [TOP, BOT], centred vertically.
  const TOP = 190, BOT = 960;
  if (r.grades) {
    const n = Math.max(1, r.grades.length), gap = 16, tile = Math.min((CW * 0.72 - gap * 4) / 5, (400 - gap * (n - 1)) / n), rad = tile * 0.2, gw = tile * 5 + gap * 4;
    const scoreSz = 200, block = n * tile + (n - 1) * gap + 70 + scoreSz + 110;
    let y = TOP + (BOT - TOP - block) / 2;
    r.grades.forEach(row => { row.forEach((s, i) => { const X = L + i * (tile + gap); rr(X, y, tile, tile, rad); if (s === 'g') { x.fillStyle = OR; x.fill(); } else if (s === 'y') { x.fillStyle = HL; x.fill(); } else { x.fillStyle = '#fff'; x.fill(); x.strokeStyle = 'rgba(17,17,17,.12)'; x.lineWidth = 3; rr(X + 1.5, y + 1.5, tile - 3, tile - 3, rad); x.stroke(); } }); y += tile + gap; });
    y += 70 - gap + scoreSz * 0.8;
    if (r.revealed) { sel('Revealed.', L + 6, y, fitG('Revealed.', CW - 40, scoreSz, 100)); mono('Revealed · 0 marks · no spoilers', L, y + 96, 24, INK); }
    else { sel(r.score, L + 6, y, scoreSz); mono('No spoilers. Today’s word stays at the beach.', L, y + 96, 24, INK); }
  } else if (r.quiz) {
    const big = 250, lvSz = fitG(r.lv + '.', CW, 150, 80), descSz = 34;
    gro(34, 600); const dl = wrap(r.lvd, CW - 60);
    const block = big + 90 + lvSz + 50 + (30 + dl.length * 44);
    let y = TOP + (BOT - TOP - block) / 2 + big * 0.8;
    const pw = sel(r.pct + '%', L + 10, y, big); let ds = 110; gro(ds); while (ds > 56 && L + 10 + pw + 48 + x.measureText('Durban.').width > R) { ds -= 6; gro(ds); }
    x.fillStyle = INK; x.fillText('Durban.', L + 10 + pw + 48, y); x.letterSpacing = '0px';
    y += big * 0.2 + 90 + lvSz * 0.8; mono('Official diagnosis', L, y - lvSz * 0.8 - 14, 22, MUTED); gro(lvSz); x.fillStyle = INK; x.fillText(r.lv + '.', L, y); x.letterSpacing = '0px';
    const py = y + 50, ph = 30 + dl.length * 44; x.font = '600 ' + descSz + 'px ' + G; x.letterSpacing = '0px';
    const pwid = Math.min(CW, Math.max(...dl.map(t => x.measureText(t).width)) + 56);
    x.fillStyle = POP; rr(L, py, pwid, ph, 18); x.fill(); x.beginPath(); x.moveTo(L + 30, py + 1); x.lineTo(L + 44, py - 14); x.lineTo(L + 58, py + 1); x.fill();
    x.fillStyle = '#fff'; dl.forEach((t, i) => x.fillText(t, L + 28, py + 44 + i * 44));
  } else if (r.cert) {
    // the certificate, as a card: who, what, the mark, and the seal
    const nf = ltsdFitText(x, r.name, CW - 20, 132, { min: 72, lines: 2, size2: 112, font: s => gro(s) }), nameSz = nf.size, nl = nf.lines; // the name rule: complete, always
    const block = 60 + nameSz * nl.length * 1.02 + 40 + 110 + 80 + 40;
    let y = TOP + (BOT - TOP - block) / 2 + 20;
    x.strokeStyle = OR; x.lineWidth = 3; x.beginPath(); x.arc(R - 86, TOP + 70, 78, 0, 7); x.stroke(); x.lineWidth = 1.5; x.beginPath(); x.arc(R - 86, TOP + 70, 66, 0, 7); x.stroke();
    mono('Certified', R - 86, TOP + 48, 15, OR, 'center'); gro(40); x.fillStyle = OR; x.textAlign = 'center'; x.fillText('Fluent', R - 86, TOP + 84); x.textAlign = 'left'; x.letterSpacing = '0px'; mono('2026', R - 86, TOP + 110, 15, OR, 'center');
    mono('This certifies that', L, y, 24, MUTED); y += 40 + nameSz * 0.8;
    nl.forEach(t => { gro(nameSz); x.fillStyle = INK; x.fillText(t, L, y); x.letterSpacing = '0px'; y += nameSz * 1.02; });
    y += 110 - nameSz * 0.2; gro(100); x.fillStyle = INK; const sw = x.measureText('speaks ').width; x.fillText('speaks ', L, y); x.letterSpacing = '0px'; sel('Durban.', L + sw, y, 100);
    y += 80; mono('Mark ' + r.total + ' / 100 · ' + r.grade + (r.sit > 1 ? ' · Sitting ' + r.sit : ''), L, y, 26, INK);
    if (r.no) mono(r.no, L, y + 40, 22, MUTED);
  } else if (r.prompt) {
    // the winning card, set like a playing card from the printed deck
    const cw = 760, chh = 680, cx = (W - cw) / 2, cy = TOP + (BOT - TOP - chh) / 2, pad = 60;
    x.save(); x.translate(W / 2, cy + chh / 2); x.rotate(-0.035); x.translate(-W / 2, -(cy + chh / 2));
    x.shadowColor = 'rgba(0,0,0,.16)'; x.shadowBlur = 50; x.shadowOffsetY = 18; x.fillStyle = '#fff'; rr(cx, cy, cw, chh, 40); x.fill(); x.shadowColor = 'transparent';
    mono('Aunties Against Everyone', cx + pad, cy + pad + 14, 20, OR);
    const parts = String(r.prompt).split('____'), ans = String(r.card).replace(/[.!]$/, '');
    const toks = []; parts.forEach((p, i) => { p.split(/(\s+)/).forEach(w => w && toks.push({ s: w, hl: false })); if (i < parts.length - 1) ans.split(/(\s+)/).forEach(w => w && toks.push({ s: w, hl: true })); });
    const maxW = cw - pad * 2; let fs = 76, lines;
    const lay = () => { gro(fs); x.letterSpacing = (-fs * 0.03) + 'px'; const out = [[]]; let w = 0; toks.forEach(t => { if (/^\s+$/.test(t.s)) { if (out[out.length - 1].length) { out[out.length - 1].push(t); w += x.measureText(' ').width; } return; } const tw = x.measureText(t.s).width; if (w + tw > maxW && out[out.length - 1].length) { const l = out[out.length - 1]; while (l.length && /^\s+$/.test(l[l.length - 1].s)) l.pop(); out.push([]); w = 0; } out[out.length - 1].push(t); w += tw; }); return out.filter(l => l.length); };
    lines = lay(); while (lines.length * fs * 1.12 > chh - pad * 2 - 130 && fs > 34) { fs -= 4; lines = lay(); }
    let y = cy + pad + 80 + fs * 0.8;
    lines.forEach(l => { let X = cx + pad; l.forEach((t, i) => { const w = x.measureText(t.s).width; if (t.hl) { x.fillStyle = HL; x.fillRect(X - 4, y - fs * 0.8, w + 8, fs * 0.98); } X += w; }); X = cx + pad; l.forEach(t => { x.fillStyle = INK; x.fillText(t.s, X, y); X += x.measureText(t.s).width; }); y += fs * 1.12; });
    x.letterSpacing = '0px';
    x.fillStyle = 'rgba(17,17,17,.1)'; x.fillRect(cx + pad, cy + chh - pad - 46, maxW, 2);
    mono(r.mine === false ? 'Not my card · her decision is final' : 'My card · the auntie’s choice', cx + pad, cy + chh - pad, 18, MUTED); mono('No appeals', cx + cw - pad, cy + chh - pad, 18, MUTED, 'right');
    x.restore();
  } else {
    const rv = !!r.revealed, big = rv ? 'Revealed.' : r.big != null ? String(r.big) : ptsFmt(r.pts || 0), unit = rv ? '0 marks.' : r.unit || 'marks.', sub = rv ? 'Knowing isn’t the same as learning, ekse.' : r.sub || 'The Class Rankings are watching.';
    // the game's own art panel, same motif as its tile on the Games page, so every card is recognisable in a feed
    const PY = TOP, PH = 360;
    x.fillStyle = '#fff'; rr(L, PY, CW, PH, 36); x.fill();
    x.save(); rr(L, PY, CW, PH, 36); x.clip(); ltsdMotif(x, id, { X: L, Y: PY, W: CW, H: PH }, A, { OR, HL, INK, MUTED, PAPER, POP, G, M, rr, sel, mono, gro, handles }); x.restore();
    // the score, selected, with its unit beside it
    const ly0 = PY + PH + 56; mono(rv ? 'Revealed · 0 marks' : r.label || 'Result', L, ly0, 22, MUTED);
    let bs = 200, us = 100; const rowW = () => { gro(bs); const bw = x.measureText(big).width; gro(us); return bw + bs * 0.08 + 34 + x.measureText(unit).width; };
    while (bs > 96 && rowW() > CW - 16) { bs -= 6; us = Math.max(56, Math.round(bs * 0.5)); }
    const base = ly0 + 34 + bs * 0.8, bw = sel(big, L + 10, base, bs);
    gro(us); x.fillStyle = INK; x.fillText(unit, L + 10 + bw + bs * 0.04 + 34, base); x.letterSpacing = '0px';
    x.font = '500 38px ' + G; x.letterSpacing = '-0.4px'; x.fillStyle = INK; wrap(sub, CW - 8).slice(0, 2).forEach((t, i) => x.fillText(t, L + 4, base + 100 + i * 48)); x.letterSpacing = '0px';
  }

  // bottom block: lockup + wave (as the printed Aunties deck), URL, hashtags, the 031 fine print
  const ly = 1046, lk = 60; gro(lk);
  const t1 = 'Learn to speak ', t2 = 'Durban.', w1 = x.measureText(t1).width, w2 = x.measureText(t2).width;
  x.fillStyle = HL; x.fillRect(L + w1 - 3, ly - lk * 0.86, w2 + 8, lk * 1.02); handles(L + w1 - 3, ly - lk * 0.86, w2 + 8, lk * 1.02, 3, 6.5);
  x.fillStyle = INK; x.fillText(t1 + t2, L, ly); x.letterSpacing = '0px';
  mono('A public service by Gateway', L, ly + 46, 22, INK);
  mono('learntospeakdurban.com', L, ly + 82, 22, INK, 'left', 0.5, true);
  const ww = Math.max(w1 + w2, 460), wh = ww * 24.6 / 418.3, wy = ly + 104;
  if (window.LTSD_WAVE_D && window.Path2D) { x.save(); x.translate(L, wy); x.scale(ww / 418.3, wh / 24.6); x.translate(-40.5, -238); x.fillStyle = OR; x.fill(new Path2D(window.LTSD_WAVE_D)); x.restore(); }
  mono(LTSD_TAGS, L, wy + wh + 46, 21, INK, 'left', 0.4, true);
  const s = ltsdSigner();
  const sg = (s ? 'Signed: ' + s.name + ' · ' + s.no + ' · ' : '') + LTSD_SLUG, sgF = z => { x.font = '500 ' + z + 'px ' + M; x.letterSpacing = '1.5px'; };
  mono(sg, L, wy + wh + 82, ltsdFitText(x, sg.toUpperCase(), CW, 15, { min: 9, font: sgF }).size, '#a1a1a6', 'left', 1.5);
  if (A && A.logo) { const lh = 168, lw = A.logo.width / A.logo.height * lh; x.drawImage(A.logo, R - lw, ly + 82 - lh + 8, lw, lh); }
  return cv;
}
// Per-game art for the card panel. Same PNGs as the game tiles. Loaded once, cached.
const LTSD_ART = {
  'game-05': ['assets/pack/suitcase.png', 'assets/pack/baggies.png', 'assets/pack/slops.png'],
  'game-08': ['assets/bunny-chow.png', 'assets/pack/fork.png'],
  'game-09': ['assets/duck-suitcase.png', 'assets/migration/mango.png', 'assets/migration/litchi.png'],
  'game-14': ['assets/cooler/cooler.png', 'assets/cooler/ice-block.png', 'assets/cooler/prawns.png'],
};
const ltsdArtP = {};
const ltsdArt = id => ltsdArtP[id] || (ltsdArtP[id] = Promise.all((LTSD_ART[id] || []).map(p => new Promise(res => { const im = new Image(); im.onload = () => res(im); im.onerror = () => res(null); im.src = LSD_RES(p); }))));
async function ltsdResultCard(id, r, cv) { const A = await ltsdAssets(), art = await ltsdArt(id); return ltsdDraw(cv || document.createElement('canvas'), id, r, { ...A, art }); }

// The motif inside the card's white panel. Campaign vocabulary only: selection highlight + orange handles, rounded tiles, pills, popover, game PNGs. Never a spoiler.
function ltsdMotif(x, id, b, A, k) {
  const { OR, HL, INK, MUTED, PAPER, POP, G, M, rr, sel, mono, gro, handles } = k, cx = b.X + b.W / 2, cy = b.Y + b.H / 2, art = (A && A.art) || [];
  const pic = (im, X, Y, h, rot) => { if (!im) return; const w = im.width / im.height * h; x.save(); x.translate(X, Y); if (rot) x.rotate(rot); x.shadowColor = 'rgba(0,0,0,.18)'; x.shadowBlur = 26; x.shadowOffsetY = 12; x.drawImage(im, -w / 2, -h / 2, w, h); x.restore(); };
  const txt = (t, X, Y, font, col, al) => { x.font = font; x.fillStyle = col; x.textAlign = al || 'center'; x.fillText(t, X, Y); x.textAlign = 'left'; x.letterSpacing = '0px'; };
  const pop = (t, X, Y) => { x.font = '600 26px ' + G; x.letterSpacing = '0px'; const w = x.measureText(t).width + 44, h = 54; x.fillStyle = POP; rr(X - w / 2, Y - h, w, h, 14); x.fill(); x.beginPath(); x.moveTo(X - 11, Y - 1); x.lineTo(X, Y + 11); x.lineTo(X + 11, Y - 1); x.fill(); x.fillStyle = '#fff'; x.textAlign = 'center'; x.fillText(t, X, Y - 18); x.textAlign = 'left'; };
  const tile = (X, Y, w, h, rad, fill, stroke) => { rr(X, Y, w, h, rad); x.fillStyle = fill; x.fill(); if (stroke) { x.strokeStyle = stroke; x.lineWidth = 3; rr(X + 1.5, Y + 1.5, w - 3, h - 3, rad); x.stroke(); } };
  if (id === 'game-02') { // Spot the Vaalie: the giveaway, reported
    const sz = 54; gro(sz); const a = 'A tourist ', s1 = 'asks for a fork', wa = x.measureText(a).width; gro(sz); const ws = x.measureText(s1).width, X0 = cx - (wa + ws) / 2, base = cy + 6;
    gro(sz); x.fillStyle = INK; x.fillText(a, X0, base); x.letterSpacing = '0px'; sel(s1, X0 + wa, base, sz);
    gro(sz); x.fillStyle = INK; x.fillText('with his bunny…', X0, base + 70); x.letterSpacing = '0px';
    pop('Reported', X0 + wa + ws / 2, base - sz * 0.8 - 22);
  } else if (id === 'game-03') { // Ja / No Laka: the two buttons
    const w = 320, h = 108, g = 28, X0 = cx - w - g / 2;
    tile(X0, cy - h / 2, w, h, h / 2, OR); txt('No laka', X0 + w / 2, cy + 15, '600 42px ' + G, '#fff');
    tile(cx + g / 2, cy - h / 2, w, h, h / 2, '#fff', INK); txt('Eish, no', cx + g / 2 + w / 2, cy + 15, '600 42px ' + G, INK);
    mono('No laka means yes', cx, cy + h / 2 + 56, 20, MUTED, 'center');
  } else if (id === 'game-05') { // Pack for Durban
    pic(art[1], cx - 270, cy + 40, 130, -0.22); pic(art[2], cx + 270, cy + 54, 112, 0.24); pic(art[0], cx, cy + 6, 260);
  } else if (id === 'game-07') { // The braai clock: there is no time
    const sz = 190; gro(sz); x.font = '800 ' + sz + 'px ' + G; const a = '??:', wa = x.measureText(a).width, wb = x.measureText('??').width, X0 = cx - (wa + wb + sz * 0.08) / 2, base = cy + sz * 0.34;
    x.fillStyle = INK; x.fillText(a, X0, base); x.letterSpacing = '0px'; sel('??', X0 + wa + sz * 0.04, base, sz);
  } else if (id === 'game-08') { // Fork patrol
    pic(art[1], cx - 250, cy, 150, Math.PI / 2); pic(art[1], cx + 250, cy, 150, -Math.PI / 2); pic(art[0], cx, cy + 8, 220);
  } else if (id === 'game-09') { // The Great Migration
    pic(art[1], cx - 290, cy - 70, 96, -0.3); pic(art[2], cx + 300, cy + 76, 84, 0.2); pic(art[0], cx, cy + 4, 290, -0.1);
  } else if (id === 'game-11') { // Snap, ekse: a word, its meaning, a face-down card
    const w = 220, h = 160, g = 24, X0 = cx - (w * 3 + g * 2) / 2, Y0 = cy - h / 2;
    tile(X0, Y0, w, h, 20, '#fff', 'rgba(17,17,17,.16)'); gro(52); txt('Shot', X0 + w / 2, cy + 18, '800 52px ' + G, INK);
    tile(X0 + w + g, Y0, w, h, 20, HL); txt('Thank you', X0 + w * 1.5 + g, cy + 12, '700 34px ' + G, INK);
    x.save(); x.translate(X0 + w * 2.5 + g * 2, cy); x.rotate(0.06); tile(-w / 2, -h / 2, w, h, 20, OR); x.restore(); mono('Snap', X0 + w * 2.5 + g * 2, cy + 9, 26, '#fff', 'center');
  } else if (id === 'game-12') { // Lost & Found: letters, one run found and selected
    const rows = ['KAWIEBRUPZ', 'LOMEKSITXQ', 'TRFOUNDBLE', 'NIYPAHSUVO'], t = 66, g = 8, gw = 10 * t + 9 * g, gh = 4 * t + 3 * g, X0 = cx - gw / 2, Y0 = cy - gh / 2;
    rows.forEach((row, ri) => row.split('').forEach((c, ci) => { const X = X0 + ci * (t + g), Y = Y0 + ri * (t + g), on = ri === 2 && ci >= 2 && ci <= 6; tile(X, Y, t, t, 14, on ? HL : PAPER); txt(c, X + t / 2, Y + t / 2 + 12, '600 32px ' + M, INK); }));
    const hx = X0 + 2 * (t + g) - 4, hy = Y0 + 2 * (t + g) - 4, hw = 5 * t + 4 * g + 8, hh = t + 8; handles(hx, hy, hw, hh, 4, 9);
  } else if (id === 'game-13') { // The Deck Chair: a mini crossword, empty, the current word selected
    const P = ['....#', '.#.#.', '.....', '.#.#.', '#....'], t = 56, g = 6, gw = 5 * t + 4 * g, X0 = cx - gw / 2, Y0 = cy - gw / 2, N = { '0,0': 1, '0,2': 2, '1,4': 3, '2,0': 4, '4,1': 5 };
    P.forEach((row, ri) => row.split('').forEach((c, ci) => { const X = X0 + ci * (t + g), Y = Y0 + ri * (t + g); if (c === '#') { tile(X, Y, t, t, 10, INK); return; } tile(X, Y, t, t, 10, ri === 2 ? HL : '#fff', ri === 2 ? null : 'rgba(17,17,17,.16)'); if (N[ri + ',' + ci]) txt(String(N[ri + ',' + ci]), X + 8, Y + 19, '600 14px ' + M, INK, 'left'); }));
    x.strokeStyle = OR; x.lineWidth = 4; rr(X0 + (t + g) + 2, Y0 + 2 * (t + g) + 2, t - 4, t - 4, 9); x.stroke();
    pop('4 across', X0 + (t + g) + t / 2, Y0 + 2 * (t + g) - 16);
  } else if (id === 'game-14') { // Keep it cold
    pic(art[1], cx - 260, cy - 40, 104, -0.22); pic(art[2], cx + 270, cy + 50, 100, 0.16); pic(art[0], cx, cy + 10, 250);
  } else { const g = ltsdGame(id); sel(g.t, b.X + 60, cy + 30, 80); }
}

// ltsd-[game]-[date].png, e.g. ltsd-durdle-12dez.png, ltsd-deck-chair-3jan.png
const LTSD_MON = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dez'];
function ltsdFileName(id) {
  const g = id === 'quiz' ? 'how-durban-are-you' : id === 'exam' ? 'certificate' : String(ltsdGame(id).t).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').replace(/^the-/, '');
  const d = window.lsdNow ? lsdNow() : new Date();
  return 'ltsd-' + g + '-' + d.getDate() + LTSD_MON[d.getMonth()] + '.png';
}
async function ltsdCardBlob(id, r) { const cv = await ltsdResultCard(id, r); return new Promise(res => cv.toBlob(res, 'image/png')); }
function ltsdDownload(b, name) { const u = URL.createObjectURL(b), a = document.createElement('a'); a.href = u; a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 4000); }
// Phones: the card goes to the native share sheet as a file. Computers: it downloads, nothing else.
async function ltsdShareCard(id, r, pre) {
  const name = ltsdFileName(id), f = pre || new File([await ltsdCardBlob(id, r)], name, { type: 'image/png' }), b = f, text = ltsdShareText(id, r);
  ltsdTrack(id, 'card');
  if (ltsdPhone() && navigator.canShare && navigator.canShare({ files: [f] })) { try { await navigator.share({ files: [f] }); ltsdToast('Card saved. Post it somewhere inland.'); return; } catch (e) { if (e && e.name === 'AbortError') return; } }
  ltsdDownload(b, name); ltsdToast('Card downloaded: ' + name + '. Post it somewhere inland.');
}
// Phones: [ Share this ] sends the card AND the caption through the share sheet.
// The file is pre-rendered (pre) so navigator.share runs straight from the tap; Safari drops the share if the tap is spent on rendering.
// Some apps (WhatsApp on iPhone) drop the text when an image rides along, so the caption also goes to the clipboard.
async function ltsdSharePhone(id, r, pre) {
  const text = ltsdShareText(id, r);
  ltsdTrack(id, 'phone');
  let f = pre;
  if (!f) { try { f = new File([await ltsdCardBlob(id, r)], ltsdFileName(id), { type: 'image/png' }); } catch (e) { f = null; } }
  // Works on iPhone (Safari) and Android (Chrome, Samsung Internet, Edge): files + text in one share. No title: some Android targets put it in place of the caption.
  if (f && navigator.canShare && navigator.canShare({ files: [f], text })) {
    const copied = ltsdCopy(text);
    try { await navigator.share({ files: [f], text }); copied.then(ok => ltsdToast(ok ? 'Shared. Caption copied too, in case the app drops it.' : 'Shared. Durban thanks you.')); return; }
    catch (e) { if (e && e.name === 'AbortError') return; }
    // the sheet refused (tap expired, or the app said no): never leave them with nothing
    if (f) ltsdDownload(f, f.name);
    ltsdToast((await copied) ? 'Card downloaded. Caption copied. Go post, ekse.' : 'Card downloaded. Post it with the link, ekse.');
    return;
  }
  // Browsers that share text but not images (Firefox on Android): download the card, then share the caption.
  if (f) { ltsdDownload(f, f.name); ltsdToast('Card downloaded. Attach it to this, ekse.'); }
  try { await navigator.share({ text }); } catch (e) {}
}
// Desktop: one click downloads the card AND copies the caption. If the clipboard refuses, returns the text for a manual field.
async function ltsdShareDesk(id, r, card) {
  const text = ltsdShareText(id, r), copying = ltsdCopy(text); // start the copy inside the click, before the canvas render
  ltsdTrack(id, card ? 'desktop' : 'link');
  let dl = false;
  if (card) { try { ltsdDownload(await ltsdCardBlob(id, r), ltsdFileName(id)); dl = true; } catch (e) {} }
  const ok = await copying;
  ltsdToast(ok ? (dl ? 'Card saved. Caption copied — paste it in the group chat.' : card ? 'Caption copied. The card got stuck. Try again, ekse.' : 'Copied — paste it in the group chat.')
    : (dl ? 'Card downloaded. Caption below. Copy it, ekse.' : 'The clipboard said no. Copy it below, ekse.'));
  return ok ? null : text;
}
// Never fail silently: when the clipboard is blocked, the caption sits here, ready to select.
function ManualCaption({ text }) {
  const ref = React.useRef(null);
  React.useEffect(() => { const t = ref.current; if (t) { t.focus({ preventScroll: true }); t.select(); } }, [text]);
  return <label className="ltsd-manual lt-in"><span className="lbl blue">The clipboard said no. It’s selected, so press copy.</span><textarea ref={ref} className="field" readOnly rows={4} value={text} onFocus={e => e.target.select()}></textarea></label>;
}

// Sits directly under the result, always.
// Every game: the result card is previewed right above the buttons (preview={false} where the game shows its own, e.g. Durdle, the quiz).
// Phones: [ Share this ] = card + caption via the share sheet · [ Save the card ] = card via the sheet (Save Image).
// Desktop: those would be the same job, so it's one [ Share this ]: card downloads + caption copies.
function ShareRow({ id, r, card = true, preview = true, children }) {
  const [busy, setBusy] = React.useState(false);
  const [manual, setManual] = React.useState(null);
  const [done, setDone] = React.useState(null); // 'share' | 'card' for two seconds after it worked
  const flip = w => { setDone(w); clearTimeout(flip.t); flip.t = setTimeout(() => setDone(null), 2000); };
  const desk = ltsdDesk(), phone = ltsdPhone();
  const key = JSON.stringify(r || {});
  // phones: render the card file ahead of the tap
  const pre = React.useRef(null);
  const [src, setSrc] = React.useState(null);
  React.useEffect(() => {
    pre.current = null; if (!card) return; let live = true, url = null;
    ltsdCardBlob(id, r).then(b => { if (!live) return; pre.current = new File([b], ltsdFileName(id), { type: 'image/png' }); if (preview) { url = URL.createObjectURL(b); setSrc(url); } }).catch(() => {});
    return () => { live = false; if (url) URL.revokeObjectURL(url); };
  }, [key]);
  const run = async fn => { if (busy) return; setBusy(true); setManual(null); try { await fn(); } finally { setBusy(false); } };
  const share = () => desk ? run(async () => { const m = await ltsdShareDesk(id, r, card); setManual(m); if (!m) flip('share'); }) : phone && card ? ltsdSharePhone(id, r, pre.current).then(() => flip('share')) : ltsdShareLink(id, r, 'result').then(() => flip('share'));
  const row = (
    <div className="ltsd-share">
      <button type="button" className={'btn primary' + (done === 'share' ? ' ltsd-ok' : '')} onClick={share} aria-busy={busy} aria-live="polite">{busy && desk ? 'Printing the card…' : done === 'share' ? (desk && card ? '✓ Card saved · caption copied' : '✓ Copied') : '[ Share this ]'}</button>
      {card && !desk && <button type="button" className={'btn line' + (done === 'card' ? ' ltsd-ok' : '')} onClick={() => (phone && pre.current ? ltsdShareCard(id, r, pre.current) : run(() => ltsdShareCard(id, r))).then(() => flip('card'))} aria-busy={busy}>{busy ? 'Printing the card…' : done === 'card' ? '✓ Card saved' : '[ Save the card ]'}</button>}
      {children}
      {manual && <ManualCaption text={manual} />}
    </div>
  );
  if (!card || !preview) return row;
  return <div className="ltsd-art ltsd-pv">{src ? <img className="dd-card ltsd-card" src={src} alt={ltsdGame(id).t + ' result card'} /> : <span className="dd-card ltsd-card ltsd-card-wait" aria-hidden="true"></span>}{row}</div>;
}
// Intro screens: share before playing. No card yet, so desktop just copies the challenge.
function ChallengeBtn({ id }) {
  const [manual, setManual] = React.useState(null);
  const [ok, setOk] = React.useState(false);
  const go = async () => { setManual(null); let m = null; if (ltsdDesk()) m = await ltsdShareDesk(id, null, false); else await ltsdShareLink(id, null, 'challenge'); setManual(m); if (!m) { setOk(true); clearTimeout(go.t); go.t = setTimeout(() => setOk(false), 2000); } };
  return <span className="ltsd-chal-w"><button type="button" className={'btn line sm ltsd-chal' + (ok ? ' ltsd-ok' : '')} onClick={go} aria-live="polite">{ok ? '✓ Challenge copied' : 'Challenge someone'}</button>{manual && <ManualCaption text={manual} />}</span>;
}

Object.assign(window, { ltsdEvent, LTSD_URL, LTSD_DOMAIN, ltsdCaption, LTSD_TAGS, ltsdGame, ltsdLink, ltsdCompose, ltsdDailyNo, ltsdShareText, ltsdTrack, ltsdCopy, ltsdToast, ltsdShareLink, ltsdSigner, ltsdResultCard, ltsdShareCard, ltsdShareDesk, ltsdSharePhone, ltsdFileName, ShareRow, ChallengeBtn, ManualCaption });
