const GD_COURSE = [
  { k: 'dict', t: 'The Dictionary', m: 'Printable · 52 entries', d: 'Every word, every example line. Print it for the flight.', btn: 'Print it', href: '#dictionary', print: true },
  { k: 'radio', t: 'Radio lessons', m: 'MP3 · ' + Object.keys(window.LSD_AUDIO || {}).length + ' clips', d: 'Every word said properly, by locals. For the flight in.', btn: 'Download · zip' },
  { k: 'flash', t: 'Flashcards', m: '50 cards', d: 'Flip, guess, be honest. Test the person in seat 14B.', btn: 'Open', href: '#flashcards' },
  { k: 'ja', t: 'Ja / No Laka', m: 'The true-false game', d: 'No laka still means yes at altitude.', btn: 'Play', href: '#activities/game-03' },
  { k: 'n3', t: 'The N3 Syllabus', m: 'Printable · A4', d: 'Learn by landmark, Joburg to the tollgate arches. Passenger seat only.', btn: 'Print', href: '#study/n3' },
