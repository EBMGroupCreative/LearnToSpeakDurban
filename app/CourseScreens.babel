// Site-wide fork counter: 37 + every fork confiscated in Fork Patrol (persisted in localStorage).
const forksTotal = n => (37 + (+n || 0)).toLocaleString('en-US');
// One study pack: everything for the flight and the drive. Download all, or one by one. Everything stays openable either way.
const PACKS2 = [
  { id: 'PACK-01', to: 'dictionary', name: 'The Dictionary', fmt: 'PDF · 50 entries', mb: 2.1, d: 'Every lesson, every example line. Printable. Works at 10,000 metres.' },
  { id: 'PACK-02', to: 'lessons/01', name: 'Radio lessons', fmt: 'MP3 · 50 tracks', mb: 46.2, d: 'Hear each word said properly. Recommended for the flight in.' },
  { id: 'PACK-03', to: 'flashcards', name: 'Flashcards', fmt: 'PDF · 50 cards', mb: 1.4, d: 'Cut along the dotted line. Test the person in seat 14B.' },
  { id: 'PACK-04', to: 'exam', name: 'Final exam, offline', fmt: 'App data', mb: 0.3, d: 'Write the exam in flight mode. It hands itself in when you land.' },
  { id: 'PACK-05', to: 'activities/game-03', name: 'Ja / No Laka', fmt: 'App data', mb: 0.8, d: 'The true-false game, offline. No laka still means yes at altitude.' },
  { id: 'PACK-06', to: 'study/n3', open: 'Pack the route', name: 'The N3 Syllabus', fmt: 'Printable · A4', mb: 0.6, d: 'Learn by landmark. A study plan keyed to the drive: Joburg to Heidelberg, lessons 1–6. Vaal River: lesson 17, obviously. Harrismith: halfway, 22 words, pie break. Van Reenen’s Pass: revise. The tollgate arches: fluent, welcome home.' },
  { id: 'PACK-07', files: 'stickers', dlLabel: 'Download the pack', name: 'WhatsApp stickers', fmt: 'WebP · 512 × 512 · 50', mb: 1.1, d: 'All 50 words, selected, as stickers. Two packs, because WhatsApp stops at 30. Your auntie will take it from here.' },
  { id: 'PACK-08', files: 'teams', dlLabel: 'Download all', name: 'Teams backgrounds', fmt: 'PNG · 4K · 3840 × 2160 · 24', mb: 96, d: 'For your last meetings before leave. Look checked out, beautifully.' },
  { id: 'PACK-09', files: 'walls', dlLabel: 'Download all 100', name: 'Wallpapers', fmt: 'PNG · 1290 × 2796 · 100', mb: 160, d: 'All 50 words for your lock screen, each in orange or the reverse. Pick the ones you want, or take the lot. Fluency by osmosis.' },
  { id: 'PACK-10', to: 'study/aunties/print', open: 'Print the deck', name: 'Aunties Against Everyone', fmt: 'Printable · A4 · 291 cards', mb: 3.4, d: 'The home edition. Fill the gap, worst answer wins, the auntie’s decision is final and unfair. Print, cut, argue. Or play it against three students on the Games page.' },
  { id: 'PACK-11', link: 'playlist', open: 'Press play', name: 'The road trip playlist', fmt: 'Playlist', d: 'Gqom and yano for the N3. Six hours of it. By Harrismith you’ll stop asking “are we there yet.”' },
];
// PRODUCTION — real Spotify and Apple Music playlist links.
const PLAYLIST_URL = 'https://open.spotify.com/playlist/4lbjRGukzSVUvbZq91tbI6';
const APPLE_MUSIC_URL = 'https://music.apple.com/za/playlist/learn-to-speak-durban/pl.u-AkAmPlyUlVNPMX5';
const PACKS_DL = PACKS2.filter(p => !p.link);
// Goodies page order: what only exists here first, then the course packaged to take away.
const PK_FUN = ['PACK-09', 'PACK-07', 'PACK-08', 'PACK-10', 'PACK-11'];
const PK_COURSE = ['PACK-01', 'PACK-02', 'PACK-03', 'PACK-04', 'PACK-06', 'PACK-05'];

function StudyScreen({ sub }) {
  if (sub === 'n3') return <N3Sheet />;
  if (sub === 'aunties' || sub === 'nolaka' || sub === 'padkos') return <NoLakaSheets />;
  if (sub === 'office') return <OfficeSheets part={location.hash.split('/')[2]} />;
  return <StudyHub />;
}

// ---- GOODIES (#study). Two grids, one card anatomy (same as the game cards): preview wash, title, one line, one button.
// No download-manager fiction: the browser manages downloads. Multi-file sets download as one zip; choosers let you take only some.
const gdSlug = s => ltsdSlug(s) || 'x';
// Chooser sets. Each item: label, grp (filter chip), w × h (full size), render(k) → canvas at k × full size, path (file name in the zip).
function gdSet(kind, logo) {
  const ex = g => EXILE.filter(x => x.g === g);
  const exItem = (x, grp, dir) => ({ label: x.name, grp, w: x.w, h: x.h, light: true, render: k => exRender(x, logo, k), path: dir + 'ltsd-' + x.id + '-' + x.w + 'x' + x.h + '.png' });
  if (kind === 'walls') return [
    ...DL_WALLS.map(([w, tn]) => ({ label: w + (tn === 'paper' ? ' · reverse' : ' · orange'), grp: tn === 'paper' ? 'Lock · reverse' : 'Lock · orange', w: 1440, h: 3120, light: tn === 'paper', render: k => dlWall(w, tn, DL_WALL_S * k), path: 'phone-' + tn + '/ltsd-wallpaper-' + gdSlug(w) + '-' + tn + '.png' })),
    ...DL_WALL_WORDS.map(w => exItem(exHomeItem(w), 'Home screen', 'phone-home/')),
    ...ex('lock').map(x => exItem(x, 'Slogans · phone', 'phone-slogans/')), ...ex('deskslogan').map(x => exItem(x, 'Slogans · desktop', 'desktop/')), ...ex('desk').map(x => exItem(x, 'Desktop', 'desktop/')),
  ];
  if (kind === 'covers') return [...ex('covers').map(x => exItem(x, 'Classics', '')), ...DL_WALL_WORDS.flatMap(w => [exItem(exFavItem(w, 'x'), 'Your word · X', 'x/'), exItem(exFavItem(w, 'fb'), 'Your word · Facebook', 'facebook/')])];
  if (kind === 'meet') return [...DL_TEAMS.map(([k, n, l]) => ({ label: l, grp: '4K', w: 3840, h: 2160, render: s => dlTeams(k, logo, DL_TEAMS_S * s), path: 'ltsd-teams-' + n + '.png' })), ...ex('meet').map(x => exItem(x, 'Classic', ''))];
  return [];
}
const GD_ZIP = { walls: 'LTSD-wallpapers.zip', covers: 'LTSD-profile-covers.zip', meet: 'LTSD-meeting-backgrounds.zip' };
async function gdDownload(kind, items) {
  await dlFonts(); if (!items.length) return;
  if (items.length === 1) { const it = items[0]; return dlSaveBlob(await dlBlob(it.render(1), 'image/png'), it.path.split('/').pop()); }
  const files = []; for (const it of items) files.push([it.path, await dlBlob(it.render(1), 'image/png')]); // one at a time: full-size canvases are big
  return dlZip(files, GD_ZIP[kind]);
}
// Syllabus.ics: a word a day, generated on the spot. 50 all-day events in syllabus order starting TOMORROW, then "Final exam." on day 51.
// Title = the word with its full stop. Description = (pos) — definition, the locked E.g. line in quotes, the site. Reminder 08:00.
// Declares its own calendar name + colour (X-WR-CALNAME, RFC 7986 NAME/COLOR). Apps that ignore them use the person's default; that's fine.
const icsEsc = s => String(s).replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\r?\n/g, '\\n');
const icsFold = line => { const enc = new TextEncoder(); if (enc.encode(line).length <= 75) return line; const out = []; let cur = '', n = 0; for (const ch of line) { const b = enc.encode(ch).length; if (n + b > (out.length ? 74 : 75)) { out.push(cur); cur = ''; n = 0; } cur += ch; n += b; } out.push(cur); return out.join('\r\n '); };
const icsDate = d => d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate());
function gdSyllabusIcs() {
  const L = window.LSD2.lessons, now = new Date(), stamp = now.toISOString().replace(/[-:]/g, '').replace(/\.\d+/, '');
  const day = i => new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1 + i);
  const ev = (i, title, desc, uid) => ['BEGIN:VEVENT', 'UID:' + uid + '-' + icsDate(day(0)) + '@learntospeakdurban.com', 'DTSTAMP:' + stamp, 'DTSTART;VALUE=DATE:' + icsDate(day(i)), 'DTEND;VALUE=DATE:' + icsDate(day(i + 1)), 'SUMMARY:' + icsEsc(title), 'DESCRIPTION:' + icsEsc(desc), 'TRANSP:TRANSPARENT', 'COLOR:orange', 'BEGIN:VALARM', 'ACTION:DISPLAY', 'TRIGGER;RELATED=START:PT8H', 'DESCRIPTION:' + icsEsc(title), 'END:VALARM', 'END:VEVENT'];
  const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Gateway//Learn to Speak Durban//EN', 'CALSCALE:GREGORIAN', 'METHOD:PUBLISH', 'X-WR-CALNAME:Learn to Speak Durban', 'NAME:Learn to Speak Durban', 'COLOR:orange', 'X-APPLE-CALENDAR-COLOR:#E8571E',
    ...L.flatMap((l, i) => ev(i, l.w.replace(/[.!?]$/, '') + (/[!?]$/.test(l.w) ? l.w.slice(-1) : '.'), '(' + l.p + ') — ' + l.d + (l.e ? '\n“' + l.e + '”' : '') + '\n' + LTSD_DOMAIN, 'ltsd-' + l.n)),
    ...ev(L.length, 'Final exam.', 'You’re ready, ekse. ' + LTSD_DOMAIN, 'ltsd-exam'), 'END:VCALENDAR', ''];
  dlSaveBlob(new Blob([lines.map(icsFold).join('\r\n')], { type: 'text/calendar;charset=utf-8' }), 'Syllabus.ics');
}
// Radio lessons: the real pronunciation clips, one zip.
async function gdAudioZip() {
  const A = window.LSD_AUDIO || {}, files = [];
  for (const [slug, f] of Object.entries(A)) { try { const r = await fetch(LSD_RES(window.LSD_ASSETS + f)); if (r.ok) files.push(['ltsd-' + slug + '.mp3', await r.blob()]); } catch (e) {} }
  if (!files.length) { ltsdToast('The radio is off air. Try again in a minute.'); return; }
  await dlZip(files, 'LTSD-radio-lessons.zip');
}
function GoodiesPicker({ kind, title, head, logo, onClose }) {
  const items = React.useMemo(() => gdSet(kind, logo), [kind, logo]);
  const grps = [...new Set(items.map(x => x.grp))];
  const [thumbs, setThumbs] = React.useState([]);
  const [pick, setPick] = React.useState([]);
  const [g, setG] = React.useState('all');
  const [busy, setBusy] = React.useState(false);
  const [q, setQ] = React.useState('');
  React.useEffect(() => { let live = true, i = 0; const out = []; const step = () => { if (!live) return; const end = Math.min(items.length, i + 4); for (; i < end; i++) { const it = items[i]; out[i] = it.render(Math.min(240 / it.w, 240 / it.h)).toDataURL('image/jpeg', 0.85); } setThumbs([...out]); if (i < items.length) setTimeout(step, 16); }; dlFonts().then(() => setTimeout(step, 0)); return () => { live = false; }; }, [items]);
  React.useEffect(() => { const k = e => { if (e.key === 'Escape') onClose(); }; addEventListener('keydown', k); document.documentElement.classList.add('ct-open'); return () => { removeEventListener('keydown', k); document.documentElement.classList.remove('ct-open'); }; }, []);
  const qq = q.trim().toLowerCase();
  const shown = items.map((x, i) => i).filter(i => (g === 'all' || items[i].grp === g) && (!qq || items[i].label.toLowerCase().includes(qq)));
  const tog = i => setPick(p => p.includes(i) ? p.filter(x => x !== i) : [...p, i].sort((a, b) => a - b));
  const allOn = shown.length && shown.every(i => pick.includes(i));
  const go = async idx => { if (busy || !idx.length) return; setBusy(true); try { await gdDownload(kind, idx.map(i => items[i])); ltsdToast(idx.length === 1 ? 'Downloaded. Check your downloads folder.' : idx.length + ' in one zip. Check your downloads folder.'); } finally { setBusy(false); } };
  return ReactDOM.createPortal(
    <div className="scrim" onClick={onClose}>
      <div className="dlp" role="dialog" aria-modal="true" aria-label={'Choose ' + title} onClick={e => e.stopPropagation()}>
        <div className="dlp-top">
          <div className="between lbl"><span className="blue">{title + ' · ' + items.length}</span><button type="button" className="chip" style={{ padding: '6px 12px', fontSize: 13 }} onClick={onClose}>Close</button></div>
          <div className="hl" style={{ fontSize: 'clamp(30px, 3vw, 44px)' }}>{head}</div>
          <div className="dlp-bar">
            <input className="field dlp-q" type="search" value={q} onChange={e => setQ(e.target.value)} placeholder="Find a word" aria-label="Find a word" />
            {grps.length > 1 && <div className="row" style={{ gap: 6 }}>{[['all', 'All'], ...grps.map(x => [x, x])].map(([k, l]) => <button key={k} type="button" className={'chip' + (g === k ? ' on' : '')} onClick={() => setG(k)}>{l}</button>)}</div>}
            <button type="button" className="btn line sm" onClick={() => setPick(p => allOn ? p.filter(i => !shown.includes(i)) : [...new Set([...p, ...shown])].sort((a, b) => a - b))}>{allOn ? 'Clear these' : 'Select all these'}</button>
            <button type="button" className="btn primary sm" disabled={!pick.length || busy} onClick={() => go(pick)}>{busy ? 'Packing…' : pick.length ? '[ Download ' + pick.length + ' ]' : 'Tap to choose'}</button>
          </div>
        </div>
        {kind === 'walls' && <span className="lbl muted dlp-note">Set it as both lock and home screen. Choose ‘fill’ if your phone asks.</span>}
        <div className="dlp-grid gd-grid">{!shown.length && <span className="lbl muted">No such word. Yet. Submit it.</span>}{shown.map(i => { const ph = items[i].h / items[i].w > 2; const img = thumbs[i] ? <img src={thumbs[i]} alt="" style={{ aspectRatio: items[i].w + '/' + items[i].h }} /> : <span className="dlp-wait" style={{ aspectRatio: items[i].w + '/' + items[i].h }}></span>; return <button key={i} type="button" className={'dlp-i' + (pick.includes(i) ? ' on' : '')} aria-pressed={pick.includes(i)} onClick={() => tog(i)}>{ph ? <span className="dlp-phone">{img}<b className={'dlp-clock' + (items[i].light ? ' ink' : '')}>9:41</b></span> : img}<MetaFit className="dlp-l" text={items[i].label} min={9} /><i aria-hidden="true">✓</i></button>; })}</div>
      </div>
    </div>, document.body
  );
}
function useGdThumbs() {
  const [t, setT] = React.useState(null), [logo, setLogo] = React.useState(null);
  React.useEffect(() => {
    let live = true; const im = new Image();
    const go = ok => dlFonts().then(() => { if (!live) return; const lg = ok ? im : null; setLogo(lg); const j = c => c.toDataURL('image/jpeg', 0.88);
      const cov = EXILE.find(x => x.id === 'x-wall'), lock = EXILE.find(x => x.id === 'lock-braai');
      setT({ walls: [j(dlWall('Aweh', 'orange', 0.12)), j(dlWall('Aweh', 'paper', 0.12)), j(exRender(lock, lg, 0.11))], covers: [j(exRender(cov, lg, 0.24))], meet: [j(dlTeams('k-camera', lg, 0.1)), j(dlTeams('mute', lg, 0.1))], stickers: ['Aweh', 'Shap shap', 'Vy'].map(w => dlSticker(w, 320).toDataURL('image/png')) }); });
    im.onload = () => go(true); im.onerror = () => go(false); im.src = LSD_RES(window.LSD_ASSETS + 'logos/gateway-logo.png');
    return () => { live = false; };
  }, []);
  return { t, logo };
}
const GD_FUN = [
  { k: 'walls', t: 'Wallpapers', m: 'Phone + desktop · ' + (DL_WALLS.length + DL_WALL_WORDS.length + EXILE.filter(x => ['lock', 'deskslogan', 'desk'].includes(x.g)).length), d: 'All 50 words for your lock screen, in orange or the reverse. Plus home screens and desktops.', choose: 'Pick your words.', btn: 'Download all · zip' },
  { k: 'meet', t: 'Meeting backgrounds', m: 'Teams + Zoom · ' + (DL_TEAMS.length + EXILE.filter(x => x.g === 'meet').length), d: 'For your last meetings before leave. Look checked out, beautifully.', choose: 'Pick your excuse.', btn: 'Download all · zip' },
  { k: 'stickers', t: 'WhatsApp stickers', m: 'Hi-res · 2048 px · 50', d: 'All 50 words as stickers, hi-res with see-through backgrounds. Your sticker app does the rest.', btn: 'Download · zip' },
  { k: 'aunties', t: 'Aunties Against Everyone', m: 'Print deck · 291 cards', d: 'The home edition. Worst answer wins. Print, cut, argue.', btn: 'Print the deck', href: '#study/aunties/print' },
  { k: 'countdown', t: 'The tear-off countdown', m: 'A4 · a page per week', d: 'One day off at a time, right next to the kettle. Colleagues will ask. Tell them.', btn: '[ Print it ]', href: '#study/office/countdown' },
  { k: 'door', t: 'The door sign & desk flag', m: 'A4 · two pages', d: 'For the notice period. Gone to chow, back shap shap. Your desk agrees.', btn: '[ Print the set ]', href: '#study/office/door' },
  { k: 'syllabus', t: 'Word-a-day calendar', m: 'Syllabus.ics · 50 days', d: 'A word a day, in your calendar. 50 days, one syllabus, no excuses. Starts tomorrow.', btn: '[ Add to calendar ]' },
  { k: 'playlist', t: 'The road trip playlist', m: 'Six hours of N3', d: 'Gqom and yano for the drive. By Harrismith you’ll stop asking “are we there yet.”' },
