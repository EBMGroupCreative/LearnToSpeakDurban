// Site-wide fork counter: 37 + every fork confiscated in Fork Patrol (persisted in localStorage).
const forksTotal = n => (37 + (+n || 0)).toLocaleString('en-US');
// One study pack: everything for the flight and the drive. Download all, or one by one. Everything stays openable either way.
const PACKS2 = [
  { id: 'PACK-01', to: 'dictionary', name: 'The Dictionary', fmt: 'PDF · 50 entries', mb: 2.1, d: 'Every lesson, every example line. Printable. Works at 10,000 metres.' },
  { id: 'PACK-02', to: 'lessons/01', name: 'Radio lessons', fmt: 'MP3 · 50 tracks', mb: 46.2, d: 'Hear each word said properly. Recommended for the flight in.' },
  { id: 'PACK-03', to: 'flashcards', name: 'Flashcards', fmt: 'PDF · 50 cards', mb: 1.4, d: 'Cut along the dotted line. Test the person in seat 14B.' },
  { id: 'PACK-04', to: 'exam', name: 'Final exam, offline', fmt: 'App data', mb: 0.3, d: 'Write the exam in flight mode. It hands itself in when you land.' },
  { id: 'PACK-05', to: 'activities/game-03', name: 'Ja / No Laka', fmt: 'App data', mb: 0.8, d: 'The true-false game, offline. No laka still means yes at altitude.' },
  { id: 'PACK-06', to: 'study/n3', open: 'Pack the route', name: 'The N3 Syllabus', fmt: 'Printable · A4', mb: 0.6, d: 'Learn by landmark. A study plan keyed to the drive: Joburg to Heidelberg, lessons 1–6. Vaal River: lesson 17, obviously. Harrismith: halfway, 22 words, pie break. Van Reenen’s Pass: revise. The tollgate arches: fluent, welcome home.' },
  { id: 'PACK-07', files: 'stickers', dlLabel: 'Download stickers', name: 'WhatsApp stickers', fmt: 'WebP · 512 × 512 · 50', mb: 1.1, d: 'All 50 words, selected, as stickers. Two packs, because WhatsApp stops at 30. Your auntie will take it from here.' },
  { id: 'PACK-08', files: 'teams', dlLabel: 'Download backgrounds', name: 'Teams backgrounds', fmt: 'PNG · 1920 × 1080 · 3', mb: 4.8, d: 'For your last meetings before leave. Look checked out, beautifully.' },
  { id: 'PACK-09', files: 'walls', dlLabel: 'Download wallpapers', name: 'Wallpapers', fmt: 'PNG · 1080 × 1920 · 6', mb: 6.2, d: 'A word a day on your lock screen. Fluency by osmosis.' },
  { id: 'PACK-10', to: 'study/aunties/print', open: 'Print the deck', name: 'Aunties Against Everyone', fmt: 'Printable · A4 · 291 cards', mb: 3.4, d: 'The home edition. Fill the gap, worst answer wins, the auntie’s decision is final and unfair. Print, cut, argue. Or play it against three students on the Games page.' },
  { id: 'PACK-11', link: 'playlist', open: 'Press play', name: 'The road trip playlist', fmt: 'Playlist', d: 'Gqom and yano for the N3. Six hours of it. By Harrismith you’ll stop asking “are we there yet.”' },
];
// PRODUCTION — real Spotify and Apple Music playlist links.
const PLAYLIST_URL = 'https://open.spotify.com/playlist/4lbjRGukzSVUvbZq91tbI6';
const APPLE_MUSIC_URL = 'https://music.apple.com/za/playlist/learn-to-speak-durban/pl.u-AkAmPlyUlVNPMX5';
const PACKS_DL = PACKS2.filter(p => !p.link);

function StudyScreen({ sub }) {
  if (sub === 'n3') return <N3Sheet />;
  if (sub === 'aunties' || sub === 'nolaka' || sub === 'padkos') return <NoLakaSheets />;
  if (sub === 'office') return <OfficeSheets />;
  return <StudyHub />;
}

function StudyHub() {
  const [saved, setSaved] = useStored('lsd2-packs', []);
  const [prog, setProg] = React.useState({});
  const [note, setNote] = React.useState(null);
  const { logo, thumbs } = useDlThumbs();
  const dl = p => new Promise(res => {
    if (p.link || prog[p.id] !== undefined) return res();
    let v = 0; setProg(x => ({ ...x, [p.id]: 0 }));
    const t = setInterval(() => { v = Math.min(1, v + 0.06 + Math.random() * 0.1); setProg(x => ({ ...x, [p.id]: v })); if (v >= 1) { clearInterval(t); setSaved(s => s.includes(p.id) ? s : [...s, p.id]); setProg(x => { const n = { ...x }; delete n[p.id]; return n; }); (p.files ? dlFiles(p.files, logo) : Promise.resolve()).then(res); } }, 120);
  });
  const dlAll = async () => { const todo = PACKS_DL.filter(p => !saved.includes(p.id)); todo.filter(p => !p.files).forEach(dl); for (const p of todo.filter(p => p.files)) await dl(p); setNote('Everything downloaded. Flight mode or N3 mode: you’re covered.'); };
  const all = PACKS_DL.every(p => saved.includes(p.id));
  const n = PACKS_DL.filter(p => saved.includes(p.id)).length;
  const total = PACKS_DL.reduce((s, p) => s + p.mb, 0).toFixed(1);
  return (
    <div>
      <PageHead index="08" kicker="Works offline" title="Study pack">
        <p className="lead" style={{ margin: 0 }}>For when you’re flying in. Download the course before take-off. The lessons work in flight mode. The ocean does not.</p>
      </PageHead>
      <div className="card study-top">
        <div>
          <div className="hl" style={{ fontSize: 'clamp(32px, 3vw, 48px)' }}>{all ? <>Ready for flight <Sel>mode.</Sel></> : 'Save the whole course for the flight. Or the drive.'}</div>
          <div className="lbl muted" style={{ marginTop: 10 }}>{pad2(n)} / {pad2(PACKS_DL.length)} downloaded · {total} MB total · everything opens without downloading too</div>
          {note && <div className="lbl blue" style={{ marginTop: 8 }}>{note}</div>}
        </div>
        <div className="row">
          {!all ? <button type="button" className="btn primary" onClick={dlAll}>[ Download all ]</button> : <button type="button" className="btn primary" onClick={async () => { setSaved([]); setNote(null); for (const p of PACKS_DL.filter(p => !p.files)) dl(p); for (const p of PACKS_DL.filter(p => p.files)) await dl(p); setNote('All of it again. Fresh copies. Same baggies.'); }}>[ Download all again ]</button>}
          {saved.length > 0 && <button type="button" className="btn line sm" onClick={() => { setSaved([]); setNote(null); }}>Clear downloads</button>}
        </div>
      </div>
      <div className="packs">
        {PACKS2.map(p => {
          const done = saved.includes(p.id), v = prog[p.id];
          const openBtn = p.link === 'playlist' ? <><a className="btn line sm" href={PLAYLIST_URL} target="_blank" rel="noopener">Spotify</a><a className="btn line sm" href={APPLE_MUSIC_URL} target="_blank" rel="noopener">Apple Music</a></>
            : p.to ? <a className="btn line sm" href={'#' + p.to}>{p.open || 'Open'}</a> : null;
          return (
            <div key={p.id} className="card pack-c">
              <div className="between lbl"><span className="blue">{p.id}</span><span className="muted">{p.fmt}</span></div>
              <div className="hl" style={{ fontSize: 34 }}>{done ? <Sel>{p.name}</Sel> : p.name}</div>
              <p>{p.d}</p>
              {p.files && <span className="lbl muted">Tap one to download it on its own.</span>}
              {p.files && <div className={'dl-thumbs ' + p.files}>{thumbs ? thumbs[p.files].map((u, i) => <button key={i} type="button" className="dl-one" title="Download this one" onClick={() => { dlOne(p.files, i, logo); setNote(p.files === 'stickers' ? 'One sticker. Download stickers for all 50, zipped, in two packs.' : 'Downloading one. Tap the others for more, or Download for the lot.'); }}><img src={u} alt={(p.files === 'teams' ? ['Beachfront', 'Gateway', 'On leave soon, ekse'][i] + ' background' : p.files === 'stickers' ? window.LSD2.lessons[i].w + ' sticker' : DL_WALL_WORDS[i] + ' wallpaper') + ', download'} /></button>) : (p.files === 'teams' ? [0, 1, 2] : p.files === 'stickers' ? window.LSD2.lessons.map(l => l.n) : DL_WALL_WORDS).map(i => <span key={i}></span>)}</div>}
              {v !== undefined && <div className="bar" style={{ marginTop: 0 }}><i style={{ width: (v * 100) + '%' }}></i></div>}
              <div className="between" style={{ marginTop: 'auto', flexWrap: 'wrap' }}>
                {p.link ? <span className="lbl muted">{p.link === 'playlist' ? 'Press play on' : 'Link'}</span> : done ? <span className="lbl blue">Downloaded</span> : <span className="lbl muted">{p.mb} MB</span>}
                <div className="row" style={{ gap: 8 }}>
                  {openBtn}
                  {!p.link && (done ? <><button type="button" className="btn soft sm" disabled={v !== undefined} onClick={() => { setSaved(s => s.filter(x => x !== p.id)); dl(p); }}>{v !== undefined ? Math.round(v * 100) + '%' : 'Download again'}</button><button type="button" className="btn line sm" onClick={() => setSaved(s => s.filter(x => x !== p.id))}>Remove</button></>
                    : <button type="button" className="btn soft sm" disabled={v !== undefined} onClick={() => dl(p)}>{v !== undefined ? Math.round(v * 100) + '%' : p.dlLabel || 'Download'}</button>)}
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <ExileKit />
      <div className="lbl muted" style={{ marginTop: 28 }}>Seatbelt sign: on · Wi-Fi: optional · Fluency: continuing</div>
    </div>
  );
}

function SubmitScreen() {
  const blank = { word: '', where: '', meaning: '', example: '', name: '', email: '', real: false };
  const [f, setF] = React.useState(blank);
  const [err, setErr] = React.useState({});
  const [done, setDone] = React.useState(null);
  const set = k => e => { const v = k === 'real' ? e.target.checked : e.target.value; setF(x => ({ ...x, [k]: v })); if (err[k]) setErr(x => ({ ...x, [k]: null })); };
  const submit = e => {
    e.preventDefault(); const x = {};
    if (!f.word.trim()) x.word = 'A word is required. It is in the name.';
    if (!f.where.trim()) x.where = 'Gateway needs a crime scene.';
    if (!f.meaning.trim()) x.meaning = 'Explain yourself.';
    if (!f.example.trim()) x.example = 'One sentence. You can do it.';
    if (!f.name.trim()) x.name = 'For the credits. Required.';
    if (!f.email.trim()) x.email = 'Gateway needs this.'; else if (!/^\S+@\S+\.\S+$/.test(f.email)) x.email = 'That looks like a vaalie typed it.';
    if (!f.real) x.real = 'Gateway checks.';
    // Submit a word is Mode B (strict). Entries are never displayed publicly; they are stored for review only.
    // PRODUCTION: route all free text through a server-side moderation API (e.g. OpenAI Moderation / Azure AI Content Safety) PLUS this custom SA wordlist before rendering. Client-side filtering is a placeholder and must not ship as the only defence. Shareable text and Submit a word entries should also be human-reviewed where feasible.
    ['word', 'where', 'meaning', 'example', 'name', 'email'].forEach(q => { if (f[q] && lsdBlocked(f[q])) x[q] = 'Not that word, bru.'; });
    setErr(x); if (Object.keys(x).length) return;
    try { const q = JSON.parse(localStorage.getItem('lsd2-submissions') || '[]'); q.push({ ...f, at: new Date().toISOString(), status: 'pending review' }); localStorage.setItem('lsd2-submissions', JSON.stringify(q)); } catch (e2) {}
    setDone({ ref: 'LTSD-SUB-' + String(300 + Math.floor(Math.random() * 700)).padStart(4, '0'), word: f.word.trim() });
  };
  const F = (k, label, ph, multi) => (
    <label className="ctl"><span className={'lbl ' + (err[k] ? 'blue' : 'muted')}>{label}{err[k] ? ' · ' + err[k] : ''}</span>
      {multi ? <textarea className="field" rows={multi} value={f[k]} onChange={set(k)} placeholder={ph} style={{ resize: 'vertical' }}></textarea> : <input className="field" type={k === 'email' ? 'email' : 'text'} value={f[k]} onChange={set(k)} placeholder={ph} />}
    </label>
  );
  const steps = [['Filed', 'With a submission number.'], ['Gateway checks', 'By Gateway, to Gateway.'], ['Field-tested', 'Said to a lifeguard. Reaction noted.'], ['Added to the Dictionary', 'Or returned with a polite note.']];
  return (
    <div>
      <PageHead index="09" kicker="Form W-05 · Review: 4 steps" title="Submit a word">
        <p className="lead" style={{ margin: 0 }}>The dictionary holds 50 words. The coast holds more. Send yours to Gateway for review.</p>
      </PageHead>
      <div className="sub">
        {done ? (
          <div className="card sub-form" style={{ justifyContent: 'center' }}>
            <span className="lbl blue">{done.ref}</span>
            <div className="hl" style={{ fontSize: 'clamp(48px, 6vw, 96px)' }}><Sel>{done.word}</Sel></div>
            <div className="hl" style={{ fontSize: 40 }}>Filed for review.</div>
            <p className="lead" style={{ margin: 0 }}>If it checks out, the intern files it. Eventually.</p>
            <div className="row"><button type="button" className="btn primary" onClick={() => { setF(blank); setDone(null); }}>Submit another</button><a className="btn line" href="#dictionary">Back to the Dictionary</a></div>
          </div>
        ) : (
          <form className="card sub-form" onSubmit={submit} noValidate>
            <div className="g2">{F('word', 'The word', 'One word or phrase')}{F('where', 'Where you heard it', 'e.g. North Beach, the taxi rank, my gran')}</div>
            {F('meaning', 'What it means', 'Explain it like you would to a vaalie.', 3)}
            {F('example', 'Use it in a sentence', 'Say it like a local would.', 2)}
            <div className="g2">{F('name', 'Your name', 'For the credits')}{F('email', 'Email address', 'you@example.co.za')}</div>
            <label className={'tick' + (err.real ? ' err' : '')}><input type="checkbox" checked={f.real} onChange={set('real')} /><span>I confirm this word is real and someone in Durban actually says it.{err.real && <b className="blue"> {err.real}</b>}</span></label>
            <div className="between" style={{ flexWrap: 'wrap' }}><span className="lbl muted">Every field is required. One word per form. If it checks out, the intern files it. Eventually.</span><div className="row"><button type="button" className="btn line sm" onClick={() => { setF(blank); setErr({}); }}>Clear</button><button type="submit" className="btn primary">[ Send to Gateway ]</button></div></div>
          </form>
        )}
        <div className="sub-steps">
          <span className="lbl muted">What happens next</span>
          {steps.map(([t, d], i) => <div key={t} className="card step"><span className="lbl blue">{pad2(i + 1)}</span><div><b>{t}</b><div className="muted">{d}</div></div></div>)}
        </div>
      </div>
    </div>
  );
}

Object.assign(window, { StudyScreen, SubmitScreen });
