function GdPreview({ k, t }) {
  const im = (src, cls) => src ? <img className={cls} src={src} alt="" draggable="false" /> : <span className={cls + ' gd-wait'}></span>;
  if (k === 'walls') return <div className="gd-pv">{[0, 1, 2].map(i => <React.Fragment key={i}>{im(t && t.walls[i], 'gd-ph')}</React.Fragment>)}</div>;
  if (k === 'covers') return <div className="gd-pv">{im(t && t.covers[0], 'gd-cv')}</div>;
  if (k === 'meet') return <div className="gd-pv">{[0, 1].map(i => <React.Fragment key={i}>{im(t && t.meet[i], 'gd-tm')}</React.Fragment>)}</div>;
  if (k === 'stickers') return <div className="gd-pv">{[0, 1, 2].map(i => <React.Fragment key={i}>{im(t && t.stickers[i], 'gd-st')}</React.Fragment>)}</div>;
  if (k === 'aunties') return <div className="gv"><span className="gv-aa p">The auntie saw <i></i> and said “no laka.”</span><span className="gv-aa a">Socks with slops</span></div>;
  if (k === 'sig') return <div className="gd-pv"><div className="gd-sig">{gdSigLines().map((l, i) => <div key={i}>{i === 3 ? <>Vy date: <Sel handles={false}>15 Dezemba.</Sel></> : l}</div>)}</div></div>;
  if (k === 'countdown') { const now = lsdNow(), y = now.getMonth() === 11 ? now.getFullYear() + 1 : now.getFullYear(), n = Math.max(0, Math.ceil((new Date(y, 11, 1) - now) / 864e5)); return <div className="gd-pv gd-ty"><span className="hl gd-big">{n}</span><span className="lbl blue">Days until Dezemba · tear one off</span></div>; }
  if (k === 'door') return <div className="gd-pv gd-ty"><span className="hl">Gone to <Sel handles={false}>chow.</Sel></span><span className="lbl blue">Back shap shap</span></div>;
  if (k === 'syllabus') { const L = window.LSD2.lessons, t1 = lsdNow(); t1.setDate(t1.getDate() + 1); const y = t1.getFullYear(), m = t1.getMonth(), first = (new Date(y, m, 1).getDay() + 6) % 7, n = new Date(y, m + 1, 0).getDate(), d = t1.getDate(), all = [...Array(first).fill(0), ...Array.from({ length: n }, (_, i) => i + 1)], at = all.indexOf(d), row = Math.floor(at / 7), cells = all.slice(row * 7, row * 7 + 14);
    // Two weeks: the week Lesson 01 lands in, and the next.
    return <div className="gd-pv"><div className="gd-month"><div className="gd-mh"><b>{t1.toLocaleDateString('en-ZA', { month: 'long' })}</b><span>{y}</span></div><div className="gd-mg">{['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((x, i) => <i key={'h' + i}>{x}</i>)}{cells.map((x, i) => <span key={i} className={x === d ? 'on' : x === d + 1 ? 'nx' : ''}>{x ? <><b>{x}</b>{x === d ? <em>{L[0].w + '.'}</em> : x === d + 1 ? <em>{L[1].w + '.'}</em> : null}</> : null}</span>)}</div></div></div>; }
  if (k === 'playlist') return <div className="gd-pv"><div className="gd-mp3"><div className="gd-mp3-s"><b>Gqom. Yano.</b><span>Six hours of N3 ▸</span></div><div className="gd-mp3-w"><i></i></div></div></div>;
  if (k === 'dict') return <div className="gd-pv"><div className="gd-book"><div><b>Aweh</b><i>(interj.)</i><s></s><s></s><s className="h"></s><b>Baggies</b><i>(n.)</i><s></s><s className="h"></s></div><div><b>Bru</b><i>(n.)</i><s></s><s className="h"></s><b>Bunny</b><i>(n.)</i><s></s><s></s><s className="h"></s></div></div></div>;
  if (k === 'radio') return <div className="gd-pv"><div className="gd-tape"><span className="gd-tape-l">031FM · Side A</span><span className="gd-tape-w"><i></i><b></b><i></i></span><span className="gd-tape-n">Lessons 01–50</span></div></div>;
  if (k === 'flash') return <div className="gd-pv"><div className="gd-fan"><span className="b">cool.</span><span className="f"><Sel handles={false}>Kiff</Sel></span></div></div>;
  if (k === 'exam') return <div className="gd-pv"><div className="gd-paper"><span className="lbl">Final examination</span><b>Paper 1.</b><s></s><s></s><s className="h"></s><span className="gd-plane">✈ Flight mode</span></div></div>;
  if (k === 'ja') return <div className="gd-pv"><span className="gd-chip">Ja</span><span className="gd-chip on">No laka</span></div>;
  if (k === 'n3') return <div className="gd-pv"><div className="gd-road"><span className="gd-n3">N3</span><span>Joburg <em>→</em> <b>Durban</b></span></div></div>;
  const ty = { dict: ['A–Z', <><Sel handles={false}>Aweh</Sel> (interj.)</>], radio: ['031FM · said by locals', <>Hear <Sel handles={false}>it.</Sel></>], flash: ['Front · back', <>Kiff → <Sel handles={false}>cool.</Sel></>], exam: ['Paper 1 · 100 marks', <>Pens <Sel handles={false}>down.</Sel></>], ja: ['45 seconds', <><Sel handles={false}>No laka</Sel> = yes.</>], n3: ['KM 0 → 545', <>Harrismith: <Sel handles={false}>pie.</Sel></>] }[k];
  return <div className="gd-pv gd-ty"><span className="lbl blue">{ty[0]}</span><span className="hl">{ty[1]}</span></div>;
}
function gdSigLines() { let n = '', no = null; try { n = JSON.parse(localStorage.getItem(lsdKey('lsd2-name'))) || ''; no = JSON.parse(localStorage.getItem(lsdKey('lsd2-cardno'))); } catch (e) {} return ['— ' + ((safeText(n) || '').trim() || '[Name]') + '.', 'Student #' + (no ? String(no).slice(-5) : '04412') + ', Learn to Speak Durban.', 'Fluency: pending.', 'Vy date: 15 Dezemba.']; }
const gdCopySig = () => ltsdCopy(gdSigLines().join('\n')).then(ok => ltsdToast(ok ? 'Signature copied. Paste it under every email until January.' : 'The clipboard said no. Select it and copy, ekse.'));
function StudyHub() {
  const { t, logo } = useGdThumbs();
  const [pick, setPick] = React.useState(null); // a GD_FUN item with a chooser
  const [busy, setBusy] = React.useState(null);
  const run = async (k, fn) => { if (busy) return; setBusy(k); try { await fn(); } finally { setBusy(null); } };
  const act = g => {
    if (g.k === 'stickers') return run(g.k, async () => { await dlFonts(); await dlStickerZip(); ltsdToast('Both packs, one zip. Check your downloads folder.'); });
    if (g.k === 'radio') return run(g.k, async () => { await gdAudioZip(); });
    if (g.k === 'sig') return gdCopySig();
    if (g.k === 'syllabus') { gdSyllabusIcs(); ltsdToast('Syllabus.ics downloaded. Open it. Lesson 01 lands tomorrow at 08:00.'); return; }
    if (['walls', 'covers', 'meet'].includes(g.k)) return run(g.k, async () => { await gdDownload(g.k, gdSet(g.k, logo)); ltsdToast('All of them, one zip. Check your downloads folder.'); });
  };
  const card = g => {
    const chooser = ['walls', 'covers', 'meet'].includes(g.k);
    const btn = g.k === 'playlist' ? <><a className="btn line sm" href={PLAYLIST_URL} target="_blank" rel="noopener">Spotify</a><a className="btn line sm" href={APPLE_MUSIC_URL} target="_blank" rel="noopener">Apple Music</a></>
      : g.href ? <a className="btn line sm" href={g.href} onClick={g.print ? () => setTimeout(() => window.print(), 900) : undefined}>{g.btn}</a>
      : <button type="button" className="btn line sm" disabled={busy === g.k} onClick={e => { e.stopPropagation(); act(g); }}>{busy === g.k ? 'Packing…' : g.btn}</button>;
    return (
      <div key={g.k} className={'card game-tile gd-c' + (chooser ? ' pick' : '')} onClick={chooser ? () => setPick(g) : undefined} role={chooser ? 'button' : undefined} tabIndex={chooser ? 0 : undefined} onKeyDown={chooser ? e => { if (e.target === e.currentTarget && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); setPick(g); } } : undefined}>
        <div className="game-prev"><GdPreview k={g.k} t={t} /></div>
        <div className="game-body">
          <div className="lbl gd-meta"><MetaFit className="muted" text={g.m + (chooser ? ' · Tap to choose' : '')} /></div>
          <Fit as="h3" className="hl" lines={2} min={20}>{g.t}</Fit>
          <p>{g.d}</p>
          <div className="game-cta" onClick={e => e.stopPropagation()}>{btn}</div>
        </div>
      </div>
    );
  };
  return (
    <div>
      <PageHead index="08" kicker="Works offline" title="The Study Pack.">
        <p className="lead" style={{ margin: 0 }}>Goodies, in school language. Wallpapers, stickers, the dictionary, the radio lessons. All free.</p>
        <p className="lead" style={{ margin: 0 }}>For when you’re flying in. Download the course before take-off. The lessons work in flight mode. The ocean does not.</p>
      </PageHead>
      <section className="pk-grp">
        <h2 className="hl pk-h">The fun <Sel>stuff.</Sel></h2>
        <div className="games gd-grid-c">{GD_FUN.map(card)}</div>
      </section>
      <section className="pk-grp">
        <h2 className="hl pk-h">The course, <Sel>to go.</Sel></h2>
        <div className="games gd-grid-c">{GD_COURSE.map(card)}</div>
      </section>
      {pick && <GoodiesPicker kind={pick.k} title={pick.t} head={pick.choose} logo={logo} onClose={() => setPick(null)} />}
      <div className="lbl muted" style={{ marginTop: 28 }}>Seatbelt sign: on · Wi-Fi: optional · Fluency: continuing</div>
    </div>
  );
}

function SubmitScreen() {
  const blank = { word: '', where: '', meaning: '', example: '', name: '', email: '', real: false };
  const [f, setF] = React.useState(blank);
  const [err, setErr] = React.useState({});
  const [done, setDone] = React.useState(null);
  const form = React.useRef(null);
  const set = k => e => { const v = k === 'real' ? e.target.checked : e.target.value; setF(x => ({ ...x, [k]: v })); if (err[k]) setErr(x => ({ ...x, [k]: null })); };
  const submit = e => {
    e.preventDefault(); const x = {};
    if (!f.word.trim()) x.word = 'A word is required. It is in the name.';
    if (!f.where.trim()) x.where = 'Gateway needs a crime scene.';
    if (!f.meaning.trim()) x.meaning = 'Explain yourself.';
    if (!f.example.trim()) x.example = 'One sentence. You can do it.';
    if (!f.name.trim()) x.name = 'For the credits. Required.';
    if (!f.email.trim()) x.email = 'Gateway needs this.'; else if (!/^\S+@\S+\.\S+$/.test(f.email)) x.email = 'That looks like a vaalie typed it.';
    if (!f.real) x.real = 'Gateway checks.';
    // Submit a word is Mode B (strict). Entries are never displayed publicly; they are stored for review only.
    // PRODUCTION: route all free text through a server-side moderation API (e.g. OpenAI Moderation / Azure AI Content Safety) PLUS this custom SA wordlist before rendering. Client-side filtering is a placeholder and must not ship as the only defence. Shareable text and Submit a word entries should also be human-reviewed where feasible.
    ['where', 'meaning', 'example', 'email'].forEach(q => { if (f[q] && lsdBlocked(f[q])) x[q] = 'Not that word, bru.'; });
    // The word and the name go through the name filter (allowlisted campaign words always pass).
    ['word', 'name'].forEach(q => { if (f[q] && !ltsdNameOk(f[q])) x[q] = LTSD_NAME_NO; });
    setErr(x); if (Object.keys(x).length) { const k = ['word', 'name'].find(q => x[q] === LTSD_NAME_NO); if (k && form.current) { const el = form.current.querySelector('[name="' + k + '"]'); if (el) el.focus(); } return; }
    try { const q = JSON.parse(localStorage.getItem('lsd2-submissions') || '[]'); q.push({ ...f, at: new Date().toISOString(), status: 'pending review' }); localStorage.setItem('lsd2-submissions', JSON.stringify(q)); } catch (e2) {}
    setDone({ ref: 'LTSD-SUB-' + String(300 + Math.floor(Math.random() * 700)).padStart(4, '0'), word: f.word.trim() });
  };
  const nameish = k => k === 'word' || k === 'name';
  const F = (k, label, ph, multi) => (
    <label className="ctl"><span className={'lbl ' + (err[k] ? 'blue' : 'muted')}>{label}{err[k] ? ' · ' + err[k] : ''}</span>
      {multi ? <textarea className="field" rows={multi} value={f[k]} onChange={set(k)} placeholder={ph} style={{ resize: 'vertical' }}></textarea> : <input className="field" name={k} type={k === 'email' ? 'email' : 'text'} value={f[k]} onChange={set(k)} placeholder={ph} {...(nameish(k) ? { maxLength: LTSD_NAME_MAX, onBlur: ltsdNameBlur(k, setErr) } : {})} />}
    </label>
  );
  const steps = [['Filed', 'With a submission number.'], ['Gateway checks', 'By Gateway, to Gateway.'], ['Field-tested', 'Said to a lifeguard. Reaction noted.'], ['Added to the Dictionary', 'Or returned with a polite note.']];
  return (
    <div>
      <PageHead index="09" kicker="Form W-05 · Review: 4 steps" title="Submit a word">
        <p className="lead" style={{ margin: 0 }}>The syllabus holds 50 words. The coast holds more. Send yours to Gateway for review.</p>
      </PageHead>
      <div className="sub">
        {done ? (
          <div className="card sub-form" style={{ justifyContent: 'center' }}>
            <span className="lbl blue">{done.ref}</span>
            <div className="hl" style={{ fontSize: 'clamp(48px, 6vw, 96px)' }}><Sel>{done.word}</Sel></div>
            <div className="hl" style={{ fontSize: 40 }}>Filed for review.</div>
            <p className="lead" style={{ margin: 0 }}>If it checks out, the intern files it. Eventually.</p>
            <div className="row"><button type="button" className="btn primary" onClick={() => { setF(blank); setDone(null); }}>Submit another</button><a className="btn line" href="#dictionary">Back to the Dictionary</a></div>
          </div>
        ) : (
          <form ref={form} className="card sub-form" onSubmit={submit} noValidate>
            <div className="g2">{F('word', 'The word', 'One word or phrase')}{F('where', 'Where you heard it', 'e.g. North Beach, the taxi rank, my gran')}</div>
            {F('meaning', 'What it means', 'Explain it like you would to a vaalie.', 3)}
            {F('example', 'Use it in a sentence', 'Say it like a local would.', 2)}
            <div className="g2">{F('name', 'Your name', 'For the credits')}{F('email', 'Email address', 'you@example.co.za')}</div>
            <label className={'tick' + (err.real ? ' err' : '')}><input type="checkbox" checked={f.real} onChange={set('real')} /><span>I confirm this word is real and someone in Durban actually says it.{err.real && <b className="blue"> {err.real}</b>}</span></label>
            <div className="between" style={{ flexWrap: 'wrap' }}><span className="lbl muted">Every field is required. One word per form. If it checks out, the intern files it. Eventually.</span><div className="row"><button type="button" className="btn line sm" onClick={() => { setF(blank); setErr({}); }}>Clear</button><button type="submit" className="btn primary">[ Send to Gateway ]</button></div></div>
          </form>
        )}
        <div className="sub-steps">
          <span className="lbl muted">What happens next</span>
          {steps.map(([t, d], i) => <div key={t} className="card step"><span className="lbl blue">{pad2(i + 1)}</span><div><b>{t}</b><div className="muted">{d}</div></div></div>)}
        </div>
      </div>
    </div>
  );
}

Object.assign(window, { StudyScreen, SubmitScreen, GdPreview });
