const ROUTES = ['home', 'enrol', 'orientation', 'lessons', 'dictionary', 'activities', 'flashcards', 'ekselator', 'card', 'study', 'submit', 'kit', 'exam', 'profile', 'leaderboard', 'terms', 'report'];
// Nav labels: short and Title Case so the bar fits. Page titles keep their full names (PAGE_NAME, used by the locked screen).
const NAV = [['enrol', 'Enrol'], ['orientation', 'Orientation'], ['card', 'Student Card'], ['lessons', 'Lessons'], ['dictionary', 'Dictionary'], ['activities', 'Games'], ['leaderboard', 'Rankings'], ['flashcards', 'Flashcards'], ['ekselator', 'Ekselator'], ['kit', 'Vy Kit'], ['study', 'Goodies'], ['exam', 'Exam'], ['submit', 'Submit Word']];
const PAGE_NAME = { enrol: 'Enrol page', card: 'Student card', lessons: 'Lessons', dictionary: 'Dictionary', activities: 'Games', leaderboard: 'Class Rankings', flashcards: 'Flashcards', ekselator: 'Ekselator', study: 'Study pack', kit: 'The Vy Kit', exam: 'Final exam', submit: 'Submit a word' };
const parseRoute = () => { let [p, s] = location.hash.replace('#', '').split('/'); if (p === 'translate') p = 'ekselator'; if (p === 'games') p = 'activities'; if (p === 'contact') p = 'home'; if (p === 'merch') p = 'activities'; /* merch retired: spot prizes instead */ return { page: !p ? 'home' : ROUTES.includes(p) ? p : 'lost', sub: s }; };

// Contact: a modal, opened from the footer button, the footer quick link, the mobile menu and Report something dodgy. ltsdContact('dodgy') pre-selects a topic. #contact or #contact/dodgy opens it on load.
const CONTACT_TOPICS = [['general', 'General'], ['prizes', 'Spot prizes'], ['press', 'Press'], ['dodgy', 'Something dodgy']];
const LTSD_REGISTRAR = 'aweh@learntospeakdurban.com';
function ltsdContact(topic, e) { if (e) e.preventDefault(); window.dispatchEvent(new CustomEvent('ltsd-contact', { detail: topic || null })); }

const HDR_SPOTIFY = 'https://open.spotify.com/playlist/4lbjRGukzSVUvbZq91tbI6';
const HDR_APPLE = 'https://music.apple.com/za/playlist/learn-to-speak-durban/pl.u-AkAmPlyUlVNPMX5';

function PlaylistPill() {
  const [open, setOpen] = React.useState(false);
  const ref = React.useRef(null);
  React.useEffect(() => { if (!open) return; const f = e => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); }; const k = e => { if (e.key === 'Escape') setOpen(false); }; addEventListener('pointerdown', f); addEventListener('keydown', k); return () => { removeEventListener('pointerdown', f); removeEventListener('keydown', k); }; }, [open]);
  return (
    <div className="hdr-pl" ref={ref}>
      <button type="button" className={'hdr-marks hdr-pl-b' + (open ? ' on' : '')} aria-expanded={open} onClick={() => setOpen(!open)}><span aria-hidden="true" style={{ fontSize: 16, lineHeight: 1 }}>♫</span>Playlist</button>
      {open && <div className="hdr-pl-m card">
        <span className="lbl muted">For the N3. Not the M1.</span>
        <a className="btn line sm" href={HDR_SPOTIFY} target="_blank" rel="noopener" onClick={() => setOpen(false)}>Spotify</a>
        <a className="btn line sm" href={HDR_APPLE} target="_blank" rel="noopener" onClick={() => setOpen(false)}>Apple Music</a>
      </div>}
    </div>
  );
}

// Profile chip → small menu, like every normal site. Log out returns to the unenrolled home.
const ltsdLogOut = () => { signOut(); if (location.hash !== '#home') location.hash = 'home'; window.scrollTo(0, 0); };
// Phones: the chip becomes a round avatar (the processed photo from the student card; no photo yet = the duck on orange). Same menu.
function ProfileMenu({ me, label, on }) {
  const [open, setOpen] = React.useState(false);
  const [av] = useStored('lsd2-avatar', null);
  const ref = React.useRef(null);
  React.useEffect(() => { if (!open) return; const f = e => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); }; const k = e => { if (e.key === 'Escape') setOpen(false); }; addEventListener('pointerdown', f); addEventListener('keydown', k); addEventListener('hashchange', () => setOpen(false), { once: true }); return () => { removeEventListener('pointerdown', f); removeEventListener('keydown', k); }; }, [open]);
  return (
    <div className="hdr-pm" ref={ref}>
      <button type="button" className={'btn soft sm hdr-cta' + (on || open ? ' on' : '')} aria-haspopup="menu" aria-expanded={open} onClick={() => setOpen(!open)}>{label}</button>
      <button type="button" className={'hdr-av' + (on || open ? ' on' : '') + (av ? '' : ' none')} aria-haspopup="menu" aria-expanded={open} aria-label={label + ' · profile menu'} title={label} onClick={() => setOpen(!open)}>{av ? <img src={av} alt="" /> : <img className="hdr-av-duck" src={LSD_RES('assets/duck-avatar.png')} alt="" draggable="false" />}</button>
      {open && <div className="card hdr-pm-m" role="menu">
        <ProfileItems me={me} />
      </div>}
    </div>
  );
}
function ProfileItems({ me, extra }) {
  return <>
    <span className="lbl muted pm-who">{'Signed in as ' + (me ? me.name : 'a student') + (me && me.email ? ' · ' + me.email : '')}</span>
    <a className="pm-i" role="menuitem" href="#profile"><b>Student File</b><span>Progress, marks, fluency ladder</span></a>
    <a className="pm-i" role="menuitem" href="#card"><b>Student Card</b><span>The printable one</span></a>
    {extra}
    <hr className="pm-hr" />
    <button type="button" className="pm-i pm-out" role="menuitem" onClick={ltsdLogOut}><b>Log out.</b><span>The ocean will remember you.</span></button>
  </>;
}

function Header({ page, sub }) {
  // The home/enrol hero already carries the full lockup + Gateway sign-off, so the header lockup stays off there.
  const heroBy = page === 'home' || (page === 'enrol' && sub !== 'new');
  const [enrolled] = useStored('lsd2-enrolled', false);
  const [open, setOpen] = React.useState(false);
  React.useEffect(() => { const f = () => setOpen(false); addEventListener('hashchange', f); return () => removeEventListener('hashchange', f); }, []);
  React.useEffect(() => { const hd = document.querySelector('.hdr'); if (open && hd) document.documentElement.style.setProperty('--hdr-b', Math.round(hd.getBoundingClientRect().bottom) + 'px'); document.documentElement.classList.toggle('menu-open', open); const k = e => { if (e.key === 'Escape') setOpen(false); }; addEventListener('keydown', k); return () => removeEventListener('keydown', k); }, [open]);
  // Enrolled: no Enrol in the nav or menu. The top-right button is the profile chip instead. Signed out, both come back.
  const nav = enrolled ? NAV.filter(([id]) => id !== 'enrol') : NAV;
  const navCls = id => (page === id ? 'on' : '') + (enrolled || id === 'home' || id === 'enrol' || id === 'orientation' ? '' : ' lk');
  const [pts] = useStored('lsd2-points', {});
  const marks = ptsFmt(pointsTotal(pts));
  const me = useProfile();
  const fl = useFluency();
  // Nav modes, by measurement (not a fixed breakpoint): nf = full nav · nt = tight (gaps compress, "A public service by" hides) · nb = Menu.
  // Row 1: lockup left, Playlist / Marks / profile right. Row 2: the nav, full width. Menu only when the items truly won't fit tight.
  const hdrRef = React.useRef(null);
  const [mode, setMode] = React.useState('nb');
  React.useLayoutEffect(() => {
    const hd = hdrRef.current; if (!hd) return;
    const inn = hd.querySelector('.hdr-in'), cv = document.createElement('canvas').getContext('2d');
    const calc = () => {
      cv.font = "500 14px Switzer, 'Helvetica Neue', Arial, sans-serif";
      const n = nav.length, tw = nav.reduce((s, [, l]) => s + cv.measureText(l).width, 0) + 20; // + the selected item's extra weight and padding
      const cs = getComputedStyle(inn), W = inn.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const r = hd.querySelector('.hdr-r'), rw = heroBy && r ? [...r.children].filter(c => !c.classList.contains('burger') && getComputedStyle(c).display !== 'none').reduce((s, c) => s + c.getBoundingClientRect().width + 10, 12) : 0;
      const avail = W - rw + 9, need = p => tw + n * 2 * p + (n - 1) * 2;
      setMode(avail >= need(9) ? 'nf' : avail >= need(5) ? 'nt' : 'nb');
    };
    calc(); const ro = new ResizeObserver(calc); ro.observe(inn); if (document.fonts) document.fonts.ready.then(calc);
    return () => ro.disconnect();
  }, [heroBy, nav.length]);
  React.useEffect(() => { if (mode !== 'nb') setOpen(false); }, [mode]);
  return (
    <header ref={hdrRef} className={'hdr ' + mode + (heroBy ? ' nob' : '')}><div className="wrap hdr-in">
      {!heroBy && <div className="hdr-brand"><a className="brand" href="#home" aria-label="Learn to speak Durban, home">Learn to speak <Sel>Durban.</Sel></a><a className="hdr-by" href="https://gatewayworld.co.za/" target="_blank" rel="noopener" aria-label="A public service by Gateway"><span className="lbl">A public service by</span><img src={LSD_RES(window.LSD_ASSETS + 'logos/gateway-logo.png')} alt="Gateway" /></a></div>}
      <nav className="nav">{nav.map(([id, l]) => { const c = navCls(id), on = /\bon\b/.test(c); return <a key={id} href={'#' + id} className={c} aria-current={on ? 'page' : undefined}>{on ? <Sel>{l}</Sel> : l}</a>; })}</nav>
      <div className="hdr-r">
        <PlaylistPill />
        <MarksChip total={pointsTotal(pts)} />
        {enrolled
          ? <ProfileMenu me={me} on={page === 'profile'} label={(me ? firstName(me.name) : 'Your profile') + ' · ' + fl.level.n} />
          : <a className={'btn primary sm hdr-cta' + (page === 'enrol' ? ' on' : '')} href="#enrol">[ Enrol, bru ]</a>}
        <button type="button" className={'burger' + (open ? ' on' : '')} aria-expanded={open} aria-controls="mnav" aria-label={open ? 'Close menu' : 'Open menu'} onClick={() => setOpen(!open)}><span className="bl"><i></i><i></i><i></i></span>{open ? 'Close' : 'Menu'}</button>
      </div>
    </div>
    {open && <nav id="mnav" className="mnav">
      <a href="#home" className={page === 'home' ? 'on' : ''}>Home<span className="lbl muted">Start here</span></a>
      {nav.map(([id, l]) => <a key={id} href={'#' + id} className={navCls(id)}>{l}{!(enrolled || id === 'enrol' || id === 'orientation') && <span className="lbl muted">Locked</span>}{id === 'orientation' && !enrolled && <span className="lbl blue">Read this first</span>}</a>)}
      <div className="mnav-foot">
        {!enrolled && <a className="btn primary" href="#enrol">[ Enrol, bru ]</a>}
        <a className="btn line sm" href="#leaderboard">{'Marks · ' + marks}</a>
        <div className="row" style={{ gap: 10, flexWrap: 'nowrap' }}><a className="btn line sm" style={{ flex: 1 }} href={HDR_SPOTIFY} target="_blank" rel="noopener">Playlist · Spotify</a><a className="btn line sm" style={{ flex: 1 }} href={HDR_APPLE} target="_blank" rel="noopener">Playlist · Apple Music</a></div>
        <a className="btn line sm" href="#contact" onClick={e => { setOpen(false); ltsdContact(null, e); }}>Contact</a>
        {enrolled && <div className="mnav-pm"><ProfileItems me={me} /></div>}
      </div>
    </nav>}
    </header>
  );
}

// The 031 slug: last thing on every page. One tap plays a single dial tone (SA 400 Hz) and owns up.
function Slug031() {
  const [knew, setKnew] = React.useState(false);
  const dial = () => {
    try { const A = window.AudioContext || window.webkitAudioContext; const c = Slug031.ctx || (Slug031.ctx = new A()); if (c.state === 'suspended') c.resume(); const o = c.createOscillator(), v = c.createGain(), t = c.currentTime; o.type = 'sine'; o.frequency.value = 400; v.gain.setValueAtTime(0.0001, t); v.gain.exponentialRampToValueAtTime(0.12, t + 0.02); v.gain.setValueAtTime(0.12, t + 0.7); v.gain.exponentialRampToValueAtTime(0.0001, t + 0.8); o.connect(v).connect(c.destination); o.start(t); o.stop(t + 0.85); } catch (e) {}
    setKnew(true); clearTimeout(Slug031.t); Slug031.t = setTimeout(() => setKnew(false), 2200);
  };
  return <div className="ft-031w"><button type="button" className="ft-031" onClick={dial} aria-live="polite">{knew ? '031. You knew.' : LTSD_SLUG}</button></div>;
}

const GW_SOCIALS = [['Facebook', 'https://www.facebook.com/GatewayVIP'], ['Instagram', 'https://www.instagram.com/gatewayumhlanga/'], ['X', 'https://twitter.com/gatewayumhlanga']];
const GW_ICON = {
  Facebook: <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><path d="M11.8 20.5V10.6a2.6 2.6 0 0 1 2.6-2.6h1.3M8.6 12.9h6.2"></path></svg>,
  Instagram: <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r=".6" className="dot"></circle></svg>,
  X: <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 4h4L19.5 20h-4zM19 4l-6.4 7.2M5 20l6.4-7.2"></path></svg>,
};
// Contact modal: simulated like Submit Word. Stored on this device for now.
// PRODUCTION: route to aweh@learntospeakdurban.com (topic in the subject line) when the backend is wired.
function ContactModal({ topic, onClose }) {
  const me = useProfile();
  const blank = { name: me ? me.name : '', email: me ? me.email : '', topic: topic || 'general', msg: '' };
  const [f, setF] = React.useState(blank);
  const [err, setErr] = React.useState({});
  const [done, setDone] = React.useState(false);
  const form = React.useRef(null);
  React.useEffect(() => { setF(x => ({ ...x, topic: topic || x.topic })); setDone(false); }, [topic]);
  React.useEffect(() => { const k = e => { if (e.key === 'Escape') onClose(); }; addEventListener('keydown', k); document.documentElement.classList.add('ct-open'); return () => { removeEventListener('keydown', k); document.documentElement.classList.remove('ct-open'); }; }, []);
  const set = k => e => { const v = e.target.value; setF(x => ({ ...x, [k]: v })); if (err[k]) setErr(x => ({ ...x, [k]: null })); };
  const send = e => {
    e.preventDefault(); const x = {};
    if (!f.name.trim()) x.name = 'For the file.'; else if (!ltsdNameOk(f.name)) x.name = LTSD_NAME_NO;
    if (!/^\S+@\S+\.\S+$/.test(f.email.trim())) x.email = f.email.trim() ? 'That looks like a vaalie typed it.' : 'So the registrar can write back.';
    if (!f.msg.trim()) x.msg = 'Say something. Anything.';
    setErr(x); if (Object.keys(x).length) { if (x.name === LTSD_NAME_NO && form.current) form.current.querySelector('[name="name"]').focus(); return; }
    try { const l = JSON.parse(localStorage.getItem('lsd2-contact') || '[]'); l.push({ ...f, to: LTSD_REGISTRAR, at: new Date().toISOString() }); localStorage.setItem('lsd2-contact', JSON.stringify(l)); } catch (x2) {}
    setDone(true);
  };
  const L = (k, t) => <span className={'lbl ' + (err[k] ? 'blue' : 'muted')}>{t}{err[k] ? ' · ' + err[k] : ''}</span>;
  return (
    <div className="scrim" onClick={onClose}>
      <div className="m-req ct-m" role="dialog" aria-modal="true" aria-label="Contact the registrar" onClick={e => e.stopPropagation()}>
        <div className="between lbl"><span className="blue">The registrar · {LTSD_REGISTRAR}</span><button type="button" className="chip" style={{ padding: '6px 12px', fontSize: 13 }} onClick={onClose}>Close</button></div>
        {done ? <>
          <div className="hl" style={{ fontSize: 'clamp(36px, 4vw, 52px)' }}><Sel>Received.</Sel></div>
          <p className="lead" style={{ margin: 0 }}>Filed. The intern has been informed. Shot.</p>
          <div className="row"><button type="button" className="btn primary" onClick={onClose}>Back to the site</button><button type="button" className="btn line sm" onClick={() => { setF({ ...blank, topic: f.topic }); setDone(false); }}>Send another</button></div>
        </> : <form ref={form} onSubmit={send} noValidate style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          <div className="hl" style={{ fontSize: 'clamp(36px, 4vw, 52px)' }}>Contact the <Sel>registrar.</Sel></div>
          <p style={{ margin: 0, fontSize: 17, lineHeight: 1.45, color: 'var(--ink-2)' }}>Questions about the course, the prizes, or a word we got wrong? The registrar reads everything. Eventually.</p>
          <div className="g2">
            <label className="ctl">{L('name', 'Name')}<input className="field" name="name" value={f.name} onChange={set('name')} onBlur={ltsdNameBlur('name', setErr)} maxLength={LTSD_NAME_MAX} autoComplete="name" placeholder="Your name" autoFocus={!f.name} /></label>
            <label className="ctl">{L('email', 'Email')}<input className="field" type="email" value={f.email} onChange={set('email')} autoComplete="email" placeholder="you@example.co.za" /></label>
          </div>
          <label className="ctl">{L('topic', 'What’s it about')}<select className="field" value={f.topic} onChange={set('topic')}>{CONTACT_TOPICS.map(([k, l]) => <option key={k} value={k}>{l}</option>)}</select></label>
          <label className="ctl">{L('msg', 'Message')}<textarea className="field" rows={4} value={f.msg} onChange={set('msg')} placeholder={f.topic === 'dodgy' ? 'What, and where. A name, a card, a link.' : 'Go on. Keep it shorter than the N3.'} style={{ resize: 'vertical' }} autoFocus={!!f.name}></textarea></label>
          <div className="row"><button type="submit" className="btn primary">[ Send it ]</button></div>
        </form>}
      </div>
    </div>
  );
}

function Footer() {
  const [ct, setCt] = React.useState(null); // null = closed, else { topic }
  React.useEffect(() => { const h = e => setCt({ topic: e.detail }); addEventListener('ltsd-contact', h); const [p, s] = location.hash.replace('#', '').split('/'); if (p === 'contact') setCt({ topic: CONTACT_TOPICS.some(([k]) => k === s) ? s : null }); return () => removeEventListener('ltsd-contact', h); }, []);
  const close = () => { setCt(null); if (/^#contact/.test(location.hash)) history.replaceState(null, '', '#home'); };
  return (
    <footer className="ft"><div className="wrap ft-in">
      <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}><a className="brand ft-brand" href="#home" aria-label="Learn to speak Durban, home">Learn to speak <Sel>Durban.</Sel></a><div style={{ fontSize: 15, fontWeight: 500, color: 'var(--ink-2)' }}>A public service by Gateway.</div></div>
        <div className="lbl muted">REF: LTSD-2026 · No forks were harmed in the making of this website</div>
        <div className="row" style={{ gap: 16, marginTop: 6 }}><a href="#orientation">Orientation</a><a href="#kit">Vy Kit</a><a href="#study">Goodies</a><a href="#card">Student card</a><a href="#kit/quiz">How Durban are you?</a><a href="#exam">Final exam</a><a href="#submit">Submit Word</a><a href="#contact" onClick={e => ltsdContact(null, e)}>Contact</a><a href="#home" onClick={() => signOut()}>Log out (we’ll pretend this never happened)</a></div>
      </div>
      <div className="ft-gw">
        <a className="ft-logo" href="https://gatewayworld.co.za/" target="_blank" rel="noopener" aria-label="Gateway"><img src={LSD_RES(window.LSD_ASSETS + 'logos/gateway-logo.png')} alt="Gateway" style={{ height: 96, width: 'auto', display: 'block' }} /></a>
        <div className="ft-soc">{GW_SOCIALS.map(([l, u]) => <a key={l} href={u} target="_blank" rel="noopener" aria-label={'Gateway on ' + l} title={'Gateway on ' + l}>{GW_ICON[l]}</a>)}</div>
      </div>
      <div className="ft-contact"><span className="hl ft-contact-h">Contact.</span><button type="button" className="btn line sm" onClick={() => ltsdContact()}>[ Contact the registrar ]</button><a className="ft-contact-m" href={'mailto:' + LTSD_REGISTRAR}>{LTSD_REGISTRAR}</a></div>
      <div className="ft-bot">
        <div className="lbl muted ft-legal"><a href="https://gatewayworld.co.za/privacy-policy/" target="_blank" rel="noopener">Privacy Policy</a><span aria-hidden="true">·</span><a href="https://gatewayworld.co.za/terms-and-conditions/" target="_blank" rel="noopener">Terms & Conditions</a><span aria-hidden="true">·</span><a href="#terms">Campaign & Competition Terms</a><span aria-hidden="true">·</span><a href="#contact/dodgy" onClick={e => ltsdContact('dodgy', e)}>Report something dodgy</a><span aria-hidden="true">·</span><span>© Gateway Theatre of Shopping</span><span aria-hidden="true">·</span><a href={GATEWAY_MAP} target="_blank" rel="noopener">THE CAMPUS · UMHLANGA</a><span aria-hidden="true">·</span><a href={GATEWAY_SITE} target="_blank" rel="noopener">GATEWAYWORLD.CO.ZA</a></div>
        <div className="ft-fine">No passwords at this school. Your inbox is your locker key.</div>
        <div className="ft-fine">Reading the fine print? Very Joburg of you. We respect it.</div>
      </div>
      <Slug031 />
    </div>{ct && <ContactModal topic={ct.topic} onClose={close} />}</footer>
  );
}

function TermsScreen() {
  return (
    <div className="ph terms">
      <h1 className="hl">Campaign & Competition Terms</h1>
      <p className="lead" style={{ margin: 0 }}>Campaign and competition terms to be inserted on approval by Gateway. [PLACEHOLDER — DO NOT LAUNCH WITHOUT THIS]</p>
      <section className="terms-sec">
        <span className="lbl blue">Weekly spot prizes</span>
        <ol className="terms-l">
          <li>Gateway runs a spot prize draw every week of the campaign, [start date] to [end date].</li>
          <li>Winners are picked at random from active students: enrolled with a verified email, and played a game or learnt a lesson on this site during that week.</li>
          <li>There is no entry form. No purchase is necessary. Taking part in the course is the entry.</li>
          <li>Prizes, and how many are given each week, are at Gateway’s discretion and may change from week to week. No cash alternative.</li>
          <li>Winners are told by the email address they enrolled with. Prizes are collected in person at the campus: Gateway Theatre of Shopping, Umhlanga, with ID.</li>
          <li>[Eligibility (age, residency), staff exclusions, unclaimed-prize period and the draw method: legal to supply.]</li>
        </ol>
      </section>
    </div>
  );
}

const REPORT_WHERE = ['Student card', 'Class Rankings name', 'Shared result or postcard', 'Certificate of Fluency', 'Submitted word', 'Somewhere else on the site'];
const REPORT_WHY = ['Profanity', 'Hate or slurs', 'Harassing someone', 'Someone else’s name or photo', 'Pretending to be Gateway', 'Spam or a scam', 'Something else'];
function ReportScreen() {
  const blank = { where: REPORT_WHERE[0], why: [], who: '', what: '', email: '' };
  const [f, setF] = React.useState(blank);
  const [err, setErr] = React.useState({});
  const [done, setDone] = React.useState(null);
  const set = k => e => { const v = e.target.value; setF(x => ({ ...x, [k]: v })); if (err[k]) setErr(x => ({ ...x, [k]: null })); };
  const tog = w => { setF(x => ({ ...x, why: x.why.includes(w) ? x.why.filter(y => y !== w) : [...x.why, w] })); if (err.why) setErr(x => ({ ...x, why: null })); };
  const send = e => {
    e.preventDefault(); const x = {};
    if (!f.why.length) x.why = 'Pick at least one.';
    if (!f.who.trim()) x.who = 'Gateway needs something to find it by.';
    if (f.email.trim() && !/^\S+@\S+\.\S+$/.test(f.email)) x.email = 'That email has gone off-road.';
    setErr(x); if (Object.keys(x).length) return;
    // PRODUCTION: send reports to a monitored moderation inbox (and hide the reported item pending review). Stored on this device for now.
    try { const l = JSON.parse(localStorage.getItem('lsd2-reports') || '[]'); l.push({ ...f, at: new Date().toISOString(), status: 'open' }); localStorage.setItem('lsd2-reports', JSON.stringify(l)); } catch (x2) {}
    setDone('LTSD-REP-' + String(100 + Math.floor(Math.random() * 900)).padStart(4, '0'));
  };
  const L = (k, t) => <span className={'lbl ' + (err[k] ? 'blue' : 'muted')}>{t}{err[k] ? ' · ' + err[k] : ''}</span>;
  const steps = [['Filed', 'With a reference number. Officially noticed.'], ['Hidden', 'If it’s nasty, it comes down while we look.'], ['Checked', 'By an actual person at Gateway. Not a robot. Not the traffic kind either.'], ['Sorted', 'Removed, renamed, or left alone with a stern look.']];
  return (
    <div>
      <PageHead index="R-01" kicker="Read by a human, not a robot" title="Report something dodgy">
        <p className="lead" style={{ margin: 0 }}>Somebody put a swear word on a student card. Or your name. Or a slur on the rankings. Tell us where and it gets sorted. Durban is relaxed, not lawless. A human reads every report. Not a robot.</p>
      </PageHead>
      <div className="sub">
        {done ? (
          <div className="card sub-form" style={{ justifyContent: 'center' }}>
            <span className="lbl blue">{done}</span>
            <div className="hl" style={{ fontSize: 'clamp(48px, 6vw, 96px)' }}><Sel>Reported.</Sel></div>
            <p className="lead" style={{ margin: 0 }}>Thanks for keeping it lekker. A person at Gateway will look at it, and anything nasty comes down.</p>
            <div className="row"><button type="button" className="btn primary" onClick={() => { setF(blank); setDone(null); }}>Report something else</button><a className="btn line" href="#home">Back to the words</a></div>
          </div>
        ) : (
          <form className="card sub-form" onSubmit={send} noValidate>
            <label className="ctl">{L('where', 'Where you saw it')}<select className="field" value={f.where} onChange={set('where')}>{REPORT_WHERE.map(o => <option key={o}>{o}</option>)}</select></label>
            <div className="ctl" role="group" aria-label="What’s wrong">{L('why', 'What’s wrong · pick any')}<div className="row" style={{ gap: 8, flexWrap: 'wrap' }}>{REPORT_WHY.map(w => <button key={w} type="button" className={'chip' + (f.why.includes(w) ? ' on' : '')} aria-pressed={f.why.includes(w)} onClick={() => tog(w)}>{w}</button>)}</div></div>
            <label className="ctl">{L('who', 'Name, word or link on it')}<input className="field" type="text" value={f.who} onChange={set('who')} placeholder="e.g. the name on the card, the ranking spot, a share link" /></label>
            <label className="ctl">{L('what', 'Anything else · optional')}<textarea className="field" rows={3} value={f.what} onChange={set('what')} placeholder="Where you saw it, when, why it’s not okay." style={{ resize: 'vertical' }}></textarea></label>
            <label className="ctl">{L('email', 'Your email · optional, if you want to hear back')}<input className="field" type="email" value={f.email} onChange={set('email')} placeholder="you@example.co.za" /></label>
            <div className="between" style={{ flexWrap: 'wrap' }}><span className="lbl muted">You don’t have to be enrolled. Reports stay private.</span><button type="submit" className="btn primary">[ Send report ]</button></div>
          </form>
        )}
        <div className="sub-steps">
          <span className="lbl muted">What happens next</span>
          {steps.map(([t, d], i) => <div key={t} className="card step"><span className="lbl blue">{pad2(i + 1)}</span><div><b>{t}</b><div className="muted">{d}</div></div></div>)}
        </div>
      </div>
    </div>
  );
}

function LockedScreen({ page }) {
  const label = PAGE_NAME[page] || 'This page';
  return (
    <div className="locked-pg">
      <div className="locked-l">
        <span className="pill lbl">{'Locked · ' + label}</span>
        <h1 className="hl">Enrol first, <Sel>bru.</Sel></h1>
        <p className="lead" style={{ margin: 0 }}>{label} is behind the enrolment desk. It’s free, it takes four fields and zero passwords, and it’s less admin than your parking garage. Enrolled before? The return door is on the right.</p>
        <a className="btn line sm" href="#home" style={{ alignSelf: 'flex-start' }}>Back to the words</a>
      </div>
      <EnrolCard />
    </div>
  );
}

// Where to next: three suggested stops per page, first one recommended. Keeps people moving round the site.
const NEXT_UP = {
  card: [['lessons/01', 'Lesson 01', 'Card done. Now learn to say hello like you mean it.'], ['dictionary', 'The Dictionary', 'All 50 words on one page. Skim it on the loo. We won’t ask.'], ['activities', 'Games', 'Practise without anyone watching. Except the Class Rankings.']],
  lessons: [['flashcards', 'Flashcards', 'Test what stuck. Flip, guess, feel things.'], ['activities', 'Games', 'Twelve ways to practise. Some involve prawns.'], ['exam', 'The final exam', 'All 50 words. One sitting. A certificate if you pass.']],
  dictionary: [['lessons/01', 'Lessons', 'One word at a time, with examples and a voice.'], ['flashcards', 'Flashcards', 'Find out which ones you actually know.'], ['ekselator', 'The Ekselator', 'Paste an inland email. Watch it come home.']],
  flashcards: [['activities', 'Games', 'Same words, more pressure, actual marks.'], ['exam', 'The final exam', 'Feeling fluent? Prove it.'], ['lessons/01', 'Lessons', 'The ones you missed are waiting. Patiently.']],
  activities: [['leaderboard', 'Class Rankings', 'See who’s beating you. It’s probably someone from Sandton.'], ['flashcards', 'Flashcards', 'Brush up between games.'], ['exam', 'The final exam', 'The big one. The certificate one.']],
  leaderboard: [['activities', 'Games', 'Marks don’t earn themselves. Go on.'], ['profile', 'Your profile', 'Your title, your marks, your permanent record.'], ['card', 'Student card', 'Post it. Let Joburg see the rank.']],
  ekselator: [['kit', 'The Vy Kit', 'A postcard, an out-of-office and a quiz. All coastal.'], ['lessons/01', 'Lessons', 'Learn the words it just used on you.'], ['activities', 'Games', 'Put it to the test.']],
  study: [['lessons/01', 'Lessons', 'Start the course. It’s faster than the N3.'], ['kit', 'The Vy Kit', 'Your out-of-office, sorted before you go.'], ['card', 'Student card', 'Paperwork first. Then the beach.']],
  kit: [['ekselator', 'The Ekselator', 'Translate anything else you’re sending inland.'], ['activities', 'Games', 'Twelve games. Eleven count for marks — the aunties count for honour.'], ['study', 'Goodies', 'Download the lot for the flight.']],
  exam: [['card', 'Student card', 'Update the title. You’ve earned it. Maybe.'], ['kit/quiz', 'How Durban are you?', 'Eight questions. One shareable result.'], ['activities', 'Spot prizes', 'Play like you want to win.']],
  profile: [['activities', 'Games', 'More marks, higher title.'], ['lessons/01', 'Lessons', 'Every word learnt moves you up.'], ['card', 'Student card', 'Show off the new title.']],
  submit: [['dictionary', 'The Dictionary', 'Check it’s not already in there.'], ['lessons/01', 'Lessons', 'Learn the official 50.'], ['activities', 'Games', 'While the intern investigates.']],
};
function NextUp({ page, sub }) {
  if (page === 'activities' && sub) return null;
  if (page === 'study' && sub) return null;
  const list = NEXT_UP[page]; if (!list) return null;
  return (
    <section className="next-up">
      <div className="lbl muted">Where to next</div>
      <div className="kit-tabs">{list.map(([to, t, d], i) => <a key={to} href={'#' + to} className={'card kt' + (i === 0 ? ' on' : '')}><span className={'lbl ' + (i === 0 ? 'blue' : 'muted')}>{i === 0 ? 'Up next' : 'Or'}</span><span className="hl kt-t">{t}</span><span className="kt-d">{d}</span></a>)}</div>
    </section>
  );
}

// 404: any hash route the site doesn't know.
function LostScreen() {
  return (
    <div className="lost">
      <span className="lbl blue">Error 404 · page not found</span>
      <h1 className="hl lost-h">This page <Sel>vy’d.</Sel></h1>
      <p className="lead" style={{ margin: 0 }}>It left no note. Very Lesson 28 of it.</p>
      <div className="row"><a className="btn primary" href="#home">Back to the front desk</a><a className="btn line" href="#lessons/28">Lesson 28: Vy</a></div>
      <div className="lost-031"><LtsdWave /><span className="s031">{LTSD_SLUG}</span></div>
    </div>
  );
}

function SiteApp() {
  const [r, setR] = React.useState(parseRoute);
  React.useEffect(() => { const f = () => { setR(parseRoute()); window.scrollTo(0, 0); }; addEventListener('hashchange', f); return () => removeEventListener('hashchange', f); }, []);
  const go = h => { location.hash = h; };
  const [enrolled] = useStored('lsd2-enrolled', false);
  const [session] = useStored('lsd2-session', null);
  const gated = !enrolled && !['home', 'enrol', 'orientation', 'terms', 'report', 'lost'].includes(r.page);
  const [online, setOnline] = React.useState(navigator.onLine !== false);
  React.useEffect(() => { const on = () => setOnline(true), off = () => setOnline(false); addEventListener('online', on); addEventListener('offline', off); return () => { removeEventListener('online', on); removeEventListener('offline', off); }; }, []);
  const screens = {
    home: <HomeScreen go={go} />,
    orientation: <OrientationScreen />,
    enrol: r.sub === 'new' ? <EnrolNewScreen /> : <HomeScreen go={go} preview />,
    lessons: <LessonsScreen sub={r.sub} go={go} />,
    dictionary: <DictionaryScreen />,
    activities: <ActivitiesScreen key={r.sub || 'hub'} sub={r.sub} />,
    flashcards: <FlashScreen />,
    ekselator: <TranslateScreen />,
    card: <StudentCardScreen />,
    study: <StudyScreen sub={r.sub} />,
    submit: <SubmitScreen />,
    kit: <DuckKitScreen sub={r.sub} />,
    exam: <ExamScreen />,
    profile: <ProfileScreen />,
    leaderboard: <LeaderboardScreen />,
    terms: <TermsScreen />,
    report: <ReportScreen />,
    lost: <LostScreen />,
  };
  return (
    <div data-screen-label={r.page} key={session || 'guest'}>
      <Header page={r.page} sub={r.sub} />
      <OrientBanner page={r.page} />
      {!online && <div className="offline-bar" role="status"><b className="hl">No <Sel handles={false}>signal.</Sel></b><span>The most Durban thing to happen to you all day.</span></div>}
      <main className="wrap">{gated ? <LockedScreen page={r.page} /> : screens[r.page]}{!gated && <NextUp page={r.page} sub={r.sub} />}</main>
      <Footer />
      <LevelStamp />
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<SiteApp />);
