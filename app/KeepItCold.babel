// ── GAME: KEEP IT COLD ───────────────────────────────────────────────────────
// Arcade, no cap, no finish line. Everything in an open cooler box warms up (each type at its own speed, everything faster over time).
// Tap to ice (uses one ice, then a KC_CD breather). Ice runs out: bags of ice land in the box now and then, tap one to grab it. Drag items into the shade corner.
// Three hearts: anything that turns, or gets stolen by a seagull or a small hand, costs one. Chaos: seagulls, kids' hands,
// sun through the umbrella. Help: ice bags and ice blocks (land in the box), freeze bomb, the shade.
// Marks: KC_RATE × heat × combo per second; bonuses for close ones (icing in the red), shooing and slapping. No cap.
const KC_CD = 0.33, KC_RATE = 10, KC_SAVE = 40, KC_RED = 0.75, KC_MAX = 12, KC_HEARTS = 3;
const KC_ICE0 = 16, KC_ICEMAX = 24, KC_REFILL = 8, KC_SHADE_X = 0.4, KC_SUN_X = 2.5;
const kcHeat = t => 1 + t / 130;
const kcMult = c => Math.min(4, 1 + Math.floor(c / 3) * 0.5); // ice the hottest thing three times running: +0.5
// secs: seconds from cold to full red at heat 1. No alcohol in this game.
const KC_ITEMS = {
  Cooldrink: { secs: 16, the: 'the cooldrink', in: 'cooldrink', label: 'Can of cooldrink', img: LSD_RES('assets/cooler/cooldrink.png') },
  Oros: { secs: 16, the: 'the Oros', in: 'Oros', label: 'Bottle of Oros', img: LSD_RES('assets/cooler/oros.png') },
  Water: { secs: 24, the: 'the water', in: 'water', label: 'Water bottle', img: LSD_RES('assets/cooler/water.png') },
  Litchis: { secs: 21, the: 'the litchis', in: 'litchis', label: 'Litchis', img: LSD_RES('assets/pack/litchis.png') },
  Watermelon: { secs: 19, the: 'the watermelon', in: 'watermelon', label: 'Watermelon slice', img: LSD_RES('assets/migration/watermelon.png') },
  Mango: { secs: 20, the: 'the mango', in: 'mangoes', label: 'Mango', img: LSD_RES('assets/migration/mango.png') },
  Lolly: { secs: 11, the: 'the ice lolly', in: 'granadilla lolly', label: 'Granadilla ice lolly', img: LSD_RES('assets/migration/lolly.png') },
  Sandwich: { secs: 36, the: 'the sandwiches', in: 'sandwiches', label: 'Sandwiches', img: LSD_RES('assets/cooler/sandwich.png') },
  Yoghurt: { secs: 26, the: 'the yoghurt', in: 'yoghurt', label: 'Tub of yoghurt', img: LSD_RES('assets/cooler/yoghurt.png') },
  Samoosa: { secs: 30, the: 'the samoosas', in: 'samoosas', label: 'Samoosas', img: LSD_RES('assets/cooler/samoosa.png') },
  Prawns: { secs: 8.5, the: 'the prawns', in: 'prawns', label: 'Prawns', img: LSD_RES('assets/cooler/prawns.png') },
};
const KC_START = ['Cooldrink', 'Sandwich', 'Water', 'Mango'];
const KC_NEXT = ['Litchis', 'Oros', 'Samoosa', 'Watermelon', 'Prawns', 'Yoghurt', 'Lolly'];
const KC_TREATS = ['Lolly', 'Samoosa', 'Litchis', 'Mango', 'Watermelon', 'Cooldrink', 'Oros'];
const KC_LINES = { Prawns: 'The prawns turned. The aunties saw.', Oros: 'Warm Oros. There are laws.', Lolly: 'The ice lolly is now a juice. Moment of silence.', Watermelon: 'You lost the watermelon. In Dezemba. Shame.' };
const kcClock = t => { t = Math.max(0, +t || 0); const m = Math.floor(t / 60), s = t - m * 60; return m + ':' + (s < 10 ? '0' : '') + s.toFixed(1); };
const kcCol = w => w < 0.5 ? 'color-mix(in oklab, #f08a24 ' + Math.round(w * 200) + '%, #3d8bf2)' : 'color-mix(in oklab, #e5322d ' + Math.round((w - 0.5) * 200) + '%, #f08a24)';

// Sound: tiny WebAudio synth, no files. Starts on the first tap (browsers insist).
const kcAudio = { ctx: null, on: true, siz: null };
function kcSnd(name) {
  if (!kcAudio.on) return;
  let c = kcAudio.ctx; if (!c) { try { c = kcAudio.ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return; } }
  if (c.state === 'suspended') c.resume();
  const now = c.currentTime, out = c.destination;
  const tone = (type, f0, f1, dur, vol, dl = 0) => { const o = c.createOscillator(), g = c.createGain(); o.type = type; o.frequency.setValueAtTime(f0, now + dl); o.frequency.exponentialRampToValueAtTime(f1, now + dl + dur); g.gain.setValueAtTime(0.0001, now + dl); g.gain.exponentialRampToValueAtTime(vol, now + dl + 0.01); g.gain.exponentialRampToValueAtTime(0.0001, now + dl + dur); o.connect(g).connect(out); o.start(now + dl); o.stop(now + dl + dur + 0.03); };
  const noise = (dur, vol, freq, q, type, dl = 0) => { const n = Math.max(1, c.sampleRate * dur | 0), b = c.createBuffer(1, n, c.sampleRate), d = b.getChannelData(0); for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / n); const s = c.createBufferSource(), f = c.createBiquadFilter(), g = c.createGain(); s.buffer = b; f.type = type || 'bandpass'; f.frequency.value = freq; f.Q.value = q || 1; g.gain.value = vol; s.connect(f).connect(g).connect(out); s.start(now + dl); };
  const fx = {
    ice: () => { noise(0.12, 0.5, 3200, 2); tone('sine', 2200, 900, 0.12, 0.1); },
    close: () => { noise(0.1, 0.4, 3200, 2); tone('triangle', 660, 660, 0.08, 0.14); tone('triangle', 990, 990, 0.14, 0.14, 0.08); },
    lose: () => { tone('sine', 160, 45, 0.4, 0.45); noise(0.3, 0.3, 500, 0.7, 'lowpass'); },
    gull: () => { tone('sawtooth', 1150, 700, 0.16, 0.05); tone('sawtooth', 1050, 650, 0.2, 0.05, 0.19); },
    slap: () => noise(0.09, 0.8, 1300, 0.8),
    coin: () => { tone('sine', 880, 880, 0.08, 0.14); tone('sine', 1320, 1320, 0.16, 0.14, 0.07); },
    bell: () => { tone('sine', 1568, 1568, 0.3, 0.08); tone('sine', 2093, 2093, 0.3, 0.05, 0.1); },
    freeze: () => { noise(0.6, 0.3, 5000, 0.8, 'highpass'); tone('sine', 1800, 300, 0.6, 0.08); },
    empty: () => tone('square', 200, 170, 0.1, 0.04),
    combo: () => [660, 880, 1100].forEach((f, i) => tone('triangle', f, f, 0.08, 0.1, i * 0.06)),
  };
  if (fx[name]) fx[name]();
}
// Continuous sizzle while something is close to turning. level 0 = silent.
function kcSizzle(level) {
  const A = kcAudio; if (!A.ctx) return;
  if (!A.siz) { const c = A.ctx, n = c.sampleRate * 2, b = c.createBuffer(1, n, c.sampleRate), d = b.getChannelData(0); for (let i = 0; i < n; i++) d[i] = Math.random() * 2 - 1; const s = c.createBufferSource(), f = c.createBiquadFilter(), g = c.createGain(); s.buffer = b; s.loop = true; f.type = 'bandpass'; f.frequency.value = 5200; f.Q.value = 0.9; g.gain.value = 0; s.connect(f).connect(g).connect(c.destination); s.start(); A.siz = g; }
  A.siz.gain.setTargetAtTime(A.on ? level : 0, A.ctx.currentTime, 0.08);
}

// Stand-in icons for items without 3D art yet. Swap for PNGs by adding img to KC_ITEMS.
function KcIcon({ k }) {
  const it = KC_ITEMS[k];
  if (it.img) return <img src={it.img} alt="" draggable="false" />;
  const svg = c => <svg viewBox="0 0 64 64" aria-hidden="true">{c}</svg>;
  const bottle = 'M26 11h12v5c0 3 9 6 9 12v26a6 6 0 0 1-6 6H23a6 6 0 0 1-6-6V28c0-6 9-9 9-12z';
  if (k === 'Cooldrink') return svg(<><defs><linearGradient id="kcCan" x1="0" x2="1"><stop offset="0" stopColor="#a91c18" /><stop offset=".35" stopColor="#f0463c" /><stop offset="1" stopColor="#9c1915" /></linearGradient></defs><rect x="19" y="9" width="26" height="49" rx="6" fill="url(#kcCan)" /><rect x="19" y="27" width="26" height="10" fill="#fff" /><ellipse cx="32" cy="11" rx="12" ry="3.6" fill="#d9dde2" /><ellipse cx="34" cy="11" rx="4" ry="1.4" fill="#9aa1a8" /></>);
  if (k === 'Oros') return svg(<><defs><linearGradient id="kcOros" x1="0" x2="1"><stop offset="0" stopColor="#e0690c" /><stop offset=".4" stopColor="#ffa526" /><stop offset="1" stopColor="#d9620a" /></linearGradient></defs><rect x="24" y="3" width="16" height="9" rx="2.5" fill="#fff" stroke="#e2e4e8" strokeWidth="1.5" /><path d={bottle} fill="url(#kcOros)" /><rect x="17" y="33" width="30" height="14" fill="#fff" /><circle cx="32" cy="40" r="5" fill="#f08a24" /></>);
  if (k === 'Water') return svg(<><defs><linearGradient id="kcWat" x1="0" x2="1"><stop offset="0" stopColor="#8cc3ef" /><stop offset=".4" stopColor="#dff0fc" /><stop offset="1" stopColor="#7db8e8" /></linearGradient></defs><rect x="24" y="3" width="16" height="9" rx="2.5" fill="#1f5fd1" /><path d={bottle} fill="url(#kcWat)" /><rect x="17" y="33" width="30" height="13" fill="#2f80ed" /><rect x="17" y="38" width="30" height="3" fill="#fff" /></>);
  if (k === 'Sandwich') return svg(<><path d="M9 46 L32 12 L55 46 Z" fill="#f4dba8" stroke="#c98d43" strokeWidth="4" strokeLinejoin="round" /><path d="M8 49 q4-5 8 0 t8 0 t8 0 t8 0 t8 0 t8 0" fill="none" stroke="#5bb85d" strokeWidth="4" strokeLinecap="round" /><rect x="10" y="44" width="16" height="4" rx="2" fill="#e5483a" /><rect x="9" y="51" width="46" height="8" rx="3" fill="#f4dba8" stroke="#c98d43" strokeWidth="3" /></>);
  if (k === 'Yoghurt') return svg(<><defs><linearGradient id="kcYog" x1="0" x2="1"><stop offset="0" stopColor="#dfe3e8" /><stop offset=".4" stopColor="#fff" /><stop offset="1" stopColor="#d6dbe1" /></linearGradient></defs><path d="M13 22 L51 22 L46 56 Q45 59 42 59 L22 59 Q19 59 18 56 Z" fill="url(#kcYog)" /><path d="M16 34 L48 34 L46.6 46 L17.4 46 Z" fill="#f29bb8" /><circle cx="32" cy="40" r="3.2" fill="#d63d6c" /><ellipse cx="32" cy="22" rx="20" ry="5.5" fill="#c9d0d8" /><ellipse cx="32" cy="21" rx="17" ry="3.8" fill="#eef1f4" /></>);
  if (k === 'Samoosa') return svg(<><defs><linearGradient id="kcSam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stopColor="#f6c45a" /><stop offset="1" stopColor="#d98a26" /></linearGradient></defs><path d="M10 50 L32 10 L54 50 Z" fill="url(#kcSam)" stroke="#b8701c" strokeWidth="4" strokeLinejoin="round" /><path d="M32 10 L32 50" stroke="#c27a20" strokeWidth="2" opacity=".55" /><circle cx="24" cy="38" r="1.6" fill="#b8701c" /><circle cx="39" cy="34" r="1.6" fill="#b8701c" /><circle cx="30" cy="26" r="1.4" fill="#b8701c" /><circle cx="42" cy="44" r="1.4" fill="#b8701c" /></>);
  if (k === 'Prawns') return svg(<><path d="M45 15 C25 12 11 26 17 40 C21 50 35 53 42 45" fill="none" stroke="#ff7b5c" strokeWidth="13" strokeLinecap="round" /><path d="M45 15 C25 12 11 26 17 40 C21 50 35 53 42 45" fill="none" stroke="#e4553a" strokeWidth="13" strokeDasharray="2 8" /><path d="M41 44 L55 45 L51 57 L43 51 Z" fill="#ff7b5c" stroke="#e4553a" strokeWidth="1.5" strokeLinejoin="round" /><circle cx="44" cy="12" r="2.2" fill="#2a1a14" /><path d="M48 13 Q56 4 63 7 M48 16 Q58 12 63 17" fill="none" stroke="#e4553a" strokeWidth="1.6" strokeLinecap="round" /></>);
  return null;
}
const KcGull = () => <img src={LSD_RES('assets/cooler/seagull.png')} alt="" draggable="false" />;
const KcBag = ({ block }) => <img src={block ? LSD_RES('assets/cooler/ice-block.png') : LSD_RES('assets/cooler/ice-bag.png')} alt="" draggable="false" />;

function KeepItColdGame() {
  const box = React.useRef(null), S = React.useRef(null), G = React.useRef(null);
  const [phase, setPhase] = React.useState('ready');
  const [paused, setPaused] = React.useState(false);
  const [res, setRes] = React.useState(null);
  const [, tick] = React.useState(0);
  const [best, setBest] = useStored('lsd2-kic-best', 0);
  const [sound, setSound] = useStored('lsd2-kic-sound', true);
  kcAudio.on = !!sound;
  useAreaSize(box);
  const playing = phase === 'play';
  const el = box.current, W = el ? el.clientWidth : 640, H = el ? el.clientHeight : 600;
  const cols = W >= 640 ? 4 : 3, rows = KC_MAX / cols, shade = KC_MAX - 1;
  const TOP = 64, pad = 14, rim = Math.max(14, Math.min(22, W * 0.03));
  const inX = pad + rim, inY = TOP + rim, inW = Math.max(1, W - 2 * inX), inH = Math.max(1, H - inY - pad - rim);
  const cw = inW / cols, ch = inH / rows, icon = Math.max(38, Math.min(cw * 0.6, ch * 0.5, 104));
  G.current = { cols, inX, inY, inW, inH, cw, ch, icon, W };
  const cellXY = slot => { const g = G.current; return [g.inX + g.cw * (slot % g.cols + 0.5), g.inY + g.ch * (Math.floor(slot / g.cols) + 0.5)]; };
  const at = it => { const s = S.current, g = G.current; if (s && s.drag && s.drag.it === it && s.drag.moved) return [s.drag.x, s.drag.y]; const [x, y] = cellXY(it.slot); return [x + g.cw * it.jx, y + g.ch * it.jy]; };
  // New items take the free spot farthest from the others (never the shade, that one's yours to fill).
  const put = (s, k, w) => {
    const g = G.current, used = s.items.map(i => i.slot), free = [...Array(KC_MAX).keys()].filter(i => !used.includes(i) && i !== shade); if (!free.length) return false;
    const xy = i => [i % g.cols, Math.floor(i / g.cols)];
    const sc = free.map(c => { const [x, y] = xy(c); return (used.length ? Math.min(...used.map(u => { const [ux, uy] = xy(u); return Math.hypot(x - ux, y - uy); })) : 0) + Math.random() * 0.7; });
    s.items.push({ id: s.id++, k, slot: free[sc.indexOf(Math.max(...sc))], w, iced: -9, ice: 0, jx: (Math.random() - 0.5) * 0.18, jy: (Math.random() - 0.5) * 0.12, rot: (Math.random() - 0.5) * 16 });
    return true;
  };
  const pop = (s, where, txt, good) => { const [x, y] = Array.isArray(where) ? where : at(where); s.pops.push({ id: s.id++, x, y, t: s.t, txt, good }); };
  const say = (s, txt) => { s.toast = txt; s.toastT = s.t; };
  const end = s => {
    s.dead = true; s.drag = s.swipe = null; kcSizzle(0);
    const L = s.last || { k: 'Prawns', how: 'turned' }, nm = KC_ITEMS[L.k].in;
    const line = L.how === 'gull' ? 'A seagull took the ' + nm + '. It wasn’t even sorry.' : L.how === 'kid' ? 'A laatie took the ' + nm + '. Nobody saw. Everybody saw.' : KC_LINES[L.k] || ngPick(Object.values(KC_LINES));
    const prev = +best || 0; if (s.t > prev) setBest(+s.t.toFixed(1));
    setRes({ line, t: s.t, score: Math.floor(s.pts), timePts: Math.floor(s.timePts), bonusPts: Math.max(0, Math.floor(s.pts) - Math.floor(s.timePts)), saves: s.saves, shoos: s.shoos, slaps: s.slaps, bestX: s.bestX, best: Math.max(prev, s.t), newBest: s.t > prev });
    say(s, 'Three hearts. Gone.'); setPhase('dead');
  };
  const lose = (s, it, how) => {
    pop(s, it, how === 'turned' ? 'Turned · −1 heart' : 'Stolen · −1 heart');
    s.items = s.items.filter(i => i !== it); s.hearts--; s.combo = 0; s.last = { k: it.k, how }; s.flash = s.t; kcSnd('lose');
    if (s.drag && s.drag.it === it) s.drag = null;
    if (s.hearts <= 0) end(s);
  };
  const bonus = (s, where, base, txt) => { const add = Math.round(base * kcHeat(s.t) * kcMult(s.combo)); s.pts += add; pop(s, where, txt + ' +' + ptsFmt(add), true); };
  const iceIt = (s, it) => {
    if (it.w >= KC_RED) { const add = Math.round(KC_SAVE * kcHeat(s.t) * kcMult(s.combo)); s.pts += add; s.saves++; pop(s, it, 'Close one +' + ptsFmt(add)); kcSnd('close'); } else kcSnd('ice');
    it.w = 0; it.iced = s.t; it.ice++;
  };
  const shoo = (s, it) => { s.gull.off = s.t; s.shoos++; bonus(s, it, 15, 'Shoo'); kcSnd('slap'); };
  const slapHand = s => { s.hand.off = s.t; s.slaps++; bonus(s, s.hand.it, 15, 'Slap · not yours'); kcSnd('slap'); };
  const tap = it => {
    const s = S.current; if (!s || s.dead || !s.items.includes(it)) return;
    if (s.gull && !s.gull.off && s.gull.it === it) return shoo(s, it);
    if (s.hand && !s.hand.off && s.hand.it === it) return slapHand(s);
    if (s.t < s.cd) { s.miss = s.t; return; }
    if (s.ice <= 0) { s.miss = s.t; say(s, 'Out of ice · grab the next bag'); kcSnd('empty'); return; }
    const hot = Math.max(...s.items.map(i => i.w)), x0 = kcMult(s.combo);
    if (it.w >= 0.35 && it.w >= hot - 0.04) { s.combo++; const x1 = kcMult(s.combo); s.bestX = Math.max(s.bestX, x1); if (x1 > x0) { say(s, 'Combo ×' + x1 + ' · hottest first'); kcSnd('combo'); } } else s.combo = 0;
    s.ice--; s.cd = s.t + KC_CD; iceIt(s, it);
  };
  const live = () => { const s = S.current; return s && playing && !paused && !s.dead ? s : null; };
  const loc = e => { const r = box.current.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
  const swipeAt = (s, x, y) => {
    s.trail.push({ x, y, t: s.t, id: s.id++ }); const r = G.current.icon * 0.75;
    for (const it of [...s.items]) { if (s.swipe.hit.has(it.id)) continue; const [ix, iy] = at(it); if (Math.hypot(ix - x, iy - y) < r) { s.swipe.hit.add(it.id); iceIt(s, it); if (s.gull && !s.gull.off && s.gull.it === it) shoo(s, it); if (s.hand && !s.hand.off && s.hand.it === it) slapHand(s); } }
  };
  const onDown = (e, it) => {
    const s = live(); if (!s) return; e.preventDefault(); const [x, y] = loc(e);
    try { box.current.setPointerCapture(e.pointerId); } catch (er) {}
    if (s.armed && s.blocks > 0) { s.armed = false; s.blocks--; s.swipe = { t0: s.t, hit: new Set() }; kcSnd('freeze'); swipeAt(s, x, y); return; }
    if (it) s.drag = { it, x0: x, y0: y, x, y, moved: false };
  };
  const onMove = e => { const s = live(); if (!s) return; const [x, y] = loc(e); if (s.swipe) swipeAt(s, x, y); if (s.drag) { s.drag.x = x; s.drag.y = y; if (!s.drag.moved && Math.hypot(x - s.drag.x0, y - s.drag.y0) > 12) s.drag.moved = true; } };
  const slotAt = (x, y) => { const g = G.current, c = Math.floor((x - g.inX) / g.cw), r = Math.floor((y - g.inY) / g.ch); return c < 0 || r < 0 || c >= g.cols || r >= KC_MAX / g.cols ? -1 : r * g.cols + c; };
  const onUp = () => {
    const s = S.current; if (!s) return; s.swipe = null; const d = s.drag; s.drag = null; if (!d || s.dead) return;
    if (!d.moved) return tap(d.it);
    const slot = slotAt(d.x, d.y); if (slot < 0 || slot === d.it.slot || !s.items.includes(d.it)) return;
    const o = s.items.find(i => i.slot === slot); if (o) o.slot = d.it.slot; d.it.slot = slot; d.it.jx = d.it.jy = 0;
    if (slot === shade) pop(s, d.it, 'In the shade', true);
  };
  const grabIce = () => { const s = live(); if (!s || !s.drop || s.drop.off) return; s.drop.off = s.t; const g = G.current, xy = [g.inX + g.inW * s.drop.fx, g.inY + g.inH * s.drop.fy]; if (s.drop.block) { s.blocks++; pop(s, xy, 'Ice block +1', true); say(s, 'Ice block · tap it top right, then swipe'); } else { s.ice = Math.min(KC_ICEMAX, s.ice + KC_REFILL); pop(s, xy, 'Ice +' + KC_REFILL, true); } kcSnd('coin'); };
  const boom = () => { const s = live(); if (!s || !s.bomb) return; s.bomb = null; s.freezeUntil = s.t + 4; s.items.forEach(i => { i.w *= 0.35; i.iced = s.t; i.ice++; }); say(s, 'Freeze bomb · everything chills'); kcSnd('freeze'); };
  const start = () => {
    kcSnd('bell');
    const s = { t: 0, items: [], id: 0, hearts: KC_HEARTS, ice: KC_ICE0, blocks: 1, armed: false, cd: -1, combo: 0, bestX: 1, q: 0, pts: 0, timePts: 0, saves: 0, shoos: 0, slaps: 0, pops: [], trail: [], toast: null, toastT: -9, miss: -9, flash: -9, freezeUntil: -1, crit: 0, sz: 0, nx: { item: 6, drop: 10, gull: 20, sun: 28, hand: 34, bomb: 40 } };
    S.current = s; KC_START.forEach(k => put(s, k, 0.05 + Math.random() * 0.2)); setRes(null); setPaused(false); setPhase('play');
    setTimeout(() => { const el = box.current; if (!el) return; const top = (el.previousElementSibling || el).getBoundingClientRect().top + scrollY - 12; window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' }); }, 30);
  };
  const kcPause = () => { const s = S.current; if (s) s.drag = s.swipe = null; kcSizzle(0); setPaused(true); };
  useBlurPause(playing && !paused, kcPause);
  useOffscreenPause(box, playing && !paused, kcPause);
  React.useEffect(() => () => kcSizzle(0), []);
  React.useEffect(() => { if (phase !== 'dead') return; const id = setTimeout(() => setPhase('over'), 1500); return () => clearTimeout(id); }, [phase]);
  useRunLoop(playing && !paused, h => {
    const s = S.current; if (!s || s.dead) return false;
    const g = G.current; s.t += h; const t = s.t, heat = kcHeat(t), add = KC_RATE * heat * kcMult(s.combo) * h; s.pts += add; s.timePts += add;
    const frozen = t < s.freezeUntil;
    let sun = null;
    if (s.sun) { const p = (t - s.sun.t0) / s.sun.dur; if (p >= 1) s.sun = null; else { const R = Math.min(g.cw, g.ch) * 0.62, span = g.inW + 2 * R, x = s.sun.dir > 0 ? g.inX - R + span * p : g.inX + g.inW + R - span * p; sun = { x, y: g.inY + g.inH * (0.5 + 0.3 * Math.sin(p * Math.PI * 2 + s.sun.ph)), R }; } }
    s.sunXY = sun;
    let crit = 0; const turned = [];
    for (const it of s.items) {
      let k = heat / KC_ITEMS[it.k].secs; it.sun = false;
      const lifted = s.drag && s.drag.it === it && s.drag.moved;
      if (it.slot === shade && !lifted) k *= KC_SHADE_X;
      else if (sun) { const [x, y] = at(it); if (Math.hypot(x - sun.x, y - sun.y) < sun.R * 0.9) { k *= KC_SUN_X; it.sun = true; } }
      if (frozen) k = 0;
      it.w = Math.min(1, it.w + h * k); crit = Math.max(crit, it.w); if (it.w >= 1) turned.push(it);
    }
    s.crit = crit;
    for (const it of turned) { lose(s, it, 'turned'); if (s.dead) return false; }
    if (s.gull) { if (s.gull.off) { if (t - s.gull.off > 0.7) s.gull = null; } else if (!s.items.includes(s.gull.it)) s.gull = null; else if (t - s.gull.t0 >= s.gull.dur) { const it = s.gull.it; s.gull.off = t; s.gull.stole = true; kcSnd('gull'); lose(s, it, 'gull'); if (s.dead) return false; } }
    if (s.hand) { if (s.hand.off) { if (t - s.hand.off > 0.35) s.hand = null; } else if (!s.items.includes(s.hand.it)) s.hand = null; else if (t - s.hand.t0 >= s.hand.dur) { const it = s.hand.it; s.hand.off = t; s.hand.stole = true; lose(s, it, 'kid'); if (s.dead) return false; } }
    if (s.drop && (s.drop.off ? t - s.drop.off > 0.2 : t - s.drop.t0 >= s.drop.dur)) { if (!s.drop.off) say(s, 'The ice melted into the sand'); s.drop = null; }
    if (s.bomb && t - s.bomb.t0 >= 5) s.bomb = null;
    if (s.swipe && t - s.swipe.t0 > 1.3) s.swipe = null;
    s.trail = s.trail.filter(p => t - p.t < 0.35); s.pops = s.pops.filter(p => t - p.t < 0.9);
    // Schedule. Chaos (gull, hand, sun): one at a time for the first minute, two after that.
    const busy = [s.gull && !s.gull.off, s.hand && !s.hand.off, !!s.sun].filter(Boolean).length, room = busy < (t < 90 ? 1 : 2);
    // Pickups (ice drop, freeze bomb) never land on top of each other.
    const spot = o => { let p; for (let i = 0; i < 12; i++) { p = { fx: 0.15 + 0.7 * Math.random(), fy: 0.15 + 0.7 * Math.random() }; if (!o || Math.hypot(p.fx - o.fx, p.fy - o.fy) > 0.35) break; } return p; };
    const free = list => { const c = list.filter(i => !(s.gull && s.gull.it === i) && !(s.hand && s.hand.it === i) && !(s.drag && s.drag.it === i)); return c.length ? ngPick(c) : null; };
    if (t >= s.nx.item) { if (s.items.length < KC_MAX - 1) { const k = s.q < KC_NEXT.length ? KC_NEXT[s.q] : ngPick(Object.keys(KC_ITEMS)); s.q++; const more = s.items.some(i => i.k === k); if (put(s, k, 0.1)) say(s, 'Incoming: ' + (more ? 'more ' : '') + KC_ITEMS[k].in); s.nx.item = t + Math.max(5, 10 - t / 30); } else s.nx.item = t + 2; }
    if (t >= s.nx.drop && !s.drop) { s.drop = { t0: t, dur: 5, block: Math.random() < 0.25, ...spot(s.bomb) }; s.nx.drop = t + 10 + Math.random() * 4; kcSnd('bell'); }
    if (t >= s.nx.bomb && !s.bomb) { s.bomb = { t0: t, ...spot(s.drop && !s.drop.off ? s.drop : null) }; s.nx.bomb = t + 32 + Math.random() * 13; }
    if (t >= s.nx.gull) { if (room && !s.gull) { const it = free(s.items); if (it) { s.gull = { it, t0: t, dur: Math.max(2.4, 3.6 - t / 120) }; kcSnd('gull'); } s.nx.gull = t + Math.max(12, 22 - t / 15) + Math.random() * 6; } else s.nx.gull = t + 2; }
    if (t >= s.nx.hand) { const it = room && !s.hand ? free(s.items.filter(i => KC_TREATS.includes(i.k))) : null; if (it) { const [x] = at(it); s.hand = { it, t0: t, dur: Math.max(2.3, 3.2 - t / 150), side: x < g.inX + g.inW / 2 ? -1 : 1 }; s.nx.hand = t + 20 + Math.random() * 8; } else s.nx.hand = t + 2; }
    if (t >= s.nx.sun) { if (room && !s.sun) { s.sun = { t0: t, dur: 7, dir: Math.random() < 0.5 ? 1 : -1, ph: Math.random() * 6.28 }; say(s, 'Sun through the umbrella'); s.nx.sun = t + 26 + Math.random() * 10; } else s.nx.sun = t + 2; }
    if (t - s.sz > 0.1) { s.sz = t; kcSizzle(crit > 0.7 ? (crit - 0.7) / 0.3 * 0.05 : 0); }
    tick(x => x + 1);
  });

  if (phase === 'over' && res) { const cut = res.line.indexOf('. ') + 1; return (
    <div className="gm-center">
      <span className="lbl blue">Run over · three hearts, gone</span>
      <div className="hl" style={{ fontSize: 'clamp(40px, 5.6vw, 88px)', maxWidth: 1100 }}>{res.line.slice(0, cut)} <Sel>{res.line.slice(cut + 1)}</Sel></div>
      <div className="kc-stats">
        <div className="kc-stat"><span className="lbl muted">Survived</span><b>{kcClock(res.t)}</b></div>
        <div className="kc-stat"><span className="lbl muted">Marks</span><b>{ptsFmt(res.score)}</b></div>
        <div className={'kc-stat' + (res.newBest ? ' on' : '')}><span className="lbl muted">{res.newBest ? 'Best run · new' : 'Best run'}</span><b>{kcClock(res.best)}</b></div>
      </div>
      <span className="lbl muted">{res.saves + ' close ones · ' + res.shoos + ' gulls shooed · ' + res.slaps + ' hands slapped · ' + 'best combo ×' + res.bestX}</span>
      <ScoreBanner id="game-14" pts={res.score} line={ptsFmt(res.timePts) + ' for time survived + ' + ptsFmt(res.bonusPts) + ' in bonuses. No cap. The sun does not get tired, so neither should you.'} again={['[ Ice it again ]', start]} />
    </div>
  ); }
  const s = S.current, t = s ? s.t : 0, heat = kcHeat(t), mult = s ? kcMult(s.combo) : 1;
  const ready = s ? Math.max(0, Math.min(1, 1 - (s.cd - t) / KC_CD)) : 1;
  const frozen = s && t < s.freezeUntil, crit = s ? s.crit : 0;
  const dragSlot = s && s.drag && s.drag.moved ? slotAt(s.drag.x, s.drag.y) : -1;
  const cellBox = slot => { const [x, y] = cellXY(slot); return { left: x - cw / 2 + 4, top: y - ch / 2 + 4, width: cw - 8, height: ch - 8 }; };
  const hand = s && s.hand && (() => { const [px, py] = at(s.hand.it), ex = s.hand.side < 0 ? 0 : W, L = Math.hypot(px - ex, py - py), p = s.hand.off ? Math.max(0, 1 - (t - s.hand.off) / 0.3) * Math.min(1, (s.hand.off - s.hand.t0) / s.hand.dur) : Math.min(1, (t - s.hand.t0) / s.hand.dur); return { left: ex, top: py - 12, width: Math.max(0, L - icon * 0.25) * p, transform: 'rotate(' + (s.hand.side < 0 ? 0 : 180) + 'deg)' }; })();
  return (
    <div className="gm-wrap" style={{ flex: 1 }}>
      <div className="ng-hud lbl">
        <span className="gm-hearts" aria-label={(s ? s.hearts : KC_HEARTS) + ' of ' + KC_HEARTS + ' hearts'}>{[...Array(KC_HEARTS).keys()].map(i => <span key={i} className={i < (s ? s.hearts : KC_HEARTS) ? 'on' : ''}>♥</span>)}</span>
        <span>{'Time ' + kcClock(t)}</span><span className="blue">{'Heat ' + heat.toFixed(2) + '×'}</span>
        <span className={'gm-x' + (mult > 1 ? ' on' : '')}>{'×' + mult}</span><span className="gm-score">{gmScore(s ? s.pts : 0)}</span><span className="muted">{'Best run ' + kcClock(best)}</span>
      </div>
      <div ref={box} className={'ng-area kc' + (s && s.armed ? ' armed' : '')} onPointerDown={e => onDown(e, null)} onPointerMove={onMove} onPointerUp={onUp} onPointerCancel={onUp}>
        <div className="kc-box"></div>
        <div className={'kc-field' + (crit >= 0.85 ? ' haze' : '')}>
          <div className="kc-in" style={{ left: inX - 6, top: inY - 6, width: inW + 12, height: inH + 12 }}></div>
          <div className="kc-shade" style={cellBox(shade)}><span>Shade</span></div>
          {dragSlot >= 0 && <div className="kc-slot-t" style={cellBox(dragSlot)}></div>}
          {s && s.sunXY && <span className="kc-sun" style={{ left: s.sunXY.x, top: s.sunXY.y, width: s.sunXY.R * 2, height: s.sunXY.R * 2 }}></span>}
          {s && s.items.map(it => { const [x, y] = at(it), lifted = s.drag && s.drag.it === it && s.drag.moved; return (
            <button key={it.id} type="button" className={'kc-it' + (it.w >= KC_RED ? ' hot' : '') + (it.sun ? ' sun' : '') + (lifted ? ' drag' : '')} aria-label={KC_ITEMS[it.k].label + ', ' + Math.round(it.w * 100) + '% warm'} style={{ left: x, top: y, width: cw * 0.9, height: ch * 0.9 }} onPointerDown={e => { e.stopPropagation(); onDown(e, it); }}>
              <span className="kc-pic" style={{ width: icon, height: icon, transform: 'rotate(' + it.rot.toFixed(1) + 'deg)' + (lifted ? ' scale(1.12)' : '') }}><KcIcon k={it.k} /></span>
              <span className="kc-m" style={{ width: icon * 0.9 }}><i style={{ width: it.w * 100 + '%', background: kcCol(it.w) }}></i></span>
              {t - it.iced < 0.4 && <span key={'ice' + it.ice} className="kc-ice" style={{ width: icon * 1.5, height: icon * 1.5 }}></span>}
            </button>
          ); })}
        </div>
        {frozen && <div className="kc-frost" style={{ left: inX - 6, top: inY - 6, width: inW + 12, height: inH + 12 }}></div>}
        {crit >= 0.85 && <div className="kc-vig"></div>}
        {s && s.gull && s.items.concat(s.gull.stole ? [s.gull.it] : []).includes(s.gull.it) && (() => { const [x, y] = at(s.gull.it), p = Math.min(1, (t - s.gull.t0) / s.gull.dur); return <span className={'kc-gull' + (s.gull.off ? ' off' : '')} style={{ left: x, top: y - icon * 0.05, width: icon * 0.95 }}><KcGull />{!s.gull.off && <span className="kc-tbar"><i style={{ width: p * 100 + '%' }}></i></span>}</span>; })()}
        {hand && <span className="kc-arm" style={hand} onPointerDown={e => { e.stopPropagation(); e.preventDefault(); const z = live(); if (z && z.hand && !z.hand.off) slapHand(z); }}><img src={LSD_RES('assets/cooler/hand.png')} alt="A small hand, reaching" draggable="false" style={{ height: icon * 0.95, right: -icon * 0.5 }} /></span>}
        {s && s.bomb && <button type="button" className="kc-bomb" style={{ left: inX + inW * s.bomb.fx, top: inY + inH * s.bomb.fy }} onPointerDown={e => { e.stopPropagation(); e.preventDefault(); boom(); }}>Freeze</button>}
        {s && s.drop && !s.drop.off && <button type="button" className={'kc-drop' + (s.drop.block ? ' blk' : '')} aria-label={s.drop.block ? 'Ice block, tap to grab' : 'Bag of ice, tap to grab'} style={{ left: inX + inW * s.drop.fx, top: inY + inH * s.drop.fy, width: icon * 1.15, height: icon * 1.15 }} onPointerDown={e => { e.stopPropagation(); e.preventDefault(); grabIce(); }}><KcBag block={s.drop.block} /><span>{s.drop.block ? 'Block' : '+' + KC_REFILL}</span><svg className="kc-ring" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" pathLength="100" style={{ strokeDasharray: Math.max(0, 1 - (t - s.drop.t0) / s.drop.dur) * 100 + ' 100' }} /></svg></button>}
        <div className="kc-tray">
          {s && s.blocks > 0 && <button type="button" className={'kc-blk' + (s.armed ? ' on' : '')} disabled={!playing || paused} onPointerDown={e => { e.stopPropagation(); e.preventDefault(); const z = live(); if (z && z.blocks > 0) z.armed = !z.armed; }}><KcBag block />{(s.armed ? 'Swipe' : 'Block') + ' ×' + s.blocks}</button>}
          <span className={'kc-gauge' + (s && t - s.miss < 0.3 ? ' no' : '') + (s && s.ice <= 3 ? ' low' : '')} aria-label={(s ? s.ice : KC_ICE0) + ' ice left'}><KcBag /><b>{s ? s.ice : KC_ICE0}</b><i><i style={{ width: ready * 100 + '%' }}></i></i></span>
        </div>
        {s && s.trail.map(p => <span key={p.id} className="kc-trail" style={{ left: p.x, top: p.y, width: icon * 1.2, height: icon * 1.2, opacity: 1 - (t - p.t) / 0.35 }}></span>)}
        {s && s.pops.map(p => { const a = (t - p.t) / 0.9; return <span key={p.id} className={'kc-pop' + (p.good ? ' good' : '')} style={{ left: p.x, top: p.y - icon * 0.6 - a * 40, opacity: 1 - a * a }}>{p.txt}</span>; })}
        {s && s.toast && t - s.toastT < 1.8 && <span key={s.toastT} className="ng-toast kc-toast">{s.toast.toUpperCase()}</span>}
        {s && t - s.flash < 0.35 && <div className="kc-flash" style={{ opacity: 1 - (t - s.flash) / 0.35 }}></div>}
        {phase === 'ready' && <div className="ng-pause"><span className="lbl blue">Arcade · no cap · no winning, only lasting</span><div className="hl" style={{ fontSize: 'clamp(36px, 4vw, 56px)' }}>Keep it <Sel>cold.</Sel></div><p className="lead" style={{ margin: 0, textAlign: 'center' }}>Everything in the box is getting warm. Tap it to ice it. Prawns first. Always prawns first. Last as long as you can — the sun does not get tired. Marks for time survived and brave rescues.</p>
          <ul className="ng-rules"><li><span className="lbl blue">Hearts</span><span>Three. Anything that turns, or gets stolen, costs one.</span></li><li><span className="lbl blue">Ice</span><span>It runs out (top right). Bags land in the box now and then. Tap one before it melts.</span></li><li><span className="lbl blue">Shade</span><span>Drag hot things into the shade corner.</span></li><li><span className="lbl blue">Thieves</span><span>Seagull or small hand? Tap it before it takes something.</span></li><li><span className="lbl blue">Combo</span><span>Ice the hottest thing first to build a combo.</span></li><li><span className="lbl blue">Specials</span><span>Ice block: tap it, then swipe across the box. Freeze bomb: tap it, fast.</span></li></ul>
          <button type="button" className="btn primary" onClick={start}>[ Grab the ice ]</button><ChallengeBtn id="game-14" /></div>}
        {playing && paused && <NgPaused onResume={() => setPaused(false)} />}
      </div>
      <div className="kc-tools">
        <button type="button" className="btn line sm" onClick={() => { setSound(x => !x); if (sound) kcSizzle(0); }}>{sound ? 'Sound on' : 'Sound off'}</button>
        <span className="lbl muted">{s && s.armed ? 'Ice block armed. Swipe across the box.' : 'Drag anything into the shade. It warms at less than half the speed.'}</span>
      </div>
    </div>
  );
}

Object.assign(window, { KeepItColdGame, KcIcon, kcCol, kcClock, KC_RED });
