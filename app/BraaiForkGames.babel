// The braai clock + Fork patrol.
// Braai clock: it's a joke. There is no time. The braai says "later" or "earlier" but always dodges your guess (it squeezes the window
// shut, then contradicts itself). After six guesses it admits it: there never is a time for the braai.
const BRAAI_EARLY = ['No. The meat isn’t even on, bru.', 'The fire said maybe later.', 'Someone’s gone for more ice.', 'The salads are ready. The salads don’t count.', 'Uncle is still “getting the coals right.”', 'The wors is thinking about it.'];
const BRAAI_LATE = ['Too late. The dog ate the wors.', 'Too late. Everyone’s asleep on the couch.', 'Too late. Uncle served it while you were scheming.'];
const BRAAI_NONE = ['Later. Uncle just put on more chops.', 'Earlier. No wait. Later.', 'Later. Someone arrived with a second cooler box.', 'Later. The fire went out. The fire is being discussed.'];
const BRAAI_MAX = 6, BRAAI_LO = 17 * 60, BRAAI_HI = 23 * 60 + 45, BRAAI_PTS = 400;
const fmtT = m => pad2(Math.floor(m / 60) % 24) + ':' + pad2(m % 60);

function shareOrCopy(text, copy, setNote) {
  if (navigator.share) { navigator.share({ text }).catch(() => {}); return; }
  copy(text); setNote('Copied. Paste it somewhere inland.');
}

function BraaiClockGame() {
  const [t, setT] = React.useState(18 * 60);
  const [win, setWin] = React.useState([19 * 60, 23 * 60]); // what the braai "admits" is still possible
  const [guesses, setGuesses] = React.useState([]); // { t, dir, line }
  const [note, setNote] = React.useState(null);
  const [, copy] = useCopy();
  const over = guesses.length >= BRAAI_MAX;
  const clock = useGameClock();
  const nudge = dm => { clock.start(); setT(x => Math.min(BRAAI_HI, Math.max(BRAAI_LO, x + dm))); };
  const lock = () => {
    if (over || guesses.some(g => g.t === t)) return; clock.start();
    const [lo, hi] = win, n = guesses.length; let dir, line;
    if (lo > hi) { line = BRAAI_NONE[n % BRAAI_NONE.length]; dir = line.startsWith('Earlier') ? 'earlier' : 'later'; }
    else { dir = t < lo ? 'later' : t > hi ? 'earlier' : (t - lo) <= (hi - t) ? 'later' : 'earlier'; line = dir === 'later' ? BRAAI_EARLY[n % BRAAI_EARLY.length] : BRAAI_LATE[n % BRAAI_LATE.length]; setWin(dir === 'later' ? [Math.max(lo, t + 15), hi] : [lo, Math.min(hi, t - 15)]); }
    if (n + 1 >= BRAAI_MAX) clock.stop();
    setGuesses(g => [...g, { t, dir, line }]);
  };
  const again = () => { setGuesses([]); setWin([19 * 60, 23 * 60]); setT(18 * 60); setNote(null); clock.reset(); };
  const pts = Math.round(BRAAI_PTS * speedMult(clock.secs, 15, 90));
  if (over) return (
    <div className="gm-center">
      <span className="lbl blue">The braai decided: ??:??</span>
      <div className="hl" style={{ fontSize: 'clamp(56px, 8vw, 120px)' }}>There is no <Sel>time.</Sel></div>
      <p className="lead" style={{ margin: 0, textAlign: 'center' }}>There never is a time for the braai. The braai is ready when the braai is ready. Asking was the kook move. Lesson 20.</p>
      <ScoreBanner id="game-07" pts={pts} line={'Six guesses, zero chops: ' + ptsFmt(BRAAI_PTS) + ' for showing up hungry.' + speedLine(clock.secs, 15, 90)} />
      <div className="row" style={{ justifyContent: 'center' }}>
        <button type="button" className="btn primary" onClick={again}>[ Ask again. It won’t help. ]</button>
        <button type="button" className="btn line" onClick={() => shareOrCopy('I asked the braai what time we eat. Six times. There is no time. — The Braai Clock, Learn to Speak Durban', copy, setNote)}>[ Share ]</button>
      </div>
      {note && <div key={note} className="lbl blue lt-note">{note}</div>}
    </div>
  );
  if (!clock.started) return <GameGate id="game-07" kicker="The braai clock · timed" title={<>When do we <Sel>eat?</Sel></>} line="The braai has picked a time between 19:00 and 23:00. Six guesses. The clock is running. The fire is not." cta="[ Light the fire ]" onStart={clock.start} />;
  const lg = guesses[guesses.length - 1];
  return (
    <div className="gm-center">
      <span className="lbl muted">{'Your estimate · guess ' + (guesses.length + 1) + ' of ' + BRAAI_MAX + ' · ' + clockFmt(clock.secs)}</span>
      <div className="hl" style={{ fontSize: 'clamp(88px, 14vw, 200px)', fontVariantNumeric: 'tabular-nums', lineHeight: 1 }}>{fmtT(t).slice(0, 3)}<Sel>{fmtT(t).slice(3)}</Sel></div>
      <div className="row" style={{ justifyContent: 'center', gap: 6 }}>
        {[['−1 hr', -60], ['−15 min', -15], ['+15 min', 15], ['+1 hr', 60]].map(([l, dm]) => <button key={l} type="button" className="chip" onClick={() => nudge(dm)}>{l}</button>)}
      </div>
      <button type="button" className="btn primary" onClick={lock} disabled={guesses.some(g => g.t === t)}>{guesses.some(g => g.t === t) ? 'Already guessed that' : '[ Lock it in ]'}</button>
      <div style={{ minHeight: 64, display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10 }}>
        {lg && <><div className="hl" style={{ fontSize: 'clamp(24px, 2.6vw, 36px)' }}>{lg.line}</div><span className="pill lbl">{lg.dir === 'later' ? 'Later, bru' : 'Earlier, bru'}</span></>}
        {guesses.length > 0 && <div className="row" style={{ justifyContent: 'center', gap: 10 }}>{guesses.map((g, i) => <span key={i} className="lbl muted" style={{ textDecoration: 'line-through' }}>{fmtT(g.t) + (g.dir === 'later' ? ' ↑' : ' ↓')}</span>)}</div>}
        {!guesses.length && <span className="lbl muted">The braai picks a time between 19:00 and 23:00. It will tell you later or earlier. It’s usually later.</span>}
      </div>
    </div>
  );
}

function ForkPatrolGame() {
  const box = React.useRef(null), S = React.useRef(null), raf = React.useRef(0);
  const [phase, setPhase] = React.useState('ready');
  const [, tick] = React.useState(0);
  const [score, setScore] = React.useState(0);
  const [, setTotal] = useStored('lsd2-forks', 0);
  const [, setMine] = useStored('lsd2-myforks', 0);
  const [note, setNote] = React.useState(null);
  const [, copy] = useCopy();
  const start = () => {
    S.current = { forks: [], stamps: [], t0: performance.now(), last: performance.now(), next: 0, id: 0 };
    setScore(0); setNote(null); setPhase('play');
  };
  React.useEffect(() => {
    if (phase !== 'play') return;
    const loop = now => {
      const s = S.current, el = box.current; if (!el) return;
      const W = el.clientWidth, H = el.clientHeight, dt = Math.min(0.05, (now - s.last) / 1000), age = (now - s.t0) / 1000; s.last = now;
      if (now >= s.next) {
        const n = 1 + Math.floor(age / 15), R = Math.hypot(W, H) / 2 + 30;
        for (let k = 0; k < n; k++) { const a = Math.random() * Math.PI * 2; s.forks.push({ id: s.id++, x: Math.cos(a) * R, y: Math.sin(a) * R, v: 55 + age * 5 + Math.random() * 20 }); }
        s.next = now + Math.max(420, 1700 - age * 55);
      }
      let hit = false;
      s.forks.forEach(f => { const d = Math.hypot(f.x, f.y); if (d < 80) hit = true; f.x -= f.x / d * f.v * dt; f.y -= f.y / d * f.v * dt; });
      s.stamps = s.stamps.filter(st => now - st.t < 800);
      if (hit) { s.end = now; setPhase('over'); return; }
      tick(x => x + 1); raf.current = requestAnimationFrame(loop);
    };
    raf.current = requestAnimationFrame(loop);
    return () => cancelAnimationFrame(raf.current);
  }, [phase]);
  const grab = (e, f) => {
    e.preventDefault(); const s = S.current; if (phase !== 'play') return;
    s.forks = s.forks.filter(x => x.id !== f.id); s.stamps.push({ id: f.id, x: f.x, y: f.y, t: performance.now() });
    setScore(n => n + 1); setTotal(n => (+n || 0) + 1); setMine(n => (+n || 0) + 1);
  };
  const s = S.current;
  if (phase === 'over') return (
    <div className="gm-center">
      <span className="lbl blue">{'Forks confiscated: ' + score}</span>
      <div className="hl" style={{ fontSize: 'clamp(44px, 6vw, 88px)' }}>The fork got to the <Sel>bunny.</Sel></div>
      <p className="lead" style={{ margin: 0, textAlign: 'center' }}>You know what you’ve done. Final count: {score} confiscated.</p>
      <ScoreBanner id="game-08" pts={Math.min(1000, score * 20)} line={score + ' forks × 20 in ' + clockFmt(s && s.end ? (s.end - s.t0) / 1000 : 0) + '.' + (score >= 50 ? ' Maxed out. The bunny salutes you.' : '')} />
      <div className="lbl muted">Lesson 13: a bunny is eaten with your hands. There is no cutlery chapter.</div>
      <div className="row" style={{ justifyContent: 'center' }}>
        <button type="button" className="btn primary" onClick={start}>[ Patrol again ]</button>
        <button type="button" className="btn line" onClick={() => shareOrCopy('Forks confiscated: ' + score + '. The bunny is safe. — Fork Patrol, Learn to Speak Durban', copy, setNote)}>[ Share your count ]</button>
      </div>
      {note && <div key={note} className="lbl blue lt-note">{note}</div>}
    </div>
  );
  return (
    <div className="gm-wrap" style={{ flex: 1 }}>
      <div className="between lbl"><span className="blue">{'Forks confiscated: ' + score}</span><span className="muted">{phase === 'play' && s ? 'Patrol · ' + clockFmt((performance.now() - s.t0) / 1000) : 'Patrol on standby'}</span></div>
      <div ref={box} style={{ position: 'relative', flex: 1, minHeight: 420, borderRadius: 18, background: 'var(--paper)', overflow: 'hidden', touchAction: 'none', userSelect: 'none' }}>
        <div style={{ position: 'absolute', left: '50%', top: '50%', transform: 'translate(-50%,-50%)', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10 }}>
          <img src={LSD_RES('assets/bunny-chow.png')} alt="Bunny chow" draggable="false" style={{ width: 'clamp(110px, 14vw, 150px)', height: 'auto', display: 'block', pointerEvents: 'none', filter: 'drop-shadow(0 10px 14px rgba(0,0,0,.18))' }} />
          <span className="lbl muted">Lesson 13 · hands only</span>
        </div>
        {phase === 'ready' && <div className="ng-pause" style={{ cursor: 'default' }}><span className="lbl blue">Fork patrol · reflexes</span><div className="hl" style={{ fontSize: 'clamp(36px, 4vw, 56px)' }}>Protect the <Sel>bunny.</Sel></div><HowCards id="game-08" /><button type="button" className="btn primary" onClick={start}>[ Start patrol ]</button><ChallengeBtn id="game-08" /></div>}
        {phase === 'play' && s && s.forks.map(f => (
          <button key={f.id} type="button" onPointerDown={e => grab(e, f)} style={{ position: 'absolute', left: '50%', top: '50%', transform: `translate(calc(-50% + ${f.x}px), calc(-50% + ${f.y}px))`, appearance: 'none', border: 0, cursor: 'pointer', background: 'transparent', padding: 0, width: 56, height: 80, display: 'grid', placeItems: 'center' }} aria-label="Fork"><img src={LSD_RES('assets/pack/fork.png')} alt="" draggable="false" style={{ height: 72, width: 'auto', pointerEvents: 'none', transform: 'rotate(' + (Math.atan2(-f.y, -f.x) * 180 / Math.PI + 90).toFixed(1) + 'deg)', filter: 'drop-shadow(0 3px 4px rgba(0,0,0,.2))' }} /></button>
        ))}
        {phase === 'play' && s && s.stamps.map(st => {
          const k = Math.min(1, (performance.now() - st.t) / 800);
          return <span key={'s' + st.id} className="lbl blue" style={{ position: 'absolute', left: '50%', top: '50%', transform: `translate(calc(-50% + ${st.x}px), calc(-50% + ${st.y}px)) rotate(-8deg) scale(${1.15 - k * 0.15})`, opacity: 1 - k, padding: '6px 10px', border: '2px solid var(--blue)', borderRadius: 6, background: '#fff', pointerEvents: 'none', whiteSpace: 'nowrap' }}>Confiscated</span>;
        })}
      </div>
    </div>
  );
}

Object.assign(window, { BraaiClockGame, ForkPatrolGame });
